
#Область ПрограммныйИнтерфейс

#Область СтандартныеШаблоны

// Создает пустую структуру описания стандартного шаблона печати офисных документов.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка - Наименование шаблона
//     * Назначение - ПеречислениеСсылка.НазначенияШаблоновПечатиОфисныхДокументов - Назначение использования
//     * Макет - Строка - Имя макета шаблона (соответствующего объекта метаданных)
//     * Объект - Строка - Полное имя метаданных объекта, где находится макет
//     * Изображение - Строка - Имя макета с демонстрационным изображениекмшаблона, используется для предпросмотра
//     		(двоичные данные файла в формате PDF).
//     		
Функция НовыйОписаниеСтандартногоШаблона() Экспорт

	ОписаниеШаблона = Новый Структура;
	ОписаниеШаблона.Вставить("Наименование", "");
	ОписаниеШаблона.Вставить("Макет",        "");
	ОписаниеШаблона.Вставить("Объект",       "");
	ОписаниеШаблона.Вставить("Изображение",  "");
	ОписаниеШаблона.Вставить("Назначение",
		ПредопределенноеЗначение("Перечисление.НазначенияШаблоновПечатиОфисныхДокументов.ПустаяСсылка"));

	Возврат ОписаниеШаблона;

КонецФункции

#КонецОбласти

// Возвращает ключ настроек для сохранения последнего выбранного шаблона печати офисных документов.
//
// Возвращаемое значение:
//   Строка
Функция КлючНастроекПоследнегоВыбранногоШаблона() Экспорт
	
	КлючНастроек = "ПоследнийВыбранныйШаблонПечатиОфисныхДокументовУНФ";
	Возврат КлючНастроек;
	
КонецФункции

// Формирует заголовок формы элемента на основе переданного представления и ссылки в том случае, если указан
// параметр.
//
// Параметры:
//   ЗаголовокФормы - Строка - возвращаемый заголовок формы
//   Ссылка - ДокументСсылка, СправочникСсылка - Ссылка на объект
//   ИзменятьЗаголовок - Булево - признак необходимости изменения заголовка формы.
//
Процедура УстановитьЗаголовокФормыЭлемента(ЗаголовокФормы, Ссылка, ИзменятьЗаголовок = Ложь) Экспорт

	Если Не ИзменятьЗаголовок Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеОбъекта = НСтр("ru = 'Шаблон печати'");
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ЗаголовокФормы = СтрШаблон ("%1 (%2)", ПредставлениеОбъекта, НСтр("ru = 'создание'"));
	Иначе
		ЗаголовокФормы = СтрШаблон("%1 (%2)", Строка(Ссылка), ПредставлениеОбъекта);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

