// Путь к макету, содержащему двоичные данные пустого файла pdf.
// 
// Возвращаемое значение:
//  см. НовыйОписаниеСтандартногоШаблона
Функция ОписаниеШаблонаПустогоФайла() Экспорт
	
	ОписаниеШаблона = НовыйОписаниеСтандартногоШаблона();
	ОписаниеШаблона.Наименование = НСтр("ru = 'Пустой файл'");
	ОписаниеШаблона.Макет = "ПустойФайл_docx";
	ОписаниеШаблона.Объект = "Справочник.ШаблоныПечатиОфисныхДокументов";
	ОписаниеШаблона.Изображение = "ПустойФайл_pdf";
	
	Возврат ОписаниеШаблона;
	
КонецФункции

