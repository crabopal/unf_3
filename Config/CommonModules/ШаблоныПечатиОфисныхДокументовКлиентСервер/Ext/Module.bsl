// Описание пустого файла шаблона в формате odt.
// 
// Параметры:
//  Назначение - ПеречислениеСсылка.НазначенияШаблоновПечатиОфисныхДокументов
// 
// Возвращаемое значение:
//  см. НовыйОписаниеСтандартногоШаблона
Функция НовыйОписаниеПустогоФайлаDocx(Назначение) Экспорт

	ОписаниеШаблона = НовыйОписаниеСтандартногоШаблона();
	ОписаниеШаблона.Наименование = "Файл шаблона печати";
	ОписаниеШаблона.Макет        = "ПустойФайл_docx";
	ОписаниеШаблона.Объект       = "Справочник.ШаблоныПечатиОфисныхДокументов";
	ОписаниеШаблона.Назначение   =  Назначение;

	Возврат ОписаниеШаблона;

КонецФункции

// Описание пустого файла шаблона в формате odt.
// 
// Параметры:
//  Назначение - ПеречислениеСсылка.НазначенияШаблоновПечатиОфисныхДокументов
// 
// Возвращаемое значение:
//  см. НовыйОписаниеСтандартногоШаблона
Функция НовыйОписаниеПустогоФайлаOdt(Назначение) Экспорт

	ОписаниеШаблона = НовыйОписаниеСтандартногоШаблона();
	ОписаниеШаблона.Наименование = "Файл шаблона печати";
	ОписаниеШаблона.Макет        = "ПустойФайл_odt";
	ОписаниеШаблона.Объект       = "Справочник.ШаблоныПечатиОфисныхДокументов";
	ОписаниеШаблона.Назначение   =  Назначение;

	Возврат ОписаниеШаблона;

КонецФункции

// Заменяет окончание имени макета на соответствующее новому расширению в случае, когда это не .docx.
//
// Параметры:
//  ИмяМакета	 - Строка - Имя макета
//  Расширение	 - Строка - Новое расширеие
//
Процедура ПривестиИмяМакетаКРасширению(ИмяМакета, Расширение) Экспорт

	Если Расширение <> "docx" Тогда
		ПозицияРасширения = СтрНайти(ИмяМакета, "_docx", НаправлениеПоиска.СКонца);
		ИмяМакета = СтрШаблон("%1%2", Лев(ИмяМакета, ПозицияРасширения), Расширение);
	КонецЕсли;
	
КонецПроцедуры
 
