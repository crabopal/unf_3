Процедура ПРО_Справочник_ПалитраТоваровРМК_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	Если Не Объект.ДополнительныеСвойства.Свойство("РегистрацияПалитры") Тогда
	
		ИспользоватьКэш = Ложь;
	
		РезультатПроверки = ОбщегоназначенияРМК.ПолучитьРезультатПроверкиЗацикленностиПалитры(Объект.Ссылка, Неопределено);
		Если РезультатПроверки.ЕстьЗацикливание Тогда
			ПалитраИРодители = Новый Массив;
		Иначе
			ПалитраИРодители = ИнтерфейсРМКСлужебный.ПолучитьИерархиюРодителейПалитры(Объект.Ссылка);
		КонецЕсли;
	
		ПараметрыЗапроса.Вставить("ПалитраИРодители", ПалитраИРодители);
	
		ТекстЗапроса = "ВЫБРАТЬ
		|	ОбменСУРМК.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.ОбменСУРМК.ПалитрыТоваровДляВыгрузки КАК ОбменСУРМКПалитрыТоваровДляВыгрузки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСУРМК КАК ОбменСУРМК
		|		ПО ОбменСУРМКПалитрыТоваровДляВыгрузки.Ссылка = ОбменСУРМК.Ссылка
		|ГДЕ
		|	ОбменСУРМКПалитрыТоваровДляВыгрузки.ПалитраТоваровРМК В(&СвойствоОбъекта_ПалитраИРодители)
		|	И НЕ ОбменСУРМК.ЭтотУзел
		|	И НЕ ОбменСУРМК.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]";
		
	КонецЕсли;
