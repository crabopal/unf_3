				|";
	
			Запрос = Новый Запрос(Текст);
			Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	
			Выборка = Запрос.Выполнить().Выбрать();
	
			МассивПалитрыВладельцы = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				Родители = ИнтерфейсРМКСлужебный.ПолучитьИерархиюРодителейПалитры(Выборка.Ссылка);
				Если Родители.Количество() > 0 Тогда
					Для Каждого ЭлементМассива Из Родители Цикл
						Если МассивПалитрыВладельцы.Найти(ЭлементМассива) = Неопределено Тогда
							МассивПалитрыВладельцы.Добавить(ЭлементМассива);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
	
			ПараметрыЗапроса.Вставить("МассивПалитрыВладельцы", МассивПалитрыВладельцы);
	
			ТекстЗапроса = "
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
				|ИЗ
				|	ПланОбмена.ОбменСУРМК КАК ПланОбменаОсновнаяТаблица
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСУРМК.ПалитрыТоваровДляВыгрузки КАК ПалитрыУзла
				|		ПО (ПалитрыУзла.Ссылка = ПланОбменаОсновнаяТаблица.Ссылка)
				|ГДЕ
				|	ПалитрыУзла.ПалитраТоваровРМК В(&СвойствоОбъекта_МассивПалитрыВладельцы)
				|	И ПланОбменаОсновнаяТаблица.ВыгружатьТолькоТоварыПалитры
				|	И НЕ ПланОбменаОсновнаяТаблица.ЭтотУзел
				|	И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
				|[УсловиеОтбораПоРеквизитуФлагу]
				|";
		КонецЕсли;
КонецПроцедуры
