	ИначеЕсли ПРО.Идентификатор = "Справочник_Номенклатура4" Тогда 
		ПРО_Справочник_Номенклатура4_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства);
	ИначеЕсли ПРО.Идентификатор = "Документ_УстановкаЦенНоменклатуры" Тогда 
