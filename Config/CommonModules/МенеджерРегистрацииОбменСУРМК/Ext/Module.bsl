Процедура ПРО_РегистрСведений_ОстаткиТоваров_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	МассивСкладов = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница) Тогда
		СкладОстатков = Объект.СтруктурнаяЕдиница;
	
	      МассивСкладов.Добавить(СкладОстатков);
	
		Если ЗначениеЗаполнено(СкладОстатков.Родитель)
			И СкладОстатков.Родитель.ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов Тогда
	
	            МассивСкладов.Добавить(СкладОстатков.Родитель);
		КонецЕсли;
	
		ПараметрыЗапроса.Вставить("СтруктурнаяЕдиница", МассивСкладов);
	
	Иначе	
		Отказ = Истина;
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.ОбменСУРМК КАК ПланОбменаОсновнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСУРМК.Организации КАК ОбменСУРМКОрганизации
		|		ПО (ПланОбменаОсновнаяТаблица.Ссылка = ОбменСУРМКОрганизации.Ссылка)
		|ГДЕ
		|	ПланОбменаОсновнаяТаблица.ВыгружатьОстаткиНоменклатуры
		|	И НЕ ПланОбменаОсновнаяТаблица.ЭтотУзел
		|	И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|     И ПланОбменаОсновнаяТаблица.ТорговыйОбъект В(&СвойствоОбъекта_СтруктурнаяЕдиница)
		|     И ОбменСУРМКОрганизации.Организация = &СвойствоОбъекта_Организация
		|[УсловиеОтбораПоРеквизитуФлагу]";
КонецПроцедуры

