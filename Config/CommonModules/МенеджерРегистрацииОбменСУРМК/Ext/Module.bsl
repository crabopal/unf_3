Процедура ПРО_Справочник_ПалитраТоваровРМК_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	//Регистрация добавленных в палитру вложенных палитр и Номенклатуры добавленной в составы всех палитр.
	Если Не Выгрузка
		И Получатели.Количество() > 0
		И Не Объект.ДополнительныеСвойства.Свойство("РегистрацияПалитры") Тогда
	
		МассивПалитрыДоИзменения = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
		ВложенныеПалитры = ИнтерфейсРМКСлужебный.ПолучитьВложенныеПалитры(МассивПалитрыДоИзменения);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПалитрыДоИзменения, ВложенныеПалитры, Истина);
	
		МассивПалитрыПослеИзменения = Объект.Состав.ВыгрузитьКолонку("Палитра");
		ВложенныеПалитрыПослеИзменения = ИнтерфейсРМКСлужебный.ПолучитьВложенныеПалитры(МассивПалитрыПослеИзменения);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПалитрыПослеИзменения, ВложенныеПалитрыПослеИзменения, Истина);
	
		МассивДобавленныеПалитры = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивПалитрыПослеИзменения, МассивПалитрыДоИзменения);
	
		Для каждого ЭлементМассива Из МассивДобавленныеПалитры Цикл
			Если ЗначениеЗаполнено(ЭлементМассива) Тогда
				ПалитраОбъект = ЭлементМассива.ПолучитьОбъект();
	
				ПалитраОбъект.ДополнительныеСвойства.Вставить("РегистрацияПалитры");
				ВыполнитьПравилаРегистрацииДляОбъекта(ПалитраОбъект, ПРО.ИмяПланаОбмена, Неопределено);
			КонецЕсли;
		КонецЦикла;
	
		ТекстЗапроса = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПалитраТоваровРМКСостав.Номенклатура КАК Номенклатура
			|ИЗ
			|	Справочник.ПалитраТоваровРМК.Состав КАК ПалитраТоваровРМКСостав
			|ГДЕ
			|	ПалитраТоваровРМКСостав.Ссылка В(&МассивДобавленныеПалитры)
			|	И ПалитраТоваровРМКСостав.Номенклатура ССЫЛКА Справочник.Номенклатура
			|";
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивДобавленныеПалитры", МассивДобавленныеПалитры);
	
		Запрос.Текст = ТекстЗапроса;
	
		СсылкаСостав = Запрос.Выполнить().Выгрузить();
	
		МассивТоварыДобавленныеПалитры = СсылкаСостав.ВыгрузитьКолонку("Номенклатура");
	
		ТекстЗапроса = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПалитраТоваровРМКСостав.Номенклатура КАК Номенклатура
			|ИЗ
			|	Справочник.ПалитраТоваровРМК.Состав КАК ПалитраТоваровРМКСостав
			|ГДЕ
			|	ПалитраТоваровРМКСостав.Ссылка В(&МассивПалитрыДоИзменения)
			|	И ПалитраТоваровРМКСостав.Номенклатура ССЫЛКА Справочник.Номенклатура
			|";
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивПалитрыДоИзменения", МассивПалитрыДоИзменения);
	
		Запрос.Текст = ТекстЗапроса;
	
		СсылкаСостав = Запрос.Выполнить().Выгрузить();
	
		МассивТоварыПалитрыДоИзменения = СсылкаСостав.ВыгрузитьКолонку("Номенклатура");
		МассивТоварыПалитрыПослеИзменения = Объект.Состав.ВыгрузитьКолонку("Номенклатура");
	
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивТоварыПалитрыПослеИзменения, МассивТоварыДобавленныеПалитры, Истина);
	
		МассивТоварыПалитры = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивТоварыПалитрыПослеИзменения, МассивТоварыПалитрыДоИзменения);
	
		Для каждого ЭлементМассива Из МассивТоварыПалитры Цикл
			Если ЗначениеЗаполнено(ЭлементМассива) Тогда
				ТоварОбъект = ЭлементМассива.ПолучитьОбъект();
	
				ТоварОбъект.ДополнительныеСвойства.Вставить("РегистрацияПалитры");
				ВыполнитьПравилаРегистрацииДляОбъекта(ТоварОбъект, ПРО.ИмяПланаОбмена, Неопределено);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
