	Контекст.ПодготовитьДанныеКлиент = Истина;
	Контекст.ПодготовитьДанныеСервер = Истина;
	Контекст.ОбработатьДанныеКлиент = Истина;
	Контекст.Клиент = Клиент;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	КодСтатусаРабочегоМеста = 
		ОборудованиеДисплеиПокупателяКлиентСервер.КодСтатусаРабочегоМестаДляДисплея(ПараметрыОперации.СтатусРабочегоМеста);
	ПараметрыОперации.Вставить("КодСтатусаРабочегоМеста", КодСтатусаРабочегоМеста);
	
	КомандыДисплея = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя();
