// Предлагает пользователю выбрать подключенный дисплей покупателя.
//
// Возвращаемое значение:
//  СправочникСсылка.ПодключаемоеОборудование, Неопределено - выбранное устройство.
//  Неопределено возвращается, если устройство не выбрано или недоступно.
//
Асинх Функция ВыбратьДисплейПокупателяАсинх() Экспорт
	
	ПоддерживаемыеТипы = МенеджерОборудованияКлиент.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.ДисплейПокупателя = Истина;
	РезультатВыбора = Ждать МенеджерОборудованияКлиент.ВыбратьУстройствоАсинх(
		ПоддерживаемыеТипы,
		НСтр("ru='Выберите дисплей покупателя'"),
		НСтр("ru='Дисплеи покупателя не подключены.'"), 
		НСтр("ru='Дисплеи покупателя не выбраны.'"));
		
	Если Не РезультатВыбора.Результат Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатВыбора.ИдентификаторУстройства;
	
КонецФункции

// Подготавливает данные операции для отображения информации на дисплее покупателя.
//
// Параметры:
//   ДанныеОперации - Структура - данные операции для отправки на устройство.
//   ПараметрыПодключения - Структура - параметры подключения устройства.
//   Команда - Строка - код выполняемой команды.
//   ПараметрыОперации - Структура - параметры операции с дополнительными данными отображения.
//
// Возвращаемое значение:
//   Булево - Истина, если подготовка завершена.
//
Асинх Функция ПриПодготовкеДанныхОперацииАсинх(ДанныеОперации, ПараметрыПодключения, Команда, ПараметрыОперации) Экспорт
	
	КомандыДисплея = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя();
	Если Команда = КомандыДисплея.ОтобразитьИнформацию Тогда
		
		ОбщегоНазначенияБПОКлиентСервер.ДополнитьСтруктуру(
			ДанныеОперации,
			ОборудованиеДисплеиПокупателяКлиентСервер.НовыеДанныеОперацииОтображенияИнформации(),
			Ложь);
		
		ПодключениеОсновногоУстройства = ПараметрыПодключения.ПодключениеОсновногоУстройства;
		ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
		ЗаполнитьРазмерыЭкранаДляОперацииДисплея(ПараметрыОперации, ДисплейСостоянияОпераций);
		ЗаполнитьРазмерыЭкранаДляОперацииДисплеяПоУмолчанию(ПараметрыОперации);
		Если ПодключениеОсновногоУстройства.ДисплейОтображаетHTML Тогда
			Ждать ПодготовитьРекламуДляТекущегоПодключения(
				ПодключениеОсновногоУстройства,
				ДанныеОперации);
		КонецЕсли;
		
		// передать на сервер уже загруженные картинки
		СостояниеОперации = 
			ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "ЗагруженныеКартинкиДляДисплеяПокупателя");
		ЗагруженныеКартинки = СостояниеОперации.Медиафайлы;
		Для Каждого ЗагруженнаяКартинка Из ЗагруженныеКартинки Цикл
			ДанныеОперации.ЗагруженныеКартинки.Добавить(ЗагруженнаяКартинка.Ключ);
		КонецЦикла;
		
		Если ПодключениеОсновногоУстройства.ДисплейОтображаетHTML Тогда
			Ждать ПодготовитьМедиаданныеРекламы(ПодключениеОсновногоУстройства, ДанныеОперации);
		КонецЕсли;
		Ждать ПодготовитьМедиаданныеКартинки(ПодключениеОсновногоУстройства, ПараметрыОперации, "Картинка");
		Ждать ПодготовитьМедиаданныеКорзины(ПодключениеОсновногоУстройства, ПараметрыОперации);
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

// Завершает обработку результатов операции на клиенте.
//
// Параметры:
//  ДанныеОперации - Структура - данные выполненной операции.
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  Команда - Строка - код выполненной команды.
//  РезультатОперации - Произвольный - результат выполнения команды.
//
// Возвращаемое значение:
//  Неопределено - дополнительная обработка результатов не требуется.
//
Асинх Функция ПриОбработкеРезультатовОперацииАсинх(
	ДанныеОперации, ПараметрыПодключения, Команда, РезультатОперации) Экспорт
	
	КомандыДисплея = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя();
	Если Команда = КомандыДисплея.ОтобразитьИнформацию Тогда
		
		Если Не РезультатОперации.Результат Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// если операция успешна закешируем загруженные в драйвер картинки
		ПодключениеОсновногоУстройства = ПараметрыПодключения.ПодключениеОсновногоУстройства;
		ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
		СостояниеКартинки = 
			ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "ЗагруженныеКартинкиДляДисплеяПокупателя");
		Для Каждого Медиафайл Из ДанныеОперации.МедиаФайлы Цикл
			СостояниеКартинки.Медиафайлы[Медиафайл.ИмяФайла] = Истина;
		КонецЦикла;

		Если ПодключениеОсновногоУстройства.ДисплейОтображаетHTML Тогда
			КешироватьЗагруженныеФайлыРекламы(ДисплейСостоянияОпераций, ДанныеОперации);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет переданное оповещение для каждого результата операции.
//
// Параметры:
//  ОповещениеПриЗавершении - ОписаниеОповещения, Неопределено - оповещение о завершении.
//  Результаты - Массив - результаты выполнения операции.
//
Процедура ВыполнитьОбработкуОповещенийПоРезультатам(ОповещениеПриЗавершении, Результаты)
	
	Если ОповещениеПриЗавершении <> Неопределено Тогда
		Для Каждого Результат Из Результаты Цикл
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Результат);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет команду на одном или нескольких дисплеях покупателя.
//
// Параметры:
//  Контекст - Структура - контекст выполнения операции с оборудованием.
//  Устройство - СправочникСсылка.ПодключаемоеОборудование, Неопределено - устройство выполнения.
//               Если не указано, команда выполняется для всех подключенных дисплеев.
//  Команда - Строка - код команды драйвера.
//  ПараметрыОперации - Структура, Неопределено - параметры выполнения операции.
//
// Возвращаемое значение:
//  Массив из Структура - результаты выполнения команды по каждому устройству.
//
Асинх Функция ВыполнитьКомандуНаДисплеяхПокупателя(Контекст, Устройство, Команда, ПараметрыОперации)
	
	Результаты = Новый Массив;
	Если Не ЗначениеЗаполнено(Устройство) Тогда
		ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
		ПоддерживаемыеТипы.ДисплейПокупателя = Истина;
		ПодключенныеУстройства = МенеджерОборудованияКлиент.ПолучитьПодключенныеУстройства(ПоддерживаемыеТипы);
		Если ПодключенныеУстройства.Количество() > 0 Тогда
			Для Каждого Устройство Из ПодключенныеУстройства Цикл
				Контекст.ОсновноеУстройство = Устройство.ИдентификаторУстройства;
				Результат = Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации);
				Результаты.Добавить(Результат);
			КонецЦикла;
		КонецЕсли;
	Иначе
		Контекст.ОсновноеУстройство = Устройство;
		Результат = Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации);
		Результаты.Добавить(Результат);
	КонецЕсли;
	
	Возврат Результаты;
	
КонецФункции

#Область ПодготовкаКОтображениюИнформации

// Заполняет ширину и высоту экрана в параметрах операции дисплея покупателя.
// Если размеры уже указаны, процедура ничего не делает.
// Иначе получает размеры через ПолучитьИнформациюЭкрановКлиента() и кэширует их
// в состоянии операций по ключам "ШиринаЭкрана" и "ВысотаЭкрана".
//
// Параметры:
//  ПараметрыОперации - Структура - параметры операции дисплея покупателя.
//  ДисплейСостоянияОпераций - Соответствие - кэш состояний текущего подключения.
//
Процедура ЗаполнитьРазмерыЭкранаДляОперацииДисплея(ПараметрыОперации, ДисплейСостоянияОпераций)

	Если ЗначениеЗаполнено(ПараметрыОперации.Ширина) И ЗначениеЗаполнено(ПараметрыОперации.Высота) Тогда
		Возврат;
	КонецЕсли;

	Ширина = ДисплейСостоянияОпераций.Получить("ШиринаЭкрана");
	Высота = ДисплейСостоянияОпераций.Получить("ВысотаЭкрана");

	Если Ширина = Неопределено Или Высота = Неопределено Тогда
		Попытка
			Экраны = ПолучитьИнформациюЭкрановКлиента();
		Исключение
			Возврат;
		КонецПопытки;

		Если Экраны = Неопределено Или Экраны.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		ИндексЭкрана = ?(Экраны.Количество() > 1, 1, 0);
		Экран = Экраны[ИндексЭкрана];
		Ширина = Экран.Ширина;
		Высота = Экран.Высота;

		ДисплейСостоянияОпераций.Вставить("ШиринаЭкрана", Ширина);
		ДисплейСостоянияОпераций.Вставить("ВысотаЭкрана", Высота);
	КонецЕсли;

	ПараметрыОперации.Ширина = Ширина;
	ПараметрыОперации.Высота = Высота;

КонецПроцедуры

Процедура ЗаполнитьРазмерыЭкранаДляОперацииДисплеяПоУмолчанию(ПараметрыОперации)

	Если Не ЗначениеЗаполнено(ПараметрыОперации.Ширина) Тогда 
		ПараметрыОперации.Ширина = 1024;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПараметрыОперации.Высота) Тогда
		ПараметрыОперации.Высота = 768;
	КонецЕсли;

КонецПроцедуры

// Подготавливает состояние рекламы для текущего подключения перед получением данных с сервера.
//
// Параметры:
//  ПодключениеОсновногоУстройства - Структура - параметры подключения основного устройства.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
// Возвращаемое значение:
//  Булево - Истина, если подготовка выполнена.
//
Асинх Функция ПодготовитьРекламуДляТекущегоПодключения(
	ПодключениеОсновногоУстройства,
	ДанныеОперации)

	ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
	СостояниеРекламы = ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "РекламаDisplayInfo");
	ЗаполнитьПолученныеФайлыРекламы(СостояниеРекламы, ДанныеОперации);

	ОбновитьИндексРекламыДляТекущегоПодключения(СостояниеРекламы, ДанныеОперации);

	Возврат Истина;

КонецФункции

// Заполняет данные операции именами рекламных файлов из состояния текущего подключения.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура ЗаполнитьПолученныеФайлыРекламы(СостояниеРекламы, ДанныеОперации)

	Для Каждого КешированныйФайл Из СостояниеРекламы.ПолученныеФайлыРекламы Цикл
		ДанныеОперации.ПолученныеФайлыРекламы.Добавить(КешированныйФайл.Ключ);
	КонецЦикла;

	Для Каждого ЗагруженныйФайл Из СостояниеРекламы.ЗагруженныеФайлыРекламы Цикл
		ДанныеОперации.ЗагруженныеФайлыРекламы.Добавить(ЗагруженныйФайл.Ключ);
	КонецЦикла;

КонецПроцедуры

// Обновляет индекс текущей рекламы в данных операции по состоянию подключения.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура ОбновитьИндексРекламыДляТекущегоПодключения(СостояниеРекламы, ДанныеОперации)

	ДополнитьСостояниеРекламыПолямиРотации(СостояниеРекламы);
	Если СостояниеРекламы.Данные = Неопределено Тогда
		ДанныеОперации.ИндексТекущейРекламы = 0;
		Возврат;
	КонецЕсли;
	Если Не СостояниеРекламы.Данные.Свойство("Реклама") Тогда
		ДанныеОперации.ИндексТекущейРекламы = 0;
		Возврат;
	КонецЕсли;

	Реклама = СостояниеРекламы.Данные.Реклама;
	Если ТипЗнч(Реклама) <> Тип("Массив") Тогда
		ДанныеОперации.ИндексТекущейРекламы = 0;
		Возврат;
	КонецЕсли;
	Если Реклама.Количество() = 0 Тогда
		ДанныеОперации.ИндексТекущейРекламы = 0;
		Возврат;
	КонецЕсли;

	Если Реклама.Количество() = 1 Тогда
		СостояниеРекламы.ИндексТекущейРекламы = 0;
		СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено;
	Иначе
		ОбновитьИндексТекущейРекламы(СостояниеРекламы, Реклама);
	КонецЕсли;
	ДанныеОперации.ИндексТекущейРекламы = СостояниеРекламы.ИндексТекущейРекламы;

КонецПроцедуры

// Обновляет кэш и параметры ротации рекламы по данным операции DisplayInfo.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура ОбновитьСостояниеРекламыИзДанныхОперации(СостояниеРекламы, ДанныеОперации)

	ДополнитьСостояниеРекламыПолямиРотации(СостояниеРекламы);
	Если ДанныеОперации.Реклама.Количество() = 0 Тогда
		ОчиститьСостояниеРекламы(СостояниеРекламы);
		Возврат;
	КонецЕсли;

	Реклама = Новый Массив;
	Для Каждого ЭлементРекламы Из ДанныеОперации.Реклама Цикл
		ДополнитьЭлементРекламыИзКеша(СостояниеРекламы, ЭлементРекламы);
		Если ТипЗнч(ЭлементРекламы) = Тип("Структура") Тогда
			Если ЭлементРекламы.Свойство("Картинка") Тогда
				КешироватьКартинкуРекламы(СостояниеРекламы, ЭлементРекламы.Картинка);
			КонецЕсли;
		КонецЕсли;
		Реклама.Добавить(ЭлементРекламы);
	КонецЦикла;

	Если ДанныеОперации.ИндексТекущейРекламы < 0
		Или ДанныеОперации.ИндексТекущейРекламы >= Реклама.Количество() Тогда
		ДанныеОперации.ИндексТекущейРекламы = 0;
	КонецЕсли;
	СостояниеРекламы.ИндексТекущейРекламы = ДанныеОперации.ИндексТекущейРекламы;

	СостояниеРекламы.Данные = ДанныеСостоянияРекламы(
		ДанныеОперации.РасположениеРекламы,
		ДанныеОперации.ПроцентРекламы,
		Реклама);
	ДанныеОперации.Реклама = Реклама;
	Если Реклама.Количество() = 1 Тогда
		СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено;
	Иначе
		Если СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено Тогда
			ТекущаяДата = ТекущаяДата(); // BSLLS:DeprecatedCurrentDate-off
			УстановитьВремяСледующейСменыРекламы(СостояниеРекламы, Реклама, ТекущаяДата);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Очищает состояние рекламы.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//
Процедура ОчиститьСостояниеРекламы(СостояниеРекламы)

	СостояниеРекламы.Данные = Неопределено;
	СостояниеРекламы.ИндексТекущейРекламы = 0;
	СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено;

КонецПроцедуры

// Добавляет в состояние рекламы поля, необходимые для ротации рекламных файлов.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//
Процедура ДополнитьСостояниеРекламыПолямиРотации(СостояниеРекламы)

	Если Не СостояниеРекламы.Свойство("ИндексТекущейРекламы") Тогда
		СостояниеРекламы.Вставить("ИндексТекущейРекламы", 0);
	КонецЕсли;
	Если Не СостояниеРекламы.Свойство("ВремяСледующейСменыРекламы") Тогда
		СостояниеРекламы.Вставить("ВремяСледующейСменыРекламы");
	КонецЕсли;

КонецПроцедуры

// Обновляет индекс текущего рекламного элемента с учетом времени следующей смены.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  Реклама - Массив Из Структура - элементы рекламы, см.
//            ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы().
//
Процедура ОбновитьИндексТекущейРекламы(СостояниеРекламы, Реклама)

	Если СостояниеРекламы.ИндексТекущейРекламы < 0
		Или СостояниеРекламы.ИндексТекущейРекламы >= Реклама.Количество() Тогда
		СостояниеРекламы.ИндексТекущейРекламы = 0;
		СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено;
	КонецЕсли;

	ТекущаяДата = ТекущаяДата(); // BSLLS:DeprecatedCurrentDate-off
	Если СостояниеРекламы.ВремяСледующейСменыРекламы = Неопределено Тогда
		СостояниеРекламы.ИндексТекущейРекламы = 0;
		УстановитьВремяСледующейСменыРекламы(СостояниеРекламы, Реклама, ТекущаяДата);
		Возврат;
	КонецЕсли;
	Если ТекущаяДата < СостояниеРекламы.ВремяСледующейСменыРекламы Тогда
		Возврат;
	КонецЕсли;

	СостояниеРекламы.ИндексТекущейРекламы = СостояниеРекламы.ИндексТекущейРекламы + 1;
	Если СостояниеРекламы.ИндексТекущейРекламы >= Реклама.Количество() Тогда
		СостояниеРекламы.ИндексТекущейРекламы = 0;
	КонецЕсли;
	УстановитьВремяСледующейСменыРекламы(СостояниеРекламы, Реклама, ТекущаяДата);

КонецПроцедуры

// Устанавливает время следующей смены рекламы по текущему рекламному элементу.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  Реклама - Массив Из Структура - элементы рекламы.
//  ТекущаяДата - Дата - текущая дата, от которой рассчитывается время смены.
//
Процедура УстановитьВремяСледующейСменыРекламы(СостояниеРекламы, Реклама, ТекущаяДата)

	СостояниеРекламы.ВремяСледующейСменыРекламы =
		ТекущаяДата + ВремяОтображенияЭлементаРекламы(Реклама[СостояниеРекламы.ИндексТекущейРекламы]);

КонецПроцедуры

// Возвращает время отображения рекламного элемента.
//
// Параметры:
//  ЭлементРекламы - Структура - элемент рекламы.
//
// Возвращаемое значение:
//  Число - время отображения в секундах.
//
Функция ВремяОтображенияЭлементаРекламы(ЭлементРекламы)

	ВремяОтображенияПоУмолчанию = 20;
	Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
		Возврат ВремяОтображенияПоУмолчанию;
	КонецЕсли;
	Если Не ЭлементРекламы.Свойство("ВремяОтображения") Тогда
		Возврат ВремяОтображенияПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(ЭлементРекламы.ВремяОтображения) <> Тип("Число")
		Или ЭлементРекламы.ВремяОтображения <= 0 Тогда
		Возврат ВремяОтображенияПоУмолчанию;
	КонецЕсли;

	Возврат ЭлементРекламы.ВремяОтображения;

КонецФункции

// Дополняет рекламный элемент картинкой из кэша полученных файлов.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ЭлементРекламы - Структура - элемент рекламы, картинка которого может быть заменена
//                   на кэшированные медиаданные.
//
Процедура ДополнитьЭлементРекламыИзКеша(СостояниеРекламы, ЭлементРекламы)

	Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭлементРекламы.Свойство("Картинка") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ЭлементРекламы.Картинка) = Тип("Строка") Тогда
		КешированнаяКартинка = СостояниеРекламы.ПолученныеФайлыРекламы[ЭлементРекламы.Картинка];
		Если КешированнаяКартинка <> Неопределено Тогда
			ЭлементРекламы.Картинка = КешированнаяКартинка;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ЭлементРекламы.Картинка) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьДанныеКартинкиРекламы(ЭлементРекламы.Картинка) Тогда
		Возврат;
	КонецЕсли;

	Если ЭлементРекламы.Картинка.Свойство("ИмяФайла") Тогда
		КешированнаяКартинка = СостояниеРекламы.ПолученныеФайлыРекламы[ЭлементРекламы.Картинка.ИмяФайла];
		Если КешированнаяКартинка <> Неопределено Тогда
			ЭлементРекламы.Картинка = КешированнаяКартинка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Сохраняет медиаданные рекламной картинки в кэше полученных файлов.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  КартинкаРекламы - Структура - медиаданные рекламной картинки.
//
Процедура КешироватьКартинкуРекламы(СостояниеРекламы, КартинкаРекламы)

	Если ТипЗнч(КартинкаРекламы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не КартинкаРекламы.Свойство("ИмяФайла") Тогда
		Возврат;
	КонецЕсли;
	ИмяФайла = КартинкаРекламы.ИмяФайла;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЕстьДанныеКартинкиРекламы(КартинкаРекламы) Тогда
		Возврат;
	КонецЕсли;

	СостояниеРекламы.ПолученныеФайлыРекламы[ИмяФайла] = КартинкаРекламы;

КонецПроцедуры

// Загружает в драйвер недостающие рекламные медиафайлы для текущей операции.
//
// Параметры:
//  ПодключениеОсновногоУстройства - Структура - параметры подключения основного устройства.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
// Возвращаемое значение:
//  Булево - Истина, если загрузка не требовалась или завершилась успешно.
//
Асинх Функция ПодготовитьМедиаданныеРекламы(ПодключениеОсновногоУстройства, ДанныеОперации)

	ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
	СостояниеРекламы = ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "РекламаDisplayInfo");
	ДанныеДобавленияМедиафайлов = ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыОперацииДобавленияМедиаФайла();
	Медиафайлы = ДанныеДобавленияМедиафайлов.МедиаФайлы;

	Если ДанныеОперации.Реклама.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ОбновитьСостояниеРекламыИзДанныхОперации(СостояниеРекламы, ДанныеОперации);
	ЗаполнитьМедиафайлыРекламыКЗагрузке(СостояниеРекламы, ДанныеОперации, Медиафайлы);

	Результат = Истина;
	Если Медиафайлы.Количество() > 0 Тогда
		Команда = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя().ДобавитьМедиафайл;
		РезультатВыполнения = Ждать ПодключениеОсновногоУстройства.ОбработчикДрайвера.ВыполнениеКоманды(
			ПодключениеОсновногоУстройства, Команда, ДанныеДобавленияМедиафайлов);
		Результат = РезультатВыполнения.Результат;
		Если Результат Тогда
			Для Каждого Медиафайл Из Медиафайлы Цикл
				СостояниеРекламы.ПолученныеФайлыРекламы[Медиафайл.ИмяФайла] = Медиафайл;
				СостояниеРекламы.ЗагруженныеФайлыРекламы[Медиафайл.ИмяФайла] = Истина;
				ДанныеОперации.ЗагруженныеФайлыРекламы.Добавить(Медиафайл.ИмяФайла);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	ЗаменитьКартинкиРекламыНаИменаФайлов(ДанныеОперации);
	УдалитьЗагруженныеМедиафайлыРекламы(СостояниеРекламы, ДанныеОперации);
	ДанныеОперации.КешироватьМедиаФайлы = (ДанныеОперации.МедиаФайлы.Количество() > 0);

	Возврат Результат;

КонецФункции

// Удаляет из пакета медиафайлов рекламы файлы, уже загруженные в драйвер.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура УдалитьЗагруженныеМедиафайлыРекламы(СостояниеРекламы, ДанныеОперации)

	ИменаРекламы = ИменаФайловРекламы(ДанныеОперации.Реклама);
	Индекс = ДанныеОперации.МедиаФайлы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Медиафайл = ДанныеОперации.МедиаФайлы[Индекс];
		Если ИменаРекламы.Получить(Медиафайл.ИмяФайла) = Неопределено Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		Если СостояниеРекламы.ЗагруженныеФайлыРекламы[Медиафайл.ИмяФайла] = Неопределено Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		ДанныеОперации.МедиаФайлы.Удалить(Индекс);
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Заменяет структуры рекламных картинок на имена файлов для передачи в HTML-шаблон.
//
// Параметры:
//  Параметры - Структура - параметры операции или шаблона с массивом Реклама.
//
Процедура ЗаменитьКартинкиРекламыНаИменаФайлов(Параметры)

	Если Не Параметры.Свойство("Реклама") Тогда
		Возврат;
	КонецЕсли;
	Реклама = Параметры.Реклама;
	Если ТипЗнч(Реклама) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементРекламы Из Реклама Цикл
		Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭлементРекламы.Свойство("Картинка") Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = ИмяФайлаКартинкиРекламы(ЭлементРекламы.Картинка);
		Если Не ПустаяСтрока(ИмяФайла) Тогда
			ЭлементРекламы.Картинка = ИмяФайла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает имя файла рекламной картинки.
//
// Параметры:
//  КартинкаРекламы - Строка, Структура - имя файла или структура медиафайла.
//
// Возвращаемое значение:
//  Строка - имя файла или пустая строка.
//
Функция ИмяФайлаКартинкиРекламы(КартинкаРекламы)

	Если ТипЗнч(КартинкаРекламы) = Тип("Строка") Тогда
		Возврат КартинкаРекламы;
	КонецЕсли;
	Если ТипЗнч(КартинкаРекламы) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	ИмяФайла = "";
	Если КартинкаРекламы.Свойство("ИмяФайла") Тогда
		ИмяФайла = КартинкаРекламы.ИмяФайла;
	КонецЕсли;
	Возврат ИмяФайла;

КонецФункции

// Заполняет пакет загрузки рекламными медиафайлами, которых еще нет в драйвере.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//  Медиафайлы - Массив Из Структура - пакет медиафайлов для загрузки в драйвер.
//
Процедура ЗаполнитьМедиафайлыРекламыКЗагрузке(СостояниеРекламы, ДанныеОперации, Медиафайлы)

	Если ДанныеОперации.Реклама.Количество() > 0 Тогда
		Для Каждого ЭлементРекламы Из ДанныеОперации.Реклама Цикл
			Если ТипЗнч(ЭлементРекламы) = Тип("Структура")
				И ЭлементРекламы.Свойство("Картинка") Тогда
				ДобавитьМедиафайлРекламыКЗагрузке(СостояниеРекламы, ЭлементРекламы.Картинка, Медиафайлы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Добавляет рекламный медиафайл в пакет загрузки, если он еще не передан в драйвер.
//
// Параметры:
//  СостояниеРекламы - Структура - состояние рекламы текущего подключения.
//  КартинкаРекламы - Структура - медиаданные рекламной картинки.
//  Медиафайлы - Массив Из Структура - пакет медиафайлов для загрузки в драйвер.
//
Процедура ДобавитьМедиафайлРекламыКЗагрузке(СостояниеРекламы, КартинкаРекламы, Медиафайлы)

	Если ТипЗнч(КартинкаРекламы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не КартинкаРекламы.Свойство("ИмяФайла") Тогда
		Возврат;
	КонецЕсли;
	ИмяФайла = КартинкаРекламы.ИмяФайла;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	Если СостояниеРекламы.ЗагруженныеФайлыРекламы[ИмяФайла] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если МедиафайлРекламыУжеДобавлен(Медиафайлы, ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЕстьДанныеКартинкиРекламы(КартинкаРекламы) Тогда
		Возврат;
	КонецЕсли;

	Медиафайлы.Добавить(КартинкаРекламы);

КонецПроцедуры

// Проверяет, что рекламный медиафайл уже добавлен в пакет загрузки.
//
// Параметры:
//  Медиафайлы - Массив Из Структура - пакет медиафайлов.
//  ИмяФайла - Строка - имя рекламного файла.
//
// Возвращаемое значение:
//  Булево - Истина, если файл уже есть в пакете.
//
Функция МедиафайлРекламыУжеДобавлен(Медиафайлы, ИмяФайла)

	Для Каждого Медиафайл Из Медиафайлы Цикл
		Если Медиафайл.ИмяФайла = ИмяФайла Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, что структура рекламной картинки содержит двоичные данные или Base64.
//
// Параметры:
//  КартинкаРекламы - Структура - медиаданные рекламной картинки.
//
// Возвращаемое значение:
//  Булево - Истина, если данные картинки заполнены.
//
Функция ЕстьДанныеКартинкиРекламы(КартинкаРекламы)

	ЕстьДанные = КартинкаРекламы.Свойство("Данные")
		И ЗначениеЗаполнено(КартинкаРекламы.Данные);
	ЕстьBase64 = КартинкаРекламы.Свойство("Base64")
		И Не ПустаяСтрока(КартинкаРекламы.Base64);

	Возврат ЕстьДанные Или ЕстьBase64;

КонецФункции

// Создает структуру данных рекламного блока для состояния текущего подключения.
//
// Параметры:
//  РасположениеРекламы - Строка - расположение рекламного блока.
//  ПроцентРекламы - Число - доля рекламного блока в процентах.
//  Реклама - Массив Из Структура, Неопределено - элементы рекламы.
//
// Возвращаемое значение:
//  Структура:
//   * РасположениеРекламы - Строка
//   * ПроцентРекламы - Число
//   * Реклама - Массив Из Структура, Неопределено
//
Функция ДанныеСостоянияРекламы(
	РасположениеРекламы,
	ПроцентРекламы,
	Реклама = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("РасположениеРекламы", РасположениеРекламы);
	Результат.Вставить("ПроцентРекламы", ПроцентРекламы);
	Результат.Вставить("Реклама", Реклама);

	Возврат Результат;

КонецФункции

// Кэширует рекламные файлы, загруженные в драйвер при выполнении операции.
//
// Параметры:
//  ДисплейСостоянияОпераций - Соответствие - состояния операций текущего подключения.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура КешироватьЗагруженныеФайлыРекламы(ДисплейСостоянияОпераций, ДанныеОперации)

	Если Не ДанныеОперации.Свойство("Реклама") Тогда
		Возврат;
	КонецЕсли;
	Реклама = ДанныеОперации.Реклама;
	Если ТипЗнч(Реклама) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	СостояниеРекламы = ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "РекламаDisplayInfo");
	ИменаРекламы = ИменаФайловРекламы(Реклама);
	Для Каждого Медиафайл Из ДанныеОперации.МедиаФайлы Цикл
		Если ИменаРекламы.Получить(Медиафайл.ИмяФайла) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СостояниеРекламы.ПолученныеФайлыРекламы[Медиафайл.ИмяФайла] = Медиафайл;
		СостояниеРекламы.ЗагруженныеФайлыРекламы[Медиафайл.ИмяФайла] = Истина;
	КонецЦикла;

	Для Каждого ЭлементРекламы Из Реклама Цикл
		Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭлементРекламы.Свойство("Имя")
			Или ПустаяСтрока(ЭлементРекламы.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если МедиафайлРекламыУжеДобавлен(ДанныеОперации.МедиаФайлы, ЭлементРекламы.Имя) Тогда
			СостояниеРекламы.ЗагруженныеФайлыРекламы[ЭлементРекламы.Имя] = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбновитьСостояниеРекламыИзДанныхОперации(СостояниеРекламы, ДанныеОперации);

КонецПроцедуры

// Возвращает имена файлов рекламных элементов в виде соответствия.
//
// Параметры:
//  Реклама - Массив Из Структура - элементы рекламы.
//
// Возвращаемое значение:
//  Соответствие - имена рекламных файлов. Ключом является имя файла.
//
Функция ИменаФайловРекламы(Реклама)

	Результат = Новый Соответствие;
	Для Каждого ЭлементРекламы Из Реклама Цикл
		Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементРекламы.Свойство("Имя") И Не ПустаяСтрока(ЭлементРекламы.Имя) Тогда
			Результат.Вставить(ЭлементРекламы.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Загружает медиаданные изображения в устройство и заменяет структуру изображения
// в параметрах операции на имя файла.
//
// Параметры:
//  ПодключениеОсновногоУстройства - Структура - параметры подключения основного устройства.
//  ПараметрыОперации - Структура - параметры операции дисплея покупателя.
//  ИмяПоляКартинки - Строка - имя поля с параметрами изображения.
//
// Возвращаемое значение:
//  Булево - Истина, если изображение уже загружено или успешно подготовлено.
//
Асинх Функция ПодготовитьМедиаданныеКартинки(ПодключениеОсновногоУстройства, ПараметрыОперации, ИмяПоляКартинки)
	
	Результат = Истина;
	Картинка = ПараметрыОперации[ИмяПоляКартинки];
	Если ТипЗнч(Картинка) = Тип("Структура") Тогда
		
		ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
		СостояниеКартинки = ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, ИмяПоляКартинки);

		Если СостояниеКартинки.Медиафайлы[Картинка.ИмяФайла] = Неопределено Тогда
			ДанныеОперации = ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыОперацииДобавленияМедиаФайла();
			ДанныеОперации.МедиаФайлы.Добавить(Картинка);
			СостояниеКартинки.Медиафайлы[Картинка.ИмяФайла] = Истина;
			Команда = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя().ДобавитьМедиафайл;
			РезультатВыполнения = Ждать ПодключениеОсновногоУстройства.ОбработчикДрайвера.ВыполнениеКоманды(
				ПодключениеОсновногоУстройства, Команда, ДанныеОперации);
			Результат = РезультатВыполнения.Результат;
		КонецЕсли;
		// не нужно данные передавать на сервер, заменить на имя файла
		ПараметрыОперации[ИмяПоляКартинки] = Картинка.ИмяФайла;
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Загружает изображения товаров для операции "Корзина" и заменяет данные фото
// в строках корзины на имена файлов.
//
// Параметры:
//  ПодключениеОсновногоУстройства - Структура - параметры подключения основного устройства.
//  ПараметрыОперации - Структура - параметры операции дисплея покупателя.
//
// Возвращаемое значение:
//  Булево - Истина, если изображения корзины уже загружены или успешно подготовлены.
//
Асинх Функция ПодготовитьМедиаданныеКорзины(ПодключениеОсновногоУстройства, ПараметрыОперации)
	
	Результат = Истина;
	ДисплейСостоянияОпераций = ПодключениеОсновногоУстройства.ДисплейСостоянияОпераций;
	
	Операция = ПараметрыОперации.Операция;
	Если Операция = "Корзина" Тогда
		
		СостояниеОперации = ПолучитьИлиСоздатьСостояниеОперацииДисплея(ДисплейСостоянияОпераций, "Корзина");
		ЗагруженныеМедиафайлы = СостояниеОперации.Медиафайлы;
		
		ДанныеОперации = ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыОперацииДобавленияМедиаФайла();
		МедиаФайлы = ДанныеОперации.МедиаФайлы;
		Для Каждого СтрокаКорзины Из ПараметрыОперации.Корзина Цикл
			ФайлВКорзине = СтрокаКорзины.Фото;
			Если ФайлВКорзине = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ФайлЗагружен = ЗагруженныеМедиафайлы[ФайлВКорзине.ИмяФайла] <> Неопределено;
			Если Не ФайлЗагружен Тогда
				МедиаФайлы.Добавить(ФайлВКорзине);
				ЗагруженныеМедиафайлы[ФайлВКорзине.ИмяФайла] = Истина;
			КонецЕсли;
			// не нужно данные передавать на сервер, заменить на имя файла
			СтрокаКорзины.Фото = ФайлВКорзине.ИмяФайла;
		КонецЦикла;
		
		Если МедиаФайлы.Количество() > 0 Тогда
			Команда = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя().ДобавитьМедиафайл;
			РезультатВыполнения = Ждать ПодключениеОсновногоУстройства.ОбработчикДрайвера.ВыполнениеКоманды(
				ПодключениеОсновногоУстройства, Команда, ДанныеОперации);
			Результат = РезультатВыполнения.Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

// Создает новое состояние операции дисплея покупателя.
//
// Возвращаемое значение:
//  Структура - состояние операции:
//    * МедиафайлыЗагружены - Булево - признак загрузки служебных медиаданных.
//    * Медиафайлы - Соответствие - кэш загруженных медиафайлов по имени.
//    * ПолученныеФайлыРекламы - Соответствие - кэш полученных рекламных файлов по имени.
//    * ЗагруженныеФайлыРекламы - Соответствие - имена рекламных файлов, переданных в драйвер.
//    * ИндексТекущейРекламы - Число - индекс рекламного элемента, выбранного для текущего показа.
//    * ВремяСледующейСменыРекламы - Дата, Неопределено - плановое время выбора следующей рекламы.
//    * Данные - Произвольный, Неопределено - дополнительные данные состояния текущего подключения.
//
Функция НовоеСостояниеОперацииДисплеяПокупателя()

	Результат = Новый Структура;
	Результат.Вставить("МедиафайлыЗагружены", Ложь);
	Результат.Вставить("Медиафайлы", Новый Соответствие);
	Результат.Вставить("ПолученныеФайлыРекламы", Новый Соответствие);
	Результат.Вставить("ЗагруженныеФайлыРекламы", Новый Соответствие);
	Результат.Вставить("ИндексТекущейРекламы", 0);
	Результат.Вставить("ВремяСледующейСменыРекламы");
	Результат.Вставить("Данные");
	Возврат Результат;
	 	
КонецФункции

// Возвращает состояние операции по ключу или создает его при отсутствии.
//
// Параметры:
//  СостоянияОпераций - Соответствие - коллекция состояний операций.
//  КлючСостояния - Строка - ключ состояния.
//
// Возвращаемое значение:
//  Структура - состояние операции дисплея покупателя.
//
Функция ПолучитьИлиСоздатьСостояниеОперацииДисплея(СостоянияОпераций, КлючСостояния)
	
	Состояние = СостоянияОпераций.Получить(КлючСостояния);
	Если Состояние = Неопределено Тогда
		Состояние = НовоеСостояниеОперацииДисплеяПокупателя();
		СостоянияОпераций.Вставить(КлючСостояния, Состояние);
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

#КонецОбласти

#КонецОбласти
