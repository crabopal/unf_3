//               Если не указан, команда выполняется для всех подключенных дисплеев.
//  ПараметрыОперации - Структура - параметры выполнения операции.
//  ДополнительныеПараметры - Структура, Неопределено - дополнительные параметры выполнения.
//
// Возвращаемое значение:
//  Массив из Структура - результаты выполнения команды по каждому устройству.
//
Асинх Функция ВывестиQRКодНаДисплеиПокупателяАсинх(Знач Клиент, Знач Устройство = Неопределено, Знач ПараметрыОперации = Неопределено, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Контекст = ОборудованиеДисплеиПокупателяКлиентСервер.НовыйКонтекстОперацииСОборудованием();
	Контекст.Клиент = Клиент;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Если Не ЗначениеЗаполнено(ПараметрыОперации.КартинкаQRКода) Тогда
		Контекст.ПодготовитьДанныеСервер = Истина;
	КонецЕсли;
	
	КомандыДисплея = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя();
	Команда = КомандыДисплея.ВывестиQRКод;
	Результаты = ВыполнитьКомандуНаДисплеяхПокупателя(Контекст, Устройство, Команда, ПараметрыОперации);
	Возврат Результаты;
	
КонецФункции

// Отображает информацию на выбранных дисплеях покупателя.
//
// Параметры:
