
#Область ПрограммныйИнтерфейс

Функция СписокСчетовИЗаказовПокупателей(Объект) Экспорт
	СчетаНаОплатуПокупателю = Новый Массив;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДокументОснование")
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату")
		И ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		СчетаНаОплатуПокупателю.Добавить(Объект.ДокументОснование);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Заказ")
		И ТипЗнч(Объект.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ЗначениеЗаполнено(Объект.Заказ) Тогда 
		СчетаНаОплатуПокупателю.Добавить(Объект.Заказ);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Запасы") Тогда
		Для каждого СтрокаТовары Из Объект.Запасы Цикл
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "Заказ")
				И ЗначениеЗаполнено(СтрокаТовары.Заказ) 
				И СчетаНаОплатуПокупателю.Найти(СтрокаТовары.Заказ) = Неопределено Тогда
			
				СчетаНаОплатуПокупателю.Добавить(СтрокаТовары.Заказ);
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
	Возврат СчетаНаОплатуПокупателю;
КонецФункции

Процедура ОбновитьТекстЭПД(Форма) Экспорт
	Элементы = Форма.Элементы;
	Если Элементы.Найти("ГруппаСостояниеЭПД") = Неопределено 
		ИЛИ НЕ Элементы.ГруппаСостояниеЭПД.Видимость Тогда
		
		Возврат;
	КонецЕсли;
	
	Ссылка = Форма.Объект.Ссылка;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная")
		ИЛИ (ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") 
			И УправлениеНебольшойФирмойЭлектронныеДокументыВызовСервера.ЭтоЗаказНаряд(Ссылка)) Тогда
		СписокОснования = СписокСчетовИЗаказовПокупателей(Форма.Объект); 
		ТерминальныйТип = Тип("ДокументСсылка.ЭлектроннаяТранспортнаяНакладная");
	Иначе
		Заказы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
		СписокОснования = УправлениеНебольшойФирмойЭлектронныеДокументыВызовСервера.СписокРеализацийПоЗаказам(Заказы);
		ТерминальныйТип = Тип("ДокументСсылка.ЭлектронныйЗаказЗаявка");
	КонецЕсли;
	СписокОснования.Добавить(Ссылка);
	
	СписокДокументов = УправлениеНебольшойФирмойЭлектронныеДокументыВызовСервера.ЭлектронныеДокументыПоОснованию(СписокОснования);
	ДокументооборотЗавершен = Ложь;
	Для каждого СтрокаДокумент Из СписокДокументов Цикл
		Если ТипЗнч(СтрокаДокумент.Значение) = ТерминальныйТип 
			И СтрокаДокумент.Пометка Тогда
			
			ДокументооборотЗавершен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ДекорацияОформитьЭПД.Видимость = НЕ ДокументооборотЗавершен;
	Элементы.ДекорацияЭПД.Видимость = СписокДокументов.Количество() > 0;
	
	Если СписокДокументов.Количество() = 1 Тогда
		Элементы.ДекорацияЭПД.Заголовок = СписокДокументов[0].Представление;
		Форма.ЭПДСсылка = СписокДокументов[0].Значение;
	Иначе
		Элементы.ДекорацияЭПД.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ЭПД (%1)", СписокДокументов.Количество());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
