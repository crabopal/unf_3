//  Структура:
//    * Описание - Строка, ФорматированнаяСтрока - текст описания платежной системы.
//    * Подключение - Строка, ФорматированнаяСтрока - текст подсказки о платежной системе.
//    
Функция ОписаниеПоУмолчанию() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить(
		"Описание",
		СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = '<b>Яндекс Пэй</b> - платежный сервис, разработанный Яндексом, предназначенный для быстрых и безопасных покупок в интернете и офлайн-точках продаж. Сервис позволяет пользователям оплачивать товары и услуги без ручного ввода данных банковской карты при каждой покупке.
			|Система интегрируется с банками и торговыми площадками, обеспечивая мгновенные транзакции и высокий уровень безопасности. Основная цель сервиса – сделать процесс оплаты простым и понятным. За покупки предусмотрен кешбэк. Есть возможность использовать сплит – оформлять покупки в рассрочку без процентов.
			|
			|<a href=""https://pay.yandex.ru/business/payments/qr"">Подробнее о сервисе</a>'")));

	Результат.Вставить(
		"Подключение",
		СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Для подключения к Яндекс Пэй заполните настройки. Получить данные для настройки можно в <a href=""https://console.pay.yandex.ru/settings"">личном кабинете Яндекс</a>'")));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПрочиеСлужебныеПроцедурыИФункции

// Проверяет строку корзины на соответствие требованиям Яндекса и возвращает описание ошибок.
//
// Параметры:
//  ИдентификаторНоменклатуры - Строка - идентификатор товара.
//  Количество - Число - количество товара.
//  Цена - Число - цена за единицу.
//  Сумма - Число - общая сумма по строке.
//  ПредставлениеНоменклатуры - Строка - представление товара.
//  Описание - Строка - описание товара.
//
// Возвращаемое значение:
//  Строка - описание ошибок заполнения или пустая строка, если ошибок нет
//
Функция ОшибкиСтрокиКорзины(
		ИдентификаторНоменклатуры,
		Количество,
		Цена,
		Сумма,
		ПредставлениеНоменклатуры,
		Описание)
	
	Результат = "";
	
	МаксимальнаяДлинаСтроки = 2048;
	МаксимальноеЧисло = МаксимальноеЧислоЯндексПэй();
	ОшибкиСтрока = Новый Массив;
	
	Если СтрДлина(ИдентификаторНоменклатуры) > МаксимальнаяДлинаСтроки Тогда
		ОшибкиСтрока.Добавить("Идентификатор номенклатуры");
	КонецЕсли;
	Если Количество > МаксимальноеЧисло Тогда
		ОшибкиСтрока.Добавить("Количество");
	КонецЕсли;
	Если Цена > МаксимальноеЧисло Тогда
		ОшибкиСтрока.Добавить("Цена");
	КонецЕсли;
	Если Сумма > МаксимальноеЧисло Тогда
		ОшибкиСтрока.Добавить("Сумма");
	КонецЕсли;
	
	ПредставлениеНоменклатуры = Лев(ПредставлениеНоменклатуры, МаксимальнаяДлинаСтроки);
	Описание = Лев(Описание, МаксимальнаяДлинаСтроки);
	
	Если ОшибкиСтрока.Количество() > 0 Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибки в заполнении полей [%1] для номенклатуры %2 (%3)'"),
			СтрСоединить(ОшибкиСтрока, ","),
			ПредставлениеНоменклатуры,
			ИдентификаторНоменклатуры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что сумма корзины не превышает максимально допустимое значение.
//
// Параметры:
//  СуммаКорзины - Число - проверяемая сумма.
//
// Возвращаемое значение:
//  Строка - текст ошибки, если сумма превышает лимит; пустая строка,
//    если проверка пройдена успешно.
//    
Функция ОшибкаСуммаКорзины(СуммаКорзины)

	Если СуммаКорзины > МаксимальноеЧислоЯндексПэй() Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Общая сумма товаров не должна превышать %1'"),
				МаксимальноеЧислоЯндексПэй());
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает максимально допустимое значение числовых полей
//
// Возвращаемое значение:
//  Число - максимально допустимое значение.
//
Функция МаксимальноеЧислоЯндексПэй()
	
	Возврат 1000000;
	
КонецФункции

