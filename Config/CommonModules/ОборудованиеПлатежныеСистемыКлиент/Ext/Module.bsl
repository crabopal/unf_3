	Контекст = ОборудованиеПлатежныеСистемыКлиентСервер.НовыйКонтекстОперацииСОборудованием();
	Контекст.Клиент = Клиент;       
	Контекст.ПодготовитьДанныеКлиент = Истина;      
	Контекст.ОбработатьДанныеСервер = Истина;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Если Устройство = Неопределено Тогда
		Устройство = Ждать ВыбратьУстройствоАсинх();
	КонецЕсли;
	Контекст.ОсновноеУстройство = Устройство;
	
	Результат = Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации);
	Возврат Результат;
	
КонецФункции

// Выполнить операции на эквайринговом терминале.
// Если эквайринговый терминал не поддерживает печать квитанций на терминале, для печати подключается печатающее устройство.
// 
// Параметры:
//  Клиент - ФормаКлиентскогоПриложения - идентификатор формы.
//  Устройство - СправочникСсылка.ПодключаемоеОборудование - идентификатор устройства, если неопределенно - будет предложен выбор.
//  ПараметрыОперации - Структура - параметры выполнения операции.
//  ДополнительныеПараметры - Структура - дополнительные команды.
//
// Возвращаемое значение:
//  Структура
//
Асинх Функция ВыполнитьАварийнуюОтменуОперацииАсинх(Знач Клиент, Знач Устройство = Неопределено, Знач ПараметрыОперации = Неопределено, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Команда = "EmergencyVoid";
	Контекст = ОборудованиеПлатежныеСистемыКлиентСервер.НовыйКонтекстОперацииСОборудованием();
	Контекст.Клиент = Клиент;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Если Устройство = Неопределено Тогда
		Устройство = Ждать ВыбратьУстройствоАсинх();
	КонецЕсли;
	Контекст.ОсновноеУстройство = Устройство;
	
	Результат = Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации);
	Возврат Результат;
	
КонецФункции

// Возвращает строку последнего слип-чека
//
// Возвращаемое значение:
//  Строка
Функция ПоследнийСлипЧек() Экспорт
	
	ПодключаемоеОборудование = МенеджерОборудованияКлиент.ПодключаемоеОборудование();
	Возврат ПодключаемоеОборудование.ПоследнийСлипЧек;    
	
КонецФункции

// Возвращает возможные типы пакетной операции
// 
// Возвращаемое значение:
//  Соответствие
Функция ТипыПакетнойОперацииВОчередиЧеков() Экспорт
	
	Результат = Новый Соответствие();
	Результат.Вставить("НеПакетнаяОперация", ПредопределенноеЗначение("Перечисление.ТипыПакетнойОперацииВОчередиЧеков.НеПакетнаяОперация"));
	Результат.Вставить("ФискализацияЧекаСОплатойКартой", ПредопределенноеЗначение("Перечисление.ТипыПакетнойОперацииВОчередиЧеков.ФискализацияЧекаСОплатойКартой"));
	Результат.Вставить("ПродажаСВыдачейНаличных", ПредопределенноеЗначение("Перечисление.ТипыПакетнойОперацииВОчередиЧеков.ПродажаСВыдачейНаличных"));
	Результат.Вставить("ПокупкаСЗачислением", ПредопределенноеЗначение("Перечисление.ТипыПакетнойОперацииВОчередиЧеков.ПокупкаСЗачислением"));
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Асинх Функция ВыбратьУстройствоАсинх() Экспорт
	
	ПоддерживаемыеТипы = МенеджерОборудованияКлиент.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.ЭквайринговыйТерминал = Истина;
	РезультатВыбора = Ждать МенеджерОборудованияКлиент.ВыбратьУстройствоАсинх(
		ПоддерживаемыеТипы,
		НСтр("ru='Выберите эквайринговый терминал'"), 
		НСтр("ru='Эквайринговый терминал не подключен.'"),
		НСтр("ru='Эквайринговый терминал не выбран.'"));
		
	Если Не РезультатВыбора.Результат Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатВыбора.ИдентификаторУстройства;
	
КонецФункции

#Область ПодготовкаИОбработкаДанныхОперации

Асинх Функция ПриПодготовкеДанныхОперацииАсинх(ДанныеОперации, ПараметрыПодключения, Команда, ПараметрыОперации) Экспорт
	
	ДанныеОперации.Вставить("Результат", Истина);
	ДанныеОперации.Вставить("ТекстОшибки", "");
	ОбщегоНазначенияБПОКлиентСервер.ДополнитьСтруктуру(ДанныеОперации, ПараметрыОперации);
	
	Если ПараметрыОперации <> Неопределено И ПараметрыОперации.Свойство("РеквизитыКартыQR") Тогда
		РеквизитыКартыQR = ПараметрыОперации.РеквизитыКартыQR;
		Если ЗначениеЗаполнено(РеквизитыКартыQR) И Не ОборудованиеПлатежныеСистемыКлиентСервер.ЭтоРеквизитыКартыQR(РеквизитыКартыQR) Тогда
			ДанныеОперации.ТекстОшибки = НСтр("ru='Операция по указанному QR-коду невозможна.'");
			ДанныеОперации.Результат = Ложь;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Команда = "ReturnElectronicCertificate" И ПустаяСтрока(ПараметрыОперации.СсылочныйНомер) Тогда
		Подсказка = НСтр("ru='Введите RRN операции cо слип-чека покупки ЭС'"); 
		СтрокаRRN = Ждать ВвестиСтрокуАсинх("", Подсказка, 12);
		Если СтрокаRRN <> Неопределено Тогда
			ПараметрыОперации.СсылочныйНомер = СтрокаRRN;
		КонецЕсли;
	КонецЕсли;            
	
	Если Команда <> "OperationStatus" Тогда
		Если Команда = "PayElectronicCertificate" Или Команда = "ReturnElectronicCertificate" Тогда
			Если ПустаяСтрока(ПараметрыОперации.ИдентификаторКорзины) 
				Или (ПараметрыОперации.СуммаЭлектронногоСертификата = 0 И ПараметрыОперации.СкидкаЭлектроннымиСертификатами = 0)  Тогда
				ДанныеОперации.ТекстОшибки = НСтр("ru='Неверные параметры в операции.'");
				ДанныеОперации.Результат = Ложь; 
				Возврат ДанныеОперации;
			КонецЕсли;
		Иначе
			Если НЕ (ПараметрыОперации.СуммаОперации > 0) Тогда   
				ДанныеОперации.ТекстОшибки =  НСтр("ru='Некорректная сумма операции.'");
				ДанныеОперации.Результат = Ложь; 
				Возврат ДанныеОперации;
			КонецЕсли;
		КонецЕсли;                                                                                               
	КонецЕсли;
	
	Если Команда <> "OperationStatus" Тогда  
		ПараметрыОперации.ИдентификаторОперацииНаОборудовании = ИдентификаторОперацииНаОборудовании();    
		ДанныеОперации.Вставить("ИдентификаторОперацииНаОборудовании", ПараметрыОперации.ИдентификаторОперацииНаОборудовании);
	КонецЕсли;
	
	Если Команда = "AuthorizeSales" Или Команда = "AuthorizeRefund" Или Команда = "AuthorizeVoid" 
		Или Команда = "PayByPaymentCardWithCashWithdrawal" Или Команда = "PurchaseWithEnrollment"       
		Или Команда = "PayElectronicCertificate" Или Команда = "ReturnElectronicCertificate"
		Или Команда = "AuthorizePreSales" Или Команда = "AuthorizeCompletion" Или Команда = "AuthorizeVoidPreSales" Тогда      
		ДанныеОперации.Вставить("ВходящиеПараметрыXML", ПолучитьXMLПакетДляОперации(ПараметрыОперации)); 
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Асинх Функция ПриОбработкеРезультатовОперацииАсинх(ДанныеОперации, ПараметрыПодключения, Команда, РезультатОперации) Экспорт
	
	ДополнительныеУстройства = ПараметрыПодключения.ДополнительныеУстройства;
	Если ДополнительныеУстройства.Свойство("ПечатающееУстройство") Тогда
		
		Ждать ВывестиСлипЧекАсинх(ПараметрыПодключения, ДанныеОперации);
		
	КонецЕсли;
	
КонецФункции

