// Генеририровать идентификатор операции на Оборудовании
// Целое число размерностью 4 байта, представлено как HEX-строка длинной 8 символом ASCII без «0x»
//          
// Возвращаемое значение:
//   Строка - 
//
Функция ИдентификаторОперацииНаОборудовании() 
	Генератор = Новый ГенераторСлучайныхЧисел();   
	ЗначенияЧисла = Генератор.СлучайноеЧисло(100);
	Возврат МенеджерОборудованияКлиентСервер.ЧислоВСтрокуHEX(ЗначенияЧисла);
	
