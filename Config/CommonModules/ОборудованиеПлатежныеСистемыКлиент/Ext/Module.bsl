// Получить XMLПакет для операции.
// 
// Параметры:
//  ПараметрыОперации - Структура - Параметры
// 
// Возвращаемое значение:
//  Строка - Получить XMLПакет для операции
//
Функция ПолучитьXMLПакетДляОперации(ПараметрыОперации) Экспорт
	
#Если ВебКлиент Тогда
	Возврат ОборудованиеПлатежныеСистемыВызовСервера.ПолучитьXMLПакетДляОперации(ПараметрыОперации);
#Иначе
	Возврат ОборудованиеПлатежныеСистемыКлиентСервер.ПолучитьXMLПакетДляОперации(ПараметрыОперации);
#КонецЕсли

КонецФункции

Процедура ВыполнениеОперацииНаЭквайринговомТерминалеКоманда(КонтекстОперации) Экспорт
	
	Если КонтекстОперации.ПараметрыОперации <> Неопределено Тогда
		Если КонтекстОперации.ПараметрыОперации.Свойство("РеквизитыКартыQR") Тогда
			РеквизитыКартыQR = КонтекстОперации.ПараметрыОперации.РеквизитыКартыQR;
			Если Не ПустаяСтрока(РеквизитыКартыQR) Тогда
				Если Не ОборудованиеПлатежныеСистемыКлиентСервер.ЭтоРеквизитыКартыQR(РеквизитыКартыQR) Тогда     
					ТекстСообщения = НСтр("ru='Операция по указанному QR-коду невозможна.'");
					РезультатВыполнения = МенеджерОборудованияКлиентСервер.ПараметрыВыполненияОперацииНаОборудовании(Ложь, ТекстСообщения);
					ВыполнитьОбработкуОповещения(КонтекстОперации.ОповещениеПриЗавершении, РезультатВыполнения);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	ПараметрыВыполнениеКоманды = МенеджерОборудованияКлиентСервер.ПараметрыВыполнениеКоманды(КонтекстОперации.ТипТранзакции,
		"ОборудованиеПлатежныеСистемы", КонтекстОперации.ДополнительныеПараметры, КонтекстОперации.ПодготовитьДанные, КонтекстОперации.ОбработатьДанные, 
		КонтекстОперации.ИспользоватьПечатающееУстройство, КонтекстОперации.ОбработатьДанныеПриОшибке);   
	ПараметрыВыполнениеКоманды.ПодготовитьДанныеКлиент = КонтекстОперации.ПодготовитьДанныеКлиент;
		
	МенеджерОборудованияКлиент.НачатьВыполнениеКоманды(КонтекстОперации.ОповещениеПриЗавершении, КонтекстОперации.ИдентификаторКлиента, 
		КонтекстОперации.ИдентификаторУстройства, КонтекстОперации.ПараметрыОперации, ПараметрыВыполнениеКоманды, КонтекстОперации.ПечатающееУстройство);
	
КонецПроцедуры

Асинх Функция ВывестиСлипЧекАсинх(ПараметрыПодключения, ДанныеОперации)
	
	ПечатающееУстройство = ПараметрыПодключения.ДополнительныеУстройства.ПечатающееУстройство;
	ПодключениеПечатающегоУстройства = ПараметрыПодключения.ПодключенияУстройств.Получить(ПечатающееУстройство);
	
	Если ЗначениеЗаполнено(ПодключениеПечатающегоУстройства) 
		И ДанныеОперации.Свойство("ТекстСлипЧека") И Не ПустаяСтрока(ДанныеОперации.ТекстСлипЧека) Тогда
		
		ТекстСлипЧека = ДанныеОперации.ТекстСлипЧека;
		УстановитьПоследнийСлипЧек(ТекстСлипЧека);
		ОбработчикДрайвера = МенеджерОборудованияСлужебныйКлиент.ОбработчикКомандОборудования();
		
		КомандаПечати = "PrintText";
		ДанныеОперации.Вставить("ТестовыеЧеки", ДанныеОперации.ТекстСлипЧекаXML);
		РезультатВыполнения = Ждать ОбработчикДрайвера.ВыполнениеКоманды(
			ПодключениеПечатающегоУстройства, КомандаПечати, ДанныеОперации);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ТребуетсяПодключитьПечатающееУстройство(Контекст, ПараметрыОперации)
	
	ПодключитьПечатающееУстройство = 
		ПараметрыОперации.ИспользоватьПечатающееУстройство 
		И Контекст.ДанныеОперации.ПечатьСлипЧека;
		
	Если ПодключитьПечатающееУстройство Тогда
		ПодключенныйТерминал = МенеджерОборудованияКлиент.ПолучитьПодключенноеУстройство(Контекст.ОсновноеУстройство);
		Если ЗначениеЗаполнено(ПодключенныйТерминал) Тогда
			ПодключитьПечатающееУстройство = Не ПодключенныйТерминал.ПечатьКвитанцийНаТерминале;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПодключитьПечатающееУстройство;
	
КонецФункции

Асинх Функция ВыбратьПечатающееУстройствоАсинх(ПечатающееУстройство)
	
	Если ПечатающееУстройство = Неопределено И ОбщегоНазначенияБПОКлиент.ИспользуетсяЧекопечатающиеУстройства() Тогда
		МодульОборудованиеЧекопечатающиеУстройстваКлиент = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("ОборудованиеЧекопечатающиеУстройстваКлиент");
		Возврат Ждать МодульОборудованиеЧекопечатающиеУстройстваКлиент.ВыбратьУстройствоАсинх();
	КонецЕсли;
	
	Возврат ПечатающееУстройство;
	
КонецФункции

#КонецОбласти  