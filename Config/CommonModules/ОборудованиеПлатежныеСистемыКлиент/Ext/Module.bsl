Асинх Функция ВыполнитьОперациюНаЭквайринговомТерминалеАсинх(Знач Клиент, Знач Устройство = Неопределено, Знач ПараметрыОперации = Неопределено, Знач ДополнительныеПараметры = Неопределено, Знач ПечатающееУстройство = Неопределено) Экспорт
	
	Контекст = ОборудованиеПлатежныеСистемыКлиентСервер.НовыйКонтекстОперацииСОборудованием();
	Контекст.Клиент = Клиент;
	Контекст.ПодготовитьДанныеКлиент = Истина;
	Контекст.ОбработатьДанныеСервер = Истина;
	Контекст.ОбработатьДанныеКлиент = Истина;
	Контекст.ОбработатьДанныеПриОшибкеСервер = Истина;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Если Устройство = Неопределено Тогда
		Устройство = Ждать ВыбратьУстройствоАсинх();
	КонецЕсли;
	Контекст.ОсновноеУстройство = Устройство;

	ДанныеДляДополнения = МенеджерОборудованияКлиент.ПечатьСлипЧекаЭквайринговойОперации();
	ОбщегоНазначенияБПОКлиентСервер.ДополнитьСтруктуру(Контекст.ДанныеОперации, ДанныеДляДополнения);
	
	Если ТребуетсяПодключитьПечатающееУстройство(Контекст, ПараметрыОперации) Тогда
		ПечатающееУстройство = Ждать ВыбратьПечатающееУстройствоАсинх(ПечатающееУстройство);
		Контекст.ДополнительныеУстройства.Вставить("ПечатающееУстройство", ПечатающееУстройство);
	КонецЕсли;
	
	Результат = Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, ПараметрыОперации.ТипТранзакции, ПараметрыОперации);
	Возврат Результат;
	
КонецФункции

