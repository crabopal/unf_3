// Записывает архив логов драйвера для указанного подключаемого оборудования.
//
// Параметры:
//  ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование - 
//      оборудование, для которого записываются логи
//  Данные - Массив Из ОписаниеПередаваемогоФайла - если файлы переданы для архивирования на сервер
//         - ДвоичныеДанные  - если фалы были заархивированы на клиенте
Процедура ЗаписатьАрхивЛоговДрайвера(ПодключаемоеОборудование, Знач Данные) Экспорт
	
	РегистрыСведений.АрхивЛоговДрайверовОборудования.
		ЗаписатьАрхивЛоговДрайвера(ПодключаемоеОборудование, Данные);
	
КонецПроцедуры

// Отправляет ответ на запрос записи архива логов драйвера подключенного оборудования.
//
// Параметры:
//   ДанныеЗапроса - Структура - данные исходного запроса:
//    * ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование - 
//       ссылка на подключаемое оборудование
//    * НомерСеансаДляОтвета - Число - номер сеанса отправки запроса
//    * Данные - Структура - данные записи архива логов
//   РезультатЗагрузки - Структура - результат обработки запроса который нужно отправить:
//    * Успешно - Булево - признак успешности обработки запроса
//    * ТекстОшибки - Строка - текст ошибки обработки
//
Процедура ОтправитьОтветЗаписиАрхиваЛоговДрайвера(Знач ДанныеЗапроса, Знач РезультатЗагрузки) Экспорт

	Справочники.ПодключаемоеОборудование.
		ОтправитьОтветЗаписиАрхиваЛоговДрайвера(ДанныеЗапроса, РезультатЗагрузки);
	
КонецПроцедуры

Процедура ПриПодготовкеДанныхОперации(Знач ПроцессорДанных, ДанныеОперации, Знач ПараметрыПодключения, Знач Команда, Знач ПараметрыОперации) Экспорт
	
	МодульПроцессорДанных = ОбщегоНазначенияБПО.ОбщийМодуль(ПроцессорДанных);
	МодульПроцессорДанных.ПриПодготовкеДанныхОперации(ДанныеОперации, ПараметрыПодключения, Команда, ПараметрыОперации);
	
КонецПроцедуры

Процедура ПриОбработкеРезультатовОперации(Знач ПроцессорДанных, ДанныеОперации, Знач ПараметрыПодключения, Знач Команда, РезультатОперации) Экспорт
	
	РезультатОперации.Вставить("ТестовоеПолеСозданноеНаСервере", Новый Структура);
	
	МодульПроцессорДанных = ОбщегоНазначенияБПО.ОбщийМодуль(ПроцессорДанных);
	МодульПроцессорДанных.ПриОбработкеРезультатовОперации(ДанныеОперации, ПараметрыПодключения, Команда, РезультатОперации);
	
КонецПроцедуры

Функция КлючиЗаписейПоДокументу(ДокументОснование) Экспорт
	Результат = Новый Массив;
	ЗначенияКлючей = РегистрыСведений.ФискальныеОперации.ЗначенияКлючейПоДокументу(ДокументОснование);
	Для Каждого ЗначенияКлюча Из ЗначенияКлючей Цикл
		Ключ = РегистрыСведений.ФискальныеОперации.СоздатьКлючЗаписи(ЗначенияКлюча);
		Результат.Добавить(Ключ);
	КонецЦикла;
	Возврат Результат; 
	
КонецФункции

Функция ВызватьHTTPМетодСервер(Метод, ПараметрыСоединения) Экспорт
	
	Результат = МенеджерОборудованияКлиентСервер.РезультатВызоваМетодаHTTP();
	Результат.ВызовНаСервере = Истина;
	
	Если ОбщегоНазначенияБПО.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		ПолучениеФайловИзИнтернетаМодуль = ОбщегоНазначенияБПО.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Прокси = ПолучениеФайловИзИнтернетаМодуль.ПолучитьПрокси("https");
	Иначе
		Прокси = Неопределено;
	КонецЕсли;
	
	Если ПараметрыСоединения.Порт = 443 Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияБПОКлиентСервер.НовоеЗащищенноеСоединение();
		Соединение = Новый HTTPСоединение(
			ПараметрыСоединения.Хост, ПараметрыСоединения.Порт, , , Прокси, ПараметрыСоединения.Таймаут, ЗащищенноеСоединение);
	Иначе
		Соединение = Новый HTTPСоединение(
			ПараметрыСоединения.Хост, ПараметрыСоединения.Порт, , , Прокси, ПараметрыСоединения.Таймаут);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ПараметрыСоединения.ТокенДоступа) Тогда
		ПараметрыСоединения.Заголовки.Вставить("Authorization", ПараметрыСоединения.ТокенДоступа);
	КонецЕсли;
	HTTPЗапрос = Новый HTTPЗапрос(ПараметрыСоединения.АдресРесурса, ПараметрыСоединения.Заголовки);
	
	Попытка
		HTTPОтвет = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		Результат.КодОтвета = HTTPОтвет.КодСостояния;
		Результат.ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если ИнформацияОбОшибке.ЯвляетсяОшибкойКатегории(КатегорияОшибки.ОшибкаСети) Тогда
			Результат.Таймаут = Истина;
		Иначе
			ОбщегоНазначенияБПО.ЗаписатьОшибкуВЖурналРегистрации(
				НСтр("ru = 'Ошибка доступа к сервису проверки возраста Макс'"), 
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Результат.ОписаниеОшибки = ОбработкаОшибок.ПредставлениеОшибкиДляПользователя(ИнформацияОбОшибке);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#Область РазрешенныеМетодыДляВызоваКакПроизвольныйКод

// Возвращает список методов, которые могут быть вызваны как произвольный код
// (для регламентных заданий и фоновых заданий)
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("УстановитьПараметрыСеансаПодключаемогоОборудования");
	
КонецПроцедуры

