Процедура ОбменССервером(ДанныеДляСервера, Знач ДанныеДляСервераПоЗначению) Экспорт
	
	// ++ НеМобильноеПриложение 
	Если ОбщегоНазначенияБПО.ИспользуетсяКассоваяСмена() Тогда
		Если ДанныеДляСервера.Свойство("СтатусыКассовыхСмен") Тогда
			СтатусыКассовыхСмен = ДанныеДляСервера.СтатусыКассовыхСмен;
			МодульКассовыеСмены = ОбщегоНазначенияБПО.ОбщийМодуль("КассовыеСмены");
			Для Каждого Статус Из СтатусыКассовыхСмен Цикл
				СтатусСмены = МодульКассовыеСмены.СтатусПоследнейСмены(Статус.Ключ);
				СтатусыКассовыхСмен.Вставить(Статус.Ключ, СтатусСмены);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеДляСервераПоЗначению.Свойство("ЗаписиЛогирования") Тогда
		
		ЗаписиЛогирования = ДанныеДляСервераПоЗначению.ЗаписиЛогирования;
		ЛогированиеОперацийБПО.ЗаписатьЛогОперацииНаСервереВФоне(ЗаписиЛогирования);
		
	КонецЕсли;
	// -- НеМобильноеПриложение 
	
КонецПроцедуры

