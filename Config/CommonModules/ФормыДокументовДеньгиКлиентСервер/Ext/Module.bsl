// Функция - Возвращает строковое представление типа документа
//
// Параметры:
//  Форма - Форма - Форма денежного документа
// 
// Возвращаемое значение:
//  Строка - Строковое представление типа документа
//
Функция ТипДокументаСтрокой(Форма) Экспорт
	
	Если ТипЗнч(Форма) = Тип("Строка") Тогда
		ИмяФормыМассив = СтрРазделить(Форма, ".", Ложь);
	Иначе
		ИмяФормыМассив = СтрРазделить(Форма.ИмяФормы, ".", Ложь);
	КонецЕсли;
	
	Если ИмяФормыМассив.Количество() >=2 Тогда
		Возврат ИмяФормыМассив[1];
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Функция - Проверяет используется ли договор в переданном виде операции
//
// Параметры:
//  ВидОперации       - Перечисления.ВидыОперацийПлатежноеПоручение
//                    - Перечисления.ВидыОперацийПоступлениеВКассу
//                    - Перечисления.ВидыОперацийПоступлениеНаСчет
//                    - Перечисления.ВидыОперацийРасходИзКассы
//                    - Перечисления.ВидыОперацийРасходСоСчета
//                    - Перечисления.ВидыОперацийЭквайринга
// 
// Возвращаемое значение:
//  Булево - Результат проверки
//
Функция ВидОперацииБезДоговора(ВидОперации) Экспорт
	
	Возврат ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ВыдачаЗаймаСотруднику")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.РасчетыПоКредитам")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходИзКассы.РасчетыПоКредитам")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.ВозвратЗаймаСотрудником")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.РасчетыПоКредитам")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ВозвратЗаймаСотрудником")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.РасчетыПоКредитам")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПеречислениеНалога")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Зарплата")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.РасчетыПоКредитам");
	
КонецФункции

