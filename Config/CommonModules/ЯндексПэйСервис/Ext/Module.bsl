///////////////////////////////////////////////////////////////////////////////////////////////////////
// Подсистема "ИнтернетПоддержкаПользователей.ПлатежныеСистемы.ЯндексПэй".
// ОбщийМодуль.ЯндексПэйСервис.
//
// Серверные процедуры обмена данными с платежной системой Яндекс Пэй через сервис Интернет-поддержки:
//  - выполнение оплаты, возвратов и получение статус операций;
//  - получение информации о подсказках платежной системы.
//  - обработка полученных ответов от сервиса.
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбщиеМетоды

// Возвращает идентификатор платежной системы Яндекс Пэй.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдентификаторПлатежнойСистемы() Экспорт
	
	Возврат "yandex-pay";
	
КонецФункции

// Возвращает начало адресной строки для вызова методов платежной системы.
//
// Возвращаемое значение:
//  Строка
//
Функция КореньАдресаИнтеграции() Экспорт
	
	Возврат "isl";
	
КонецФункции

#КонецОбласти

#Область НастройкиПодключения

// Производит проверку данных аутентификации в сервисе Яндекс Пэй.
//
// Параметры:
//  ДанныеАутентификации - Структура - данные аутентификации.
//
// Возвращаемое значение:
//  Структура:
//    * КодОшибки - Строка - строковый код возникшей ошибки.
//        Возможные значения см. НастройкиПлатежныхСистемСлужебный.ПереопределитьКодОшибкиСервиса.
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//    * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//
Функция ПроверитьПараметрыПодключения(ДанныеАутентификации) Экспорт
	
	// На момент разработки подсистемы в документации к сервису отсутствовал метод проверки данных аутентификации,
	// поэтому проверка выполняться через попытку получить данные не существующего заказа
	
	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	
	ПараметрыОперации = ПараметрыЗапросаСтатусОперации(
		ЯндексПэйСлужебный.ТипСсылкиДинамическая(),
		"_ТестПодключения_",
		ДанныеАутентификации);

	ТекстОшибки = НСтр("ru = 'Не удалось проверить данные аутентификации.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	// Если Яндекс смог обработать запрос, то он всегда возвращает ответ с кодом 200, даже если есть ошибки.
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("codeError", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	ДанныеОтвета.Вставить("data_type", РезультатЧтения.РезультатЧтения.Получить("data_type"));
	ДанныеОтвета.Вставить("error", РезультатЧтения.РезультатЧтения.Получить("error"));
	ДанныеОтвета.Вставить("sale_token", РезультатЧтения.РезультатЧтения.Получить("sale_token"));
	
	Если ДанныеОтвета.codeError = 101
		И ДанныеОтвета.data_type = "error"
		И ДанныеОтвета.error = "Операция не найдена" Тогда // АПК:1297 текст из сообщения банка. Не должен локализоваться
		// Правильный ответ - нет ошибки проверки параметров подключения.
		Возврат Результат;
	КонецЕсли;
	
	Если ДанныеОтвета.codeError = 404
		И ДанныеОтвета.data_type = "error"
		И ДанныеОтвета.error = "Функционал недоступен" Тогда // АПК:1297 текст из сообщения банка. Не должен локализоваться
		// Ошибка аутентификации
		
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеверныйЛогинИлиПароль();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка аутентификации в сервисе платежной системы.'");
		Результат.ИнформацияОбОшибке = Результат.СообщениеОбОшибке;
		
		Возврат Результат;
	КонецЕсли;
	
	// Если еще не вышли из метода, значит неизвестный код ошибки в ответе сервиса.
	
	ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
				|
				|Сервис платежной системы вернул не декларированный ответ.
				|
				|Техническая информация об ошибке:
				|Платежная система: Яндекс Пэй
				|Код состояния: %2
				|Ответ сервиса:
				|%3'"),
			ТекстОшибки,
			РезультатЗапроса.КодСостояния,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
	
	Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
	Результат.СообщениеОбОшибке  = НСтр("ru = 'Неизвестная ошибка в ответе сервиса.'");
	Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
	
	ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(ИнформацияОбОшибке, Истина);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область КассовыеСсылки

// Получает список активных кассовых ссылок по настройке
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройки подключения к сервису
//
// Возвращаемое значение:
//  Структура:
//    * КодОшибки - Строка - строковый код возникшей ошибки.
//        Возможные значения см. НастройкиПлатежныхСистемСлужебный.ПереопределитьКодОшибкиСервиса.
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//    * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//    * КассовыеСсылки - Массив Из Структура - список активных кассовых ссылок:
//      ** КлючСсылки - Строка - идентификатор кассовой ссылки.
//      ** Представление - Строка - уникальное название кассовой ссылки для отображения пользователю.
//
Функция КассовыеСсылки(НастройкаПодключения) Экспорт
	
	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	Результат.Вставить("КассовыеСсылки", Новый Массив);
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	ПараметрыОперации = ПараметрыЗапросаКассовыеСсылки(ДанныеАутентификации);

	ТекстОшибки = НСтр("ru = 'Не удалось получить список кассовых ссылок.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Массив"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КассоваяСсылка Из РезультатЧтения.РезультатЧтения Цикл
					
		Если ТипЗнч(КассоваяСсылка) = Тип("Соответствие")
			Или ТипЗнч(КассоваяСсылка) = Тип("ФиксированноеСоответствие") Тогда
			
			Результат.КассовыеСсылки.Добавить(
				Новый Структура(
					"КлючСсылки, Представление",
					КассоваяСсылка.Получить("key"),
					КассоваяСсылка.Получить("name")));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает запрос на совершение оплаты и активирует QR-код продавца для приема оплаты на заданную сумму.
// Ссылка читается успешно активированной, если КодОшибки содержит пустую строку.
// Метод может быть вызван в тестовом режиме для тестирования активации кассовой ссылки и получения URL-адреса.
// В этом случае параметр ДокументОперации можно не указывать, а результат операции деактивации ссылки заносится
// в свойство РезультатДеактивации.
// 
// Параметры:
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройка подключения к
//    платежному сервису.
//  КлючСсылки - Строка - ключ кассовой ссылки.
//  ДанныеЗаказа - см. ЯндексПэйСлужебный.НовыйДанныеЗаказаНаОплату.
//  ДополнительныеПараметры - Произвольный -дополнительные настройки формирования заказа на оплату.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемы.АктивироватьКассовуюСсылку
//
Функция АктивироватьКассовуюСсылку(
		НастройкаПодключения,
		КлючСсылки,
		ДанныеЗаказа) Экспорт

	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	Результат.Вставить("ПлатежнаяСсылка", "");
	Результат.Вставить("ИдентификаторОперации", "");
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	ТекстОшибки = НСтр("ru = 'Не удалось активировать кассовую ссылку.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	ПараметрыОперации = ПараметрыЗапросаЗаказНаОплату(
		ЯндексПэйСлужебный.ТипСсылкиКассовая(),
		ДанныеАутентификации,
		ДанныеЗаказа,
		КлючСсылки);

	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	Эталон.Вставить("ПлатежнаяСсылка", РезультатЧтения.РезультатЧтения.Получить("qrKey"));
	Эталон.Вставить("КлючКассы", РезультатЧтения.РезультатЧтения.Получить("kassa_key"));
	Эталон.Вставить("ИдентификаторОперации", РезультатЧтения.РезультатЧтения.Получить("sale_token"));
	
	Если Эталон.ТипРезультата = "success" И Эталон.КодОтвета = 1 Тогда
		
		Результат.ПлатежнаяСсылка = Эталон.ПлатежнаяСсылка;
		Результат.ИдентификаторОперации = ЯндексПэйСлужебный.КодироватьИдентификаторОплаты(
			Эталон.ИдентификаторОперации,
			ЯндексПэйСлужебный.ТипСсылкиКассовая());
		
	ИначеЕсли Эталон.ТипРезультата = "error" Или Эталон.КодОтвета = 0 Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке = НСтр("ru = 'Не удалось активировать кассовую ссылку.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	Иначе
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул недекларированное значение.
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %2'"),
			ТекстОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// См. ПлатежныеСистемы.ДеактивироватьКассовуюСсылку
//
Функция ДеактивироватьКассовуюСсылку(
		НастройкаПодключения,
		ПараметрыКассовойСсылки) Экспорт

	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	ПараметрыОперации = ПараметрыЗапросаДеактивацияКассовойСсылки(
		ДанныеАутентификации,
		ПараметрыКассовойСсылки);

	ТекстОшибки = НСтр("ru = 'Не удалось деактивировать кассовую ссылку.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	
	Если Эталон.КодОтвета <> 1 Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Не удалось деактивировать кассовую ссылку.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ДинамическиеСсылки

// Создает запрос на совершение оплаты и получает идентификатор оплаты для формирования QR-кода.
// Ссылка считается успешно активированной, если КодОшибки содержит пустую строку.
// 
// Параметры:
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройка подключения к
//    платежному сервису.
//  ДанныеЗаказа - см. ЯндексПэйСлужебный.ДанныеЗаказаНаОплату.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемы.ДинамическаяСсылка
//
Функция ДинамическаяСсылка(
		НастройкаПодключения,
		ДанныеЗаказа) Экспорт

	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	Результат.Вставить("ПлатежнаяСсылка", "");
	Результат.Вставить("ИдентификаторОперации", "");
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	ТекстОшибки = НСтр("ru = 'Не удалось получить платежную ссылку.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	ПараметрыОперации = ПараметрыЗапросаЗаказНаОплату(
		ЯндексПэйСлужебный.ТипСсылкиДинамическая(),
		ДанныеАутентификации,
		ДанныеЗаказа);

	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	Эталон.Вставить("ПлатежнаяСсылка", РезультатЧтения.РезультатЧтения.Получить("qrSBP"));
	Эталон.Вставить("ИдентификаторОперации", РезультатЧтения.РезультатЧтения.Получить("sale_token"));
	
	Если (Эталон.ТипРезультата = "success") Или (Эталон.КодОтвета = 1) Тогда
		
		Результат.ИдентификаторОперации = ЯндексПэйСлужебный.КодироватьИдентификаторОплаты(
			Эталон.ИдентификаторОперации,
			ЯндексПэйСлужебный.ТипСсылкиДинамическая());
		Результат.ПлатежнаяСсылка = Эталон.ПлатежнаяСсылка;
		
	ИначеЕсли (Эталон.ТипРезультата = "error") Или (Эталон.КодОтвета = 0) Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Не удалось получить платежную ссылку.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	Иначе
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул недекларированное значение.
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %2'"),
			ТекстОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует запрос банку на отмену платежной ссылки.
// Ссылка считается успешно отмененной, если КодОшибки содержит пустую строку.
// 
// Параметры:
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройка подключения к
//    платежному сервису.
//  ИдентификаторОперации - Строка - идентификатор операции, которую необходимо отменить.
//  
// Возвращаемое значение:
//  см. ПлатежныеСистемы.ОтменитьДинамическуюСсылку
//
Функция ОтменитьДинамическуюСсылку(НастройкаПодключения, ИдентификаторОперации) Экспорт
	
	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	// Подготовка данных для отправки на портал
	
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	ТекстОшибки = НСтр("ru = 'Не удалось отменить платежную ссылку.'");
	ТекстЛога = НСтр("ru = 'Получен ответ от сервиса'");
	
	ДекодироватьИдентификатор = ЯндексПэйСлужебный.ДекодироватьИдентификаторОплаты(
		ИдентификаторОперации,
		ТекстОшибки,
		ЯндексПэйСлужебный.ТипСсылкиДинамическая());
		
	Если Не ПустаяСтрока(ДекодироватьИдентификатор.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ДекодироватьИдентификатор, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыОперации = ПараметрыЗапросаОтменыДинамическойСсылки(
		ДанныеАутентификации,
		ДекодироватьИдентификатор.ИдентификаторОплаты);

	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	
	Если Эталон.КодОтвета <> 1 Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Не удалось отменить платежную ссылку.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СтатусыОпераций

// Выполняет запрос получения информации о статусе операции в сервисе платежной системы Яндекс Пэй.
// Если АктуальнаяКорзина = Истина, то в параметр Корзина заносится таблица значений с актуальной корзиной.
// Если АктуальнаяКорзина = Неопределено, то в параметр Корзина устанавливается значение Неопределено.
//
// Параметры:
//  ПараметрыСтатуса - см. ПлатежныеСистемы.ДанныеОперации.
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройка подключения к сервису.
//  АктуальнаяКорзина - Булево - признак необходимости возврата актуальной корзины. Значение по умолчанию - Ложь,
//    поскольку результат метода может возвращаться на клиент.
//
// Возвращаемое значение:
//  Структура:
//    * КодОшибки - Строка - строковый код возникшей ошибки.
//        Возможные значения см. НастройкиПлатежныхСистемСлужебный.ПереопределитьКодОшибкиСервиса
//    * СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//    * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//    * СтатусОперации - Строка - текущее состояние операции в платежной системе.
//        Возможные значения:
//          см. НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииВыполняется - подтверждение операции не получено.
//          см. НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииВыполнена - платежная система подтвердила операцию.
//          см. НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииОтменена - операция не может быть выполнена.
//          см. НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииОшибка - не удалось получить статус операции из-за
//            ошибки.
//    * ПараметрыОперации - Структура - дополнительные данные по операции:
//        ** ИдентификаторОперации - Строка - идентификатор операции в платежной системе.
//            Для оплаты - sale_token. Для возвратов статус операции не проверяется.
//        ** ИдентификаторОплаты -Строка - идентификатор заказа на оплату в платежной системе.
//            Для оплаты - пусто.
//        ** ТипОперации - Строка - тип выполненной операции в платежной системе.
//             Возможные значения:
//               см. ПлатежныеСистемыКлиентСервер.ТипОперацииОплата - операция оплаты.
//               см. ПлатежныеСистемыКлиентСервер.ТипОперацииВозврат - операция возврата оплаты.
//        ** ДатаОперации - Дата - фактическая дата операции в UTC.
//        ** СуммаОперации - Число - фактическая суммы операции по документу.
//        ** Корзина - см. ЯндексПэй.НовыйАктуальнаяКорзина.
//                   - Неопределено - если АктуальнаяКорзина = Ложь.
//    * ОбновитьДатуЗапросаСтатуса - Булево - Истина, если необходимо обновить дату запроса статуса в базе данных.
//
Функция СтатусОперации(
		ПараметрыСтатуса,
		НастройкаПодключения,
		АктуальнаяКорзина = Ложь) Экспорт
	
	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатСтатусОперацииСлужебный();
	
	Если АктуальнаяКорзина Тогда
		Результат.ПараметрыОперации.Вставить(
			"Корзина",
			ЯндексПэй.НовыйАктуальнаяКорзина());
	Иначе
		Результат.ПараметрыОперации.Вставить(
			"Корзина",
			Неопределено);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(
		Результат.ПараметрыОперации,
		ПараметрыСтатуса,
		"ИдентификаторОперации, ИдентификаторОплаты, ТипОперации, СуммаОперации");
	
	СписокСвойствОшибки = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	ТекстОшибки = НСтр("ru = 'Не удалось получить данные операции.'");
	ДекодироватьИдентификатор = ЯндексПэйСлужебный.ДекодироватьИдентификаторОплаты(
		ПараметрыСтатуса.ИдентификаторОперации,
		ТекстОшибки);
		
	Если Не ПустаяСтрока(ДекодироватьИдентификатор.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ДекодироватьИдентификатор, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
		НСтр("ru = 'Получение данных операции Яндекс Пэй'"));
	
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	// Необходимо обновить дату запроса статуса в базе данных
	Результат.ОбновитьДатуЗапросаСтатуса = Истина;
	
	// Подготовка данных для отправки на портал
	ПараметрыОперации = ПараметрыЗапросаСтатусОперации(
		ДекодироватьИдентификатор.ТипОперации,
		ДекодироватьИдентификатор.ИдентификаторОплаты,
		ДанныеАутентификации);
	
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Не удалось получить данные операции.
			|Настройка подключения: %1 (ID:%2)'"),
		Строка(НастройкаПодключения),
		Строка(НастройкаПодключения.УникальныйИдентификатор()));
	ТекстЛога = НСтр("ru = 'Получен ответ от сервиса'");
	
	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
		
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;

	ОбработкаОтветаСтатусОперации(
		Результат,
		РезультатЗапроса.ДанныеОтвета,
		РезультатЧтения,
		ТекстОшибки,
		ДекодироватьИдентификатор.ТипОперации,
		АктуальнаяКорзина);

	ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
		НСтр("ru = 'Получение данных операции Яндекс Пэй завершено'"));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Возвраты

// Создает запрос на частичный/полный возврат по ранее созданному заказу на оплату.
// 
// Параметры:
//  ДанныеЗаказа - см. ЯндексПэйСлужебный.ДанныеЗаказаНаВозврат.
//    информационной базе.
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройка подключения к сервису.
//  ПараметрыПлатежнойСистемы - Неопределено - без дополнительных параметров.
//                            - см. НовыйПараметрыВозвратовПлатежныхСистем.
//
// Возвращаемое значение:
//  Структура - результат выполнения операции возврата:
//    * КодОшибки - Строка - строковый код возникшей ошибки.
//    * СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//    * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//    * СтатусОперации - Строка - текущее состояние операции в платежной системе.
//    * ПараметрыОперации - см. ПлатежныеСистемыСлужебный.НовыйПараметрыОперации.
//
Функция ВозвратОплаты(
		ДанныеЗаказа,
		НастройкаПодключения) Экспорт

	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатСтатусОперации();
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	ДанныеАутентификации = ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения);
	
	ТекстОшибки = НСтр("ru = 'Не удалось выполнить возврат.'");
	ТекстЛога   = НСтр("ru = 'Получен ответ от сервиса'");
	
	ДекодироватьИдентификатор = ЯндексПэйСлужебный.ДекодироватьИдентификаторОплаты(
		ДанныеЗаказа.ИдентификаторОплаты,
		ТекстОшибки);
	
	Если Не ПустаяСтрока(ДекодироватьИдентификатор.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ДекодироватьИдентификатор, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыОперации = ПараметрыЗапросаВозвратОплаты(
		ДанныеАутентификации,
		ДанныеЗаказа,
		ДекодироватьИдентификатор);

	РезультатЗапроса = ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса(
		ИдентификаторПлатежнойСистемы(),
		КореньАдресаИнтеграции(),
		ПараметрыОперации,
		ТекстОшибки,
		ТекстЛога);
	
	РезультатЧтения = ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ТекстОшибки,
		Тип("Соответствие"));
	
	Если Не ПустаяСтрока(РезультатЧтения.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЧтения, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	
	Если Эталон.КодОтвета = 1 Тогда
		
		
		Результат.СтатусОперации = НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииВыполнена();
		
		Результат.ПараметрыОперации.ИдентификаторОперации = ДанныеЗаказа.Идентификатор;
		Результат.ПараметрыОперации.ИдентификаторОплаты = ДанныеЗаказа.ИдентификаторОплаты;
		Результат.ПараметрыОперации.ДатаОперации = Дата(1, 1, 1);
		Результат.ПараметрыОперации.СуммаОперации = ДанныеЗаказа.ЗаказНаВозврат.СуммаВозврата;
		Результат.ПараметрыОперации.ТипОперации = ПлатежныеСистемыКлиентСервер.ТипОперацииВозврат();
		
	ИначеЕсли (Эталон.ТипРезультата = "error") Или (Эталон.КодОтвета = 0) Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Не удалось получить платежную ссылку.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	Иначе
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул недекларированное значение.
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %2'"),
			ТекстОшибки,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Аутентификация

// Формирует данные аутентификации в платежной системе.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам - настройки подключения к сервису.
//
// Возвращаемое значение:
//  Неопределено, Произвольный - данные аутентификации. Неопределено, если данные не найдены.
//
Функция ПараметрыАутентификацииПлатежнойСистемы(НастройкаПодключения)
	
	ДанныеАутентификации = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеХранилища = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(НастройкаПодключения);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТипЗнч(ДанныеХранилища) = Тип("Структура") Тогда
		
		ДанныеАутентификации = ДанныеХранилища;
		ДанныеАутентификации.Удалить("Служебный_ДанныеТокенов");
		
	КонецЕсли;
	
	Возврат ДанныеАутентификации;
	
КонецФункции

#КонецОбласти

#Область ОбщиеМетоды

// Анализирует результата запроса к сервису на предмет ошибок запроса и ошибок в ответе от банка.
//  В случае успешного выполнения преобразует полученные данные из JSON и помещает его в 
//  свойство РезультатЧтения, если полученный тип данных совпадает с указанным в параметре ТипРезультата.
// 
// Параметры:
//  РезультатЗапроса - Структура - Результат запроса к сервису:
//    * КодОшибки - Строка - строковый код возникшей ошибки.
//        Возможные значения см. НастройкиПлатежныхСистемСлужебный.ПереопределитьКодОшибкиСервиса
//    * СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//    * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//  ПредставлениеОшибкиДляЖурнала - Строка - первая строка сообщения об ошибке, которое будет записано
//    в журнал регистрации.
//  ТипРезультата - Тип - ожидаемый тип результата после преобразования полученного сообщения из JSON.
// 
// Возвращаемое значение:
//  Структура - результат обработки:
//   * КодОшибки - Строка - строковый код возникшей ошибки.
//       Возможные значения см. НастройкиПлатежныхСистемСлужебный.ПереопределитьКодОшибкиСервиса
//   * СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//   * ИнформацияОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для администратора.
//   * РезультатЧтения - Неопределено, Произвольный - результат преобразования ответа из JSON, если
//       его тип соответствует ожидаемому.
// 
Функция ПрочитатьРезультатЗапроса(
		РезультатЗапроса,
		ПредставлениеОшибкиДляЖурнала,
		ТипРезультата)
	
	Результат = ПлатежныеСистемыСлужебный.НовыйРезультатОперации();
	Результат.Вставить("РезультатЧтения", Неопределено);
	
	СписокСвойствОшибки  = "КодОшибки,СообщениеОбОшибке,ИнформацияОбОшибке";
	
	Если Не ПустаяСтрока(РезультатЗапроса.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, РезультатЗапроса, СписокСвойствОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ШаблонОшибки = НСтр("ru = '%1
					|
					|Не удалось прочитать ответ сервиса. Формат не соответствует ожидаемому.
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %2
					|ТекстОшибки:
					|%3'");
					
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		
		Если РезультатЗапроса.ДанныеОтвета = Неопределено Тогда
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонОшибки,
				ПредставлениеОшибкиДляЖурнала,
				РезультатЗапроса.ДанныеОтвета,
				 НСтр("ru = 'Сервис вернул пустой ответ.'"));
			
			ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
				ИнформацияОбОшибке,
				Истина);
		
			Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
			Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
			Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
			
			Возврат Результат;
			
		Иначе
			
			ТипОтвета = ТипЗнч(РезультатЗапроса.ДанныеОтвета);
			
			Если ТипОтвета = ТипРезультата Тогда
				// Успешный ответ
				Результат.РезультатЧтения = РезультатЗапроса.ДанныеОтвета;
				Возврат Результат;
				
			Иначе
				
				ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонОшибки,
					ПредставлениеОшибкиДляЖурнала,
					ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета),
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Тип данных в ответе сервиса не соответствует ожидаемому:
						|Ожидали - %1
						|В ответе - %2'"),
						ТипРезультата,
						ТипОтвета));
				
				ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
					ИнформацияОбОшибке,
					Истина);
			
				Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
				Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
				Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
				
				Возврат Результат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
				|
				|Сервис платежной системы вернул ошибку.
				|
				|Техническая информация об ошибке:
				|Платежная система: Яндекс Пэй
				|Код состояния: %2
				|Ответ сервиса:
				|%3'"),
			ПредставлениеОшибкиДляЖурнала,
			РезультатЗапроса.КодСостояния,
			ДанныеОтветаДляЖурнала(РезультатЗапроса.ДанныеОтвета));
	
		Результат.КодОшибки = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке = НСтр("ru = 'Неизвестная ошибка при подключении к сервису.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
	
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(ИнформацияОбОшибке, Истина);
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразовывает сообщение об ошибке, полученное от банка в понятный пользователю вид.
// 
// Параметры:
//  ОтветСервиса - Структура - ответ сервиса с ошибкой. Должен содержать следующие поля:
//    * ТипРезультата - Строка - тип результата операции. Допустимые значения "success" и "error".
//    * КодОтвета - Число - код ответа. Допустимые значения: 1 - успех, 0 - неуспех.
//    * КодОшибки - Число - код ошибки.
//    * Ошибка - Строка - текстовое описание ошибки.
// 
// Возвращаемое значение:
//  Строка - представление ошибки для пользователя.
// 
Функция ПреобразоватьОписаниеОшибки(ОтветСервиса)
	
	Если ОтветСервиса.КодОшибки = 100 Тогда
		ДополнениеОшибки = НСтр("ru = 'Не работает сервис или банк эквайер'");
	ИначеЕсли ОтветСервиса.КодОшибки = 101 Тогда
		ДополнениеОшибки = НСтр("ru = 'Операция не найдена'");
	ИначеЕсли ОтветСервиса.КодОшибки = 103 Тогда
		ДополнениеОшибки = НСтр("ru = 'В данный момент по этой операции производится возврат денежных средств'");
	ИначеЕсли ОтветСервиса.КодОшибки = 105 Тогда
		ДополнениеОшибки = НСтр("ru = 'Сумма всех возвратов или текущего возврата превышает сумму исходной операции'");
	ИначеЕсли ОтветСервиса.КодОшибки = 106 Тогда
		ДополнениеОшибки = НСтр("ru = 'Невозможно отменить операцию. Операция успешно оплачена'");
	ИначеЕсли ОтветСервиса.КодОшибки = 403 Тогда
		ДополнениеОшибки = НСтр("ru = 'Отсутствуют обязательные поля в запросе'");
	ИначеЕсли ОтветСервиса.КодОшибки = 404 Тогда
		ДополнениеОшибки = НСтр("ru = 'Функционал отключен'");
	ИначеЕсли ОтветСервиса.КодОшибки = 411 Тогда
		ДополнениеОшибки = НСтр("ru = 'Идентификатор QR-кода не найден'");
	ИначеЕсли ОтветСервиса.КодОшибки = 420 Тогда
		ДополнениеОшибки = НСтр("ru = 'Пользователь не подключен к облачной кассе'");
	ИначеЕсли ОтветСервиса.КодОшибки = 450 Тогда
		ДополнениеОшибки = НСтр("ru = 'Уже существует активный user_token для этого терминала'");
	ИначеЕсли ОтветСервиса.КодОшибки = 451 Тогда
		ДополнениеОшибки = НСтр("ru = 'Некорректный формат terminal_id'");
	ИначеЕсли ОтветСервиса.КодОшибки = 452 Тогда
		ДополнениеОшибки = НСтр("ru = 'Терминал не найден в системе'");
	ИначеЕсли ОтветСервиса.КодОшибки = 453 Тогда
		ДополнениеОшибки = НСтр("ru = 'Невалидный или уже использованный request_token'");
	ИначеЕсли ОтветСервиса.КодОшибки = 454 Тогда
		ДополнениеОшибки = НСтр("ru = 'request_token истек (TTL 5 минут)'");
	ИначеЕсли ОтветСервиса.КодОшибки = 455 Тогда
		ДополнениеОшибки = НСтр("ru = 'terminal_id не совпадает с request_token'");
	ИначеЕсли ОтветСервиса.КодОшибки = 456 Тогда
		ДополнениеОшибки = НСтр("ru = 'Активный user_token не найден для терминала'");
	ИначеЕсли ОтветСервиса.КодОшибки = 457 Тогда
		ДополнениеОшибки = НСтр("ru = 'Токен заблокирован'");
	ИначеЕсли ОтветСервиса.КодОшибки = 458 Тогда
		ДополнениеОшибки = НСтр("ru = 'Требуется обновление токена'");
	Иначе
		ДополнениеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неизвестная ошибка. Код ошибки: %2'"),
			ОтветСервиса.КодОшибки);
	КонецЕсли;
	
	Если ОтветСервиса.Ошибка = ДополнениеОшибки Тогда
		Возврат ДополнениеОшибки;
	КонецЕсли;
	
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1:
		|%2'"),
		ОтветСервиса.Ошибка,
		ДополнениеОшибки);
	
	Возврат Результат;

КонецФункции

// Преобразует данные ответа, полученные из метода ПлатежныеСистемыСервис.ВыполнитьОперациюСервиса
// в строку, для сохранения в журнал регистрации.
// 
// Параметры:
//  ДанныеОтвета - Произвольный - данные ответа сервиса.
// 
// Возвращаемое значение:
//  Строка - в зависимости от исходного типа значения в ДанныеОтвета могут
//  быть возвращены следующие значения:
//    Тип Строка возвращается без изменений.
//    Если ДанныеОтвета = Неопределено - возвращается строка "Неопределено".
//    Для другие типов данных выполняется попытка преобразовать в строку JSON, которая
//    возвращается в случае успеха.
//    Если при преобразовании в JSON возникла ошибка, то исходное значение преобразуется
//    к строке с использованием стандартного метода Строка(ДанныеОтвета)
// 
Функция ДанныеОтветаДляЖурнала(ДанныеОтвета)
	
	Если ДанныеОтвета = Неопределено Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗнч(ДанныеОтвета) = Тип("Строка") Тогда
		Возврат ДанныеОтвета;
	Иначе
		
		Попытка
			ДанныеВСтроку = ОбщегоНазначения.ЗначениеВJSON(ДанныеОтвета);
			Возврат ДанныеВСтроку;
		Исключение
			Возврат Строка(ДанныеОтвета);
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции

// Параметры запроса активация кассовой ссылки.
// 
// Параметры:
//  ТипСсылки - Строка - тип ссылки на оплату.
//              Допустимые значения определяются методами
//              ЯндексПэйСлужебный.ТипСсылкиКассовая и ЯндексПэйСлужебный.ТипСсылкиДинамическая.
//  ДанныеАутентификации - см. ПараметрыАутентификацииПлатежнойСистемы.
//  ДанныеЗаказа - см. ЯндексПэйСлужебный.НовыйЗаказНаОплату.
//  КлючСсылки - Строка - Ключ кассовой ссылки, которую необходимо активировать.
//                      Игнорируется для динамических ссылок.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST
//
Функция ПараметрыЗапросаЗаказНаОплату(
		ТипСсылки,
		ДанныеАутентификации,
		ДанныеЗаказа,
		КлючСсылки = "")
	
	// Пример для кассовой ссылки
	// {
	//  "cart": {
	//    "items": [
	//      {
	//        "productId": "1234567890",
	//        "quantity": {
	//          "count": 123.456
	//        },
	//        "title": "Хлеб",
	//        "cost": 22.11,
	//        "description": "string",
	//        "unit_price": 0
	//      }
	//    ]
	//  },
	//  "key": "BS1F004M90XXXXXXXXXXYYYYZZZZZZZZ",
	//  "cost": 22.11,
	//  "answer_version": "1",
	//  "answer_url": "",
	//  "duration": 600,
	//  "client_transaction": "0197e8fc-c711-786c-8a5c-6da26b3f29bf",
	//  "comment": "Вы наш тысячный покупатель, ура!",
	//  "staff": [
	//    {
	//      "name": "Иван Васильевич",
	//      "phone": "79998887766"
	//    }
	//  ]
	// }
	
	// Пример для динамической ссылки
	// {
	//   "cart": {
	//     "items": [
	//       {
	//         "productId": "1234567890",
	//         "quantity": {
	//           "count": 123.456
	//         },
	//         "title": "Хлеб",
	//         "cost": 22.11,
	//         "description": "string",
	//         "unit_price": 0
	//       }
	//     ]
	//   },
	//   "cost": 22.12,
	//   "client_transaction": "0197e8fc-c711-786c-8a5c-6da26b3f29bf",
	//   "duration": 600,
	//   "answer_url": "",
	//   "answer_version": "1",
	//   "redirect_url": "http://some-cool-shop.test.ru",
	//   "comment": "Вы наш тысячный покупатель, ура!",
	//   "additionalData": {
	//     "tid": "string"
	//   }
	// }
	
	Адрес = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"/%1/operation/create",
		?(ТипСсылки = ЯндексПэйСлужебный.ТипСсылкиКассовая(), "s1", "so"));
	
	Товары = Новый Массив;
	Для Каждого Товар Из ДанныеЗаказа.ЗаказНаОплату.Корзина Цикл
		
		ОписаниеТовара = Новый Структура;
		
		ОписаниеТовара.Вставить("productId", Товар.ИдентификаторНоменклатуры);
		ОписаниеТовара.Вставить("quantity",
			Новый Структура(
				"count",
				Товар.Количество));
		ОписаниеТовара.Вставить("title", Товар.ПредставлениеНоменклатуры);
		ОписаниеТовара.Вставить("description", Товар.Описание);
		ОписаниеТовара.Вставить("cost", Товар.Сумма);
		ОписаниеТовара.Вставить("unit_price", Товар.Цена);
		
		Товары.Добавить(ОписаниеТовара);
		
	КонецЦикла;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("cart",
		Новый Структура(
			"items",
			Товары));
	ДанныеЗапроса.Вставить("cost", ДанныеЗаказа.ЗаказНаОплату.Сумма);
	ДанныеЗапроса.Вставить("client_transaction", ДанныеЗаказа.Идентификатор);
	ДанныеЗапроса.Вставить("comment", ДанныеЗаказа.ЗаказНаОплату.Комментарий);
	ДанныеЗапроса.Вставить("duration", ДанныеЗаказа.ЗаказНаОплату.ВремяДействияСсылки);
	ДанныеЗапроса.Вставить("answer_version", "2");
	ДанныеЗапроса.Вставить("answer_url", "");
	
	Если ТипСсылки = ЯндексПэйСлужебный.ТипСсылкиКассовая() Тогда // Активация кассовой ссылки
		ДанныеЗапроса.Вставить("key", КлючСсылки);
	Иначе // получение динамической ссылки
		ДанныеЗапроса.Вставить("redirect_url", "");
	КонецЕсли;
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST(Адрес, ДанныеЗапроса);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

#КонецОбласти

#Область СтатусОперации

// Подготавливает параметры запроса статуса операции
// 
// Параметры:
//  ТипСсылки - Строка - тип ссылки на оплату.
//              Допустимые значения определяются методами
//              ЯндексПэйСлужебный.ТипСсылкиКассовая и ЯндексПэйСлужебный.ТипСсылкиДинамическая.
//  ИдентификаторОперации - Строка - внутренний идентификатор операции;
//  ДанныеАутентификации - Структура - данные аутентификации.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаGET
//  
Функция ПараметрыЗапросаСтатусОперации(ТипСсылки, ИдентификаторОперации, ДанныеАутентификации)
	
	Адрес = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"/%1/operation/result",
		?(ТипСсылки = ЯндексПэйСлужебный.ТипСсылкиКассовая(), "s1", "so"));
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаGET(Адрес);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	ПараметрЗапроса = Новый Массив;
	ПараметрЗапроса.Добавить(ИдентификаторОперации);
	
	ПараметрыЗапроса.queryParams.Вставить("sale_token", ПараметрЗапроса);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Обрабатывает ответ сервиса на запрос статуса операции.
// 
// Параметры:
//  Результат - см. СтатусОперации
//  ДанныеОтвета - Строка - ответ сервиса.
//  РезультатЧтения - Соответствие Из КлючИЗначение - результат преобразования ответа сервиса из JSON.
//  ТекстОшибки - Строка - текст ошибки для журнала регистрации.
//  ТипОперации - Строка - тип выполняемой операции - Кассовая или Динамическая ссылка.
//  АктуальнаяКорзина - Булево - признак необходимости заполнения актуальной корзины.
//  
Процедура ОбработкаОтветаСтатусОперации(
		Результат,
		ДанныеОтвета,
		РезультатЧтения,
		ТекстОшибки,
		ТипОперации,
		АктуальнаяКорзина)
	
	Эталон = Новый Структура;
	Эталон.Вставить("ТипРезультата", РезультатЧтения.РезультатЧтения.Получить("data_type")); // success, error
	Эталон.Вставить("КодОтвета", РезультатЧтения.РезультатЧтения.Получить("code")); // 1 - успех, 0 - неуспех
	Эталон.Вставить("КодОшибки", РезультатЧтения.РезультатЧтения.Получить("codeError"));
	Эталон.Вставить("Ошибка", РезультатЧтения.РезультатЧтения.Получить("error"));
	
	Эталон.Вставить("Статус", РезультатЧтения.РезультатЧтения.Получить("status")); // 0 - неизвестен, 1 - известен
	Эталон.Вставить("Результат", РезультатЧтения.РезультатЧтения.Получить("result")); // Истина или Ложь в зависимости от статуса операции
	Эталон.Вставить("Корзина", РезультатЧтения.РезультатЧтения.Получить("cart"));
	Эталон.Вставить("ИдентификаторОперации", РезультатЧтения.РезультатЧтения.Получить("sale_token"));
	Эталон.Вставить("СуммаОперации", РезультатЧтения.РезультатЧтения.Получить("cost")); // Есть только у динамических ссылок
	
	Если Эталон.КодОтвета = 1 Тогда
		
		Если Эталон.Статус = 0 Тогда
			Результат.СтатусОперации = НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииВыполняется();
		ИначеЕсли Эталон.Статус = 1 Тогда
			
			Если Эталон.Результат = Истина Тогда // может быть неопределено, поэтому проверка через = Истина
				
				// АПИ яндекса не возвращает идентификатор транзакции операции оплаты,
				// поэтому sale_token устанавливается в качестве идентификатора оплаты и операции.
				
				ЗакодированныйИдентификатор = ЯндексПэйСлужебный.КодироватьИдентификаторОплаты(
					Эталон.ИдентификаторОперации,
					ТипОперации);
				
				Результат.СтатусОперации = НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииВыполнена();
				Результат.ПараметрыОперации.ДатаОперации = ТекущаяДатаСеанса();
				Результат.ПараметрыОперации.ИдентификаторОперации = ЗакодированныйИдентификатор;
				Результат.ПараметрыОперации.ИдентификаторОплаты = ЗакодированныйИдентификатор;
				Результат.ПараметрыОперации.ТипОперации = ПлатежныеСистемыКлиентСервер.ТипОперацииОплата();
				
				Если Эталон.СуммаОперации <> Неопределено Тогда
					Результат.ПараметрыОперации.СуммаОперации = Эталон.СуммаОперации;
				КонецЕсли;
				
			Иначе
				
				Результат.СтатусОперации = НастройкиПлатежныхСистемКлиентСервер.СтатусОперацииОтменена();
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если АктуальнаяКорзина Тогда
			ЗаполнитьАктуальнуюКорзину(
				Результат.ПараметрыОперации.Корзина,
				Эталон.Корзина);
		КонецЕсли;
		
	ИначеЕсли Эталон.ТипРезультата = "error" Или Эталон.КодОтвета = 0 Тогда
		
		ПредставлениеОшибки = ПреобразоватьОписаниеОшибки(Эталон);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул ошибку: %2
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %3'"),
			ТекстОшибки,
			ПредставлениеОшибки,
			ДанныеОтвета);
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Не удалось получить статус операции.'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	Иначе
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
					|
					|Сервис вернул недекларированное значение.
					|
					|Техническая информация об ошибке:
					|Платежная система: Яндекс Пэй
					|Ответ сервиса: %2'"),
			ТекстОшибки,
			ДанныеОтвета);
		
		ПлатежныеСистемыСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Истина);
	
		Результат.КодОшибки          = НастройкиПлатежныхСистемСлужебный.КодОшибкиНеизвестнаяОшибка();
		Результат.СообщениеОбОшибке  = НСтр("ru = 'Ошибка при разборе ответа от сервиса'");
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет заполнение информации об актуальном составе корзины на основе данных, полученных из сервиса.
// 
// Параметры:
//  Корзина - см. ЯндексПэй.НовыйАктуальнаяКорзина
//  ДанныеСервиса - Неопределено, Соответствие Из КлючИЗначение - данные о корзине, полученные из сервиса.
// 
Процедура ЗаполнитьАктуальнуюКорзину(Корзина, ДанныеСервиса)
	
	Если ТипЗнч(ДанныеСервиса) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Состав = ДанныеСервиса.Получить("items");
	Если ТипЗнч(Состав) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Товар Из Состав Цикл
		
		Если ТипЗнч(Товар) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Корзина.Добавить();
		НоваяСтрока.ИдентификаторНоменклатуры = Товар.Получить("productId");
		НоваяСтрока.ПредставлениеНоменклатуры = Товар.Получить("title");
		НоваяСтрока.Описание = Товар.Получить("description");
		НоваяСтрока.Сумма = Товар.Получить("cost");
		
		КоличествоСервис = Товар.Получить("quantity");
		Количество = 0;
		Если ТипЗнч(КоличествоСервис) = Тип("Соответствие") Тогда
			Количество = КоличествоСервис.Получить("count");
		КонецЕсли;
		
		НоваяСтрока.Количество = Количество;

	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область КассовыеСсылки

// Подготавливает параметры запроса списка кассовых ссылок
// 
// Параметры:
//  ДанныеАутентификации - Структура - данные аутентификации.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаGET
//  
Функция ПараметрыЗапросаКассовыеСсылки(ДанныеАутентификации)
	
	Адрес = "/s1/accounts";
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаGET(Адрес);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Параметры запроса деактивация кассовой ссылки.
// 
// Параметры:
//  ДанныеАутентификации - см. ПараметрыАутентификацииПлатежнойСистемы.
//  ПараметрыКассовойСсылки - Структура - параметры ссылки, которую нужно активировать:
//    * КлючСсылки - Строка - ключ кассовой ссылки.
//    * ИдентификаторОперации - Строка - идентификатор заказа на оплату.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST
//
Функция ПараметрыЗапросаДеактивацияКассовойСсылки(
		ДанныеАутентификации,
		ПараметрыКассовойСсылки)
	
	// {
	//   "key": "BS1F004M90XXXXXXXXXXYYYYZZZZZZZZ"
	// }
	
	Адрес = "/s1/operation/cancel";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("key", ПараметрыКассовойСсылки.КлючСсылки);
	// в API Яндекса нет sale_token, но он нужен для сервиса.
	ДанныеЗапроса.Вставить("sale_token", ПараметрыКассовойСсылки.ИдентификаторОперации);
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST(Адрес, ДанныеЗапроса);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

#КонецОбласти

#Область ДинамическиеСсылки

// Параметры запроса отмена динамической ссылки.
// 
// Параметры:
//  ДанныеАутентификации - см. ПараметрыАутентификацииПлатежнойСистемы.
//  ИдентификаторОперации - Строка - идентификатор платежной ссылки, которую нужно отменить.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST
//
Функция ПараметрыЗапросаОтменыДинамическойСсылки(
		ДанныеАутентификации,
		ИдентификаторОперации)
	
	// {
	//  "sale_token": "000000000000.0:00:0000.XxxXX"
	// }
	Адрес = "/so/operation/cancel";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("sale_token", ИдентификаторОперации);
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST(Адрес, ДанныеЗапроса);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

#КонецОбласти

#Область Возвраты

// Параметры запроса активация кассовой ссылки.
// 
// Параметры:
//  ДанныеАутентификации - см. ПараметрыАутентификацииПлатежнойСистемы.
//  ДанныеЗаказа - см. ЯндексПэйСлужебный.НовыйЗаказНаВозврат.
//  РезультатДекодирования - см. ЯндексПэйСлужебный.ДекодироватьИдентификаторОплаты.
// 
// Возвращаемое значение:
//  см. ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST
//
Функция ПараметрыЗапросаВозвратОплаты(
		ДанныеАутентификации,
		ДанныеЗаказа,
		РезультатДекодирования)
	
	// {
	//  "refundId": "dec1eaa3-8609-4446-909b-f058a9e84a4a",
	//  "sale_token": "000000000000.0:00:0000.XxxXX",
	//  "cost": 2.19,
	//  "cart": {
	//    "items": [
	//      {
	//        "productId": "1234567890",
	//        "quantity": {
	//          "count": 123.456
	//        },
	//        "itemPrice": 123.45,
	//        "total": 0
	//      }
	//    ]
	//  }
	//}
	
	ОплатаПоКассовойСсылке = (РезультатДекодирования.ТипОперации = ЯндексПэйСлужебный.ТипСсылкиКассовая());
	
	Адрес = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"/%1/operation/return",
		?(ОплатаПоКассовойСсылке, "s1", "so"));
	
	Товары = Новый Массив;
	Для Каждого Товар Из ДанныеЗаказа.ЗаказНаВозврат.Корзина Цикл
		
		ОписаниеТовара = Новый Структура;
		
		ОписаниеТовара.Вставить("productId", Товар.ИдентификаторНоменклатуры);
		ОписаниеТовара.Вставить("quantity", 
			Новый Структура(
				"count",
				Товар.Количество));
		ОписаниеТовара.Вставить("itemPrice", Товар.Цена);
		ОписаниеТовара.Вставить("total", Товар.Сумма);
		
		Товары.Добавить(ОписаниеТовара);
		
	КонецЦикла;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("refundId", ДанныеЗаказа.Идентификатор);
	ДанныеЗапроса.Вставить("sale_token", РезультатДекодирования.ИдентификаторОплаты);
	ДанныеЗапроса.Вставить("cost", ДанныеЗаказа.ЗаказНаВозврат.СуммаВозврата);
	
	Если Товары.Количество() > 0 Тогда
		ДанныеЗапроса.Вставить("cart",
			Новый Структура(
				"items",
				Товары));
	КонецЕсли;
	
	ПараметрыЗапроса = ПлатежныеСистемыСервис.НовыйПараметрыОперацииСервисаPOST(Адрес, ДанныеЗапроса);
	ПараметрыЗапроса.requestHeaders.Вставить("User-Token", ДанныеАутентификации.Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

#КонецОбласти

#КонецОбласти