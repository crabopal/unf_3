#Область ПрограммныйИнтерфейс

// Создаёт структуру параметров операции для дисплея покупателя.
//
// Параметры:
//  СтрокиТекста - Строка - текст для отображения на дисплее без HTML.
//  ЗначениеQRКода - Строка, Неопределено - значение QR-кода для отображения.
//
// Возвращаемое значение:
//  Структура:
//   * СтрокиТекста - Строка - текст для вывода на дисплей.
//   * ЗначениеQRКода - Строка, Неопределено - значение QR-кода.
//   * СтатусОперации - ПеречислениеСсылка.СтатусОперацииНаДисплее, Неопределено - статус операции.
//   * СтатусРабочегоМеста - ПеречислениеСсылка.СтатусРабочегоМестаНаДисплее, Неопределено - статус рабочего места.
//   * ЗвуковойСигнал - Булево - признак воспроизведения звукового сигнала.
//   * ТекстHTML - Строка - HTML-разметка для отображения.
//   * НазваниеОрганизации - Строка - название организации.
//   * Операция - Строка - наименование выполняемой операции.
//   * ТипПлатежнойСистемы - Произвольный, Неопределено - значение, используемое для текста платёжной системы.
//   * ГотовностьКРаботе - Булево - признак готовности кассы к работе.
//   * НаличнаяОплата - Булево - признак наличной оплаты.
//   * ДополнительныйТекст - Строка - дополнительный текст.
//   * Сумма - Число - сумма операции.
//   * Сдача - Число - сумма сдачи.
//   * Возврат - Булево - признак операции возврата.
//   * ВнутренняяОперация - Булево - признак внутренней операции БПО.
//   * КолонкиТабличнойЧасти - Массив Из Структура - описание колонок табличной части.
//   * ТабличнаяЧасть - Массив - строки табличной части.
//   * ПодвалСумма - Число - сумма в подвале табличной части.
//   * ПодвалСкидка - Число - скидка в подвале табличной части.
//   * Корзина - Массив Из Структура - элементы корзины, см. СтрокаКорзиныДисплеяПокупателя.
//   * ЗаголовокПроизвольнойКолонки - Строка - заголовок произвольной колонки корзины.
//   * Кнопки - Массив Из Структура - параметры кнопок, см. КнопкаДисплеяПокупателя.
//   * Ширина - Число, Неопределено - ширина дисплея в пикселях.
//   * Высота - Число, Неопределено - высота дисплея в пикселях.
//   * КартинкаBase64 - Строка - изображение в кодировке Base64.
//   * Картинка - Произвольный, Неопределено - данные изображения для страницы картинки.
//   * МедиаФайлы - Массив Из Структура - список медиафайлов, см. НовыйМедиаФайл.
//   * КешироватьМедиаФайлы - Булево - признак кеширования медиафайлов на стороне драйвера.
//   * КартинкаQRКода - Неопределено - устаревший реквизит, сохранён для совместимости.
//
Функция ПараметрыОперацииДисплейПокупателя(СтрокиТекста = "", ЗначениеQRКода = Неопределено) Экспорт
	
	Результат = Новый Структура();
	// простой дисплей
	Результат.Вставить("СтрокиТекста", СтрокиТекста);
	Результат.Вставить("ЗначениеQRКода", ЗначениеQRКода);
	Результат.Вставить("СтатусОперации");
	Результат.Вставить("СтатусРабочегоМеста");
	Результат.Вставить("ЗвуковойСигнал", Ложь);
	
	Результат.Вставить("ТекстHTML", "");
	
	// Информация для дисплея покупателя
	Результат.Вставить("НазваниеОрганизации", "");
	Результат.Вставить("Операция", "");
	Результат.Вставить("ТипПлатежнойСистемы");
	Результат.Вставить("ГотовностьКРаботе", Ложь);
	Результат.Вставить("НаличнаяОплата", Ложь);
	Результат.Вставить("ДополнительныйТекст", "");
	Результат.Вставить("ВыводитьQRКодДляАлкоголя", Ложь);
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("Сдача", 0);
	Результат.Вставить("Возврат", Ложь);
	Результат.Вставить("ВнутренняяОперация", Ложь);
	
	// Страница список товаров
	Результат.Вставить("КолонкиТабличнойЧасти", Новый Массив());
	Результат.Вставить("ТабличнаяЧасть", Новый Массив());
	Результат.Вставить("ПодвалСумма", 0);
	Результат.Вставить("ПодвалСкидка", 0);
	
	// Страница корзина
	Результат.Вставить("Корзина", Новый Массив());
	Результат.Вставить("ЗаголовокПроизвольнойКолонки", "");
	
	Результат.Вставить("Кнопки", Новый Массив());

	Результат.Вставить("Ширина", Неопределено);  // Число - ширина дисплея в пикселях (опционально)
	Результат.Вставить("Высота", Неопределено);  // Число - высота дисплея в пикселях (опционально)

	Результат.Вставить("КартинкаBase64", "");
	Результат.Вставить("Картинка"); // см. НовыйМедиаФайл

	Результат.Вставить("КешироватьМедиаФайлы", Ложь);
	Результат.Вставить("МедиаФайлы", Новый Массив()); // Массив из НовыйМедиаФайл
	
	Результат.Вставить("КартинкаQRКода"); // Устарела
	Возврат Результат;
	
КонецФункции

// Создает структуру описания медиафайла для дисплея покупателя.
//
// Параметры:
//  ИмяФайла - Строка - имя медиафайла с расширением.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяФайла - Строка - имя медиафайла с расширением.
//   * Base64 - Строка - содержимое файла в кодировке Base64.
//   * Данные - Произвольный, Неопределено - двоичные данные файла.
//
Функция НовыйМедиаФайл(ИмяФайла = "") Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("Base64", "");
	Результат.Вставить("Данные");
	Возврат Результат;
	
КонецФункции 

// Создает структуру параметров операции добавления медиафайлов.
//
// Возвращаемое значение:
//  Структура:
//   * МедиаФайлы - Массив Из Структура - список медиафайлов, см. НовыйМедиаФайл.
//
Функция ПараметрыОперацииДобавленияМедиаФайла() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("МедиаФайлы", Новый Массив); // Массив из см. НовыйМедиаФайл()
	Возврат Результат;
	
КонецФункции

// Создает структуру параметров кнопки для дисплея покупателя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор кнопки.
//  Наименование - Строка - наименование кнопки. Если не указано, используется идентификатор.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - идентификатор кнопки.
//   * Наименование - Строка - отображаемое наименование кнопки.
//
Функция КнопкаДисплеяПокупателя(Идентификатор, Наименование = "") Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Наименование", ?(ПустаяСтрока(Наименование), Идентификатор, Наименование));
	Результат.Вставить("Картинка", "");
	Возврат Результат;
	
КонецФункции

// Создает структуру параметров колонки табличной части дисплея покупателя.
//
// Параметры:
//  Имя - Строка - имя колонки.
//  Заголовок - Строка - заголовок колонки.
//  Ширина - Число - ширина колонки.
//  Выравнивание - Произвольный, Неопределено - выравнивание значения в колонке.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя колонки.
//   * Заголовок - Строка - заголовок колонки.
//   * Ширина - Число - ширина колонки.
//   * Выравнивание - Произвольный, Неопределено - выравнивание значения в колонке.
//
Функция ПараметрыКолонкиТабличнойЧастиДисплеяПокупателя(
		Имя, Заголовок = "", Ширина = 0, Выравнивание = Неопределено) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Ширина", Ширина);
	Результат.Вставить("Выравнивание", Выравнивание);
	Возврат Результат;
	
КонецФункции

// Создает структуру параметров элемента корзины для дисплея покупателя.
//
// Возвращаемое значение:
//  Структура:
//   * Фото - Строка, Неопределено - изображение товара в Base64 или имя файла.
//   * Наименование - Строка - наименование товара.
//   * Описание - Строка - описание товара.
//   * ПроизвольнаяКолонка - Строка - значение произвольной колонки.
//   * Цена - Строка - цена для отображения.
//   * Количество - Строка - количество для отображения.
//   * Сумма - Строка - сумма для отображения.
//   * Скидка - Число, Неопределено - скидка по строке.
//
Функция СтрокаКорзиныДисплеяПокупателя() Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Фото", Неопределено);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Описание", "");
	Результат.Вставить("ПроизвольнаяКолонка", "");
	Результат.Вставить("Цена", "");
	Результат.Вставить("Количество", "");
	Результат.Вставить("Сумма", "");
	Результат.Вставить("Скидка", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Создаёт структуру параметров рекламного элемента дисплея покупателя.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя медиафайла.
//   * ВремяОтображения - Число - время отображения рекламы в секундах.
//   * Картинка - Структура, Неопределено - медиаданные картинки, см. НовыйМедиаФайл.
//
Функция ПараметрыРекламы() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("ВремяОтображения", 20);
	Результат.Вставить("Картинка");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
#Область СлужебныйПрограммныйИнтерфейс

// Создает контекст выполнения операции с оборудованием дисплея покупателя.
//
// Возвращаемое значение:
//  Структура - контекст выполнения операции с заполненными именами процессоров данных.
//
Функция НовыйКонтекстОперацииСОборудованием() Экспорт
	
	Контекст = МенеджерОборудованияКлиентСервер.НовыйКонтекстВыполненияОперации();
	Контекст.ПроцессорДанныхСервер = "ОборудованиеДисплеиПокупателя";
	Контекст.ПроцессорДанныхКлиент = "ОборудованиеДисплеиПокупателяКлиент";
	Возврат Контекст;
	
КонецФункции

// Возвращает имена команд драйвера дисплея покупателя.
//
// Возвращаемое значение:
//  Структура:
//   * ВывестиТекст - Строка - команда вывода текста.
//   * ВывестиQRКод - Строка - команда вывода QR-кода.
//   * ОтобразитьИнформацию - Строка - команда отображения информации.
//   * ВывестиHTML - Строка - команда вывода HTML-разметки.
//   * ОчиститьТекст - Строка - команда очистки текста.
//   * ВывестиСтатусОперации - Строка - команда вывода статуса операции.
//   * ВывестиСтатусРабочегоМеста - Строка - команда вывода статуса рабочего места.
//   * ДобавитьМедиафайл - Строка - команда добавления медиафайла.
//
Функция КомандыДисплеяПокупателя() Экспорт

	Результат = Новый Структура();
	Результат.Вставить("ВывестиТекст", "DisplayText");
	Результат.Вставить("ВывестиQRКод", "DisplayQRCode");
	Результат.Вставить("ОтобразитьИнформацию", "DisplayInfo");
	Результат.Вставить("ВывестиHTML", "OutputHTML");
	Результат.Вставить("ОчиститьТекст", "ClearText");
	Результат.Вставить("ВывестиСтатусОперации", "DisplayStatus");
	Результат.Вставить("ВывестиСтатусРабочегоМеста", "DisplayStatusRM");
	Результат.Вставить("ДобавитьМедиафайл", "AddMediaFile");

	Возврат Результат;

КонецФункции

// Возвращает код статуса операции для команды отображения статуса.
//
// Параметры:
//  СтатусОперации - ПеречислениеСсылка.СтатусОперацииНаДисплее, Неопределено - статус операции.
//
// Возвращаемое значение:
//  Число - код статуса для драйвера. При Неопределено возвращает 0.
//
Функция КодСтатусаОперацииДляОтображенияСтатуса(СтатусОперации) Экспорт

	Если СтатусОперации = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	СтатусыОперации = Новый Соответствие();
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.НеУстановлен"), 0);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ВыполненоУспешно"), 1);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ОперацияНеВыполнена"), 2);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ОжиданиеОперации"), 0);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.Информация"), 0);

	Возврат СтатусыОперации.Получить(СтатусОперации);

КонецФункции

// Возвращает код статуса операции для команды отображения информации.
//
// Параметры:
//  СтатусОперации - ПеречислениеСсылка.СтатусОперацииНаДисплее, Неопределено - статус операции.
//
// Возвращаемое значение:
//  Число - код статуса для драйвера. При Неопределено возвращает 0.
//
Функция КодСтатусаОперацииДляОтображенияИнформации(СтатусОперации) Экспорт

	Если СтатусОперации = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	СтатусыОперации = Новый Соответствие();
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.НеУстановлен"), 0);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ВыполненоУспешно"), 1);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ОперацияНеВыполнена"), 2);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.ОжиданиеОперации"), 3);
	СтатусыОперации.Вставить(ПредопределенноеЗначение("Перечисление.СтатусОперацииНаДисплее.Информация"), 4);

	Возврат СтатусыОперации.Получить(СтатусОперации);

КонецФункции

// Возвращает код статуса рабочего места для драйвера дисплея покупателя.
//
// Параметры:
//  СтатусРабочегоМеста - ПеречислениеСсылка.СтатусРабочегоМестаНаДисплее, Неопределено - статус рабочего места.
//
// Возвращаемое значение:
//  Число - код статуса для драйвера. При Неопределено возвращает 0.
//
Функция КодСтатусаРабочегоМестаДляДисплея(СтатусРабочегоМеста) Экспорт

	Если СтатусРабочегоМеста = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	СтатусыРабочегоМеста = Новый Соответствие();
	СтатусыРабочегоМеста.Вставить(
		ПредопределенноеЗначение("Перечисление.СтатусРабочегоМестаНаДисплее.НеУстановлен"), 0);
	СтатусыРабочегоМеста.Вставить(
		ПредопределенноеЗначение("Перечисление.СтатусРабочегоМестаНаДисплее.СервисныйРежим"), 1);
	СтатусыРабочегоМеста.Вставить(
		ПредопределенноеЗначение("Перечисление.СтатусРабочегоМестаНаДисплее.РабочееМестоСвободно"), 2);
	СтатусыРабочегоМеста.Вставить(
		ПредопределенноеЗначение("Перечисление.СтатусРабочегоМестаНаДисплее.РабочееМестоРаботает"), 3);
	СтатусыРабочегоМеста.Вставить(
		ПредопределенноеЗначение("Перечисление.СтатусРабочегоМестаНаДисплее.ОшибкаНаРабочемМесте"), 4);

	Возврат СтатусыРабочегоМеста.Получить(СтатусРабочегоМеста);

КонецФункции

// Определяет расширение медиафайла по сигнатуре в начале Base64-строки.
//
// Параметры:
//  СодержимоеBase64 - Строка - содержимое файла в кодировке Base64.
//
// Возвращаемое значение:
//  Строка - расширение файла без точки.
//
Функция РасширениеМедиафайла(СодержимоеBase64) Экспорт

	// Расширение определяется по сигнатуре в начале Base64-строки без декодирования:
	//   PNG  (89 50 4E 47) → "iVBOR"
	//   JPEG (FF D8 FF)    → "/9j/"
	//   SVG  (<svg…)       → "PHN2Z"
	//   SVG  (<?xml)       → "PD94bWw"
	Если СтрНачинаетсяС(СодержимоеBase64, "iVBOR") Тогда
		Расширение = "png";
	ИначеЕсли СтрНачинаетсяС(СодержимоеBase64, "/9j/") Тогда
		Расширение = "jpg";
	ИначеЕсли СтрНачинаетсяС(СодержимоеBase64, "PHN2Z")
		ИЛИ СтрНачинаетсяС(СодержимоеBase64, "PD94bWw") Тогда
		Расширение = "svg";
	Иначе
		Расширение = "bin";
	КонецЕсли;

	Возврат Расширение;

КонецФункции

// Вычисляет CSS-размер базового шрифта по геометрии экрана дисплея покупателя.
//
// Параметры:
//  Ширина - Число - ширина экрана в пикселях.
//  Высота - Число - высота экрана в пикселях.
//
// Возвращаемое значение:
//  Строка - размер вида "Npx". При некорректных данных возвращает пустую строку.
//
Функция ВычислитьРазмерБазовогоШрифтаДисплея(Ширина, Высота) Экспорт

	МинСторона = Мин(Ширина, Высота);
	Если МинСторона <= 0 Тогда
		Возврат "";
	КонецЕсли;

	ДелительРазмера      = 30; // коэффициент масштабирования: пикселей экрана на 1px шрифта
	МинРазмерШрифтаПикс  = 16; // минимально допустимый размер
	МаксРазмерШрифтаПикс = 48; // максимально допустимый размер

	РазмерПикселей = Окр(МинСторона / ДелительРазмера);
	РазмерПикселей = Макс(МинРазмерШрифтаПикс, Мин(МаксРазмерШрифтаПикс, РазмерПикселей));
	Возврат СтрШаблон("%1px", Формат(РазмерПикселей, "ЧН=0; ЧГ=0"));

КонецФункции

// Возвращает размер базового шрифта для дисплея покупателя.
//
// Параметры:
//  ПараметрыОперации - Структура - параметры операции дисплея покупателя:
//   * Ширина - Число, Неопределено - ширина дисплея в пикселях.
//   * Высота - Число, Неопределено - высота дисплея в пикселях.
//
// Возвращаемое значение:
//  Строка - размер вида "Npx". Если данных недостаточно, возвращает пустую строку.
//
Функция РазмерБазовогоШрифтаДисплея(Знач ПараметрыОперации) Экспорт

	Если ЗначениеЗаполнено(ПараметрыОперации.Ширина) И ЗначениеЗаполнено(ПараметрыОперации.Высота) Тогда
		Возврат ВычислитьРазмерБазовогоШрифтаДисплея(ПараметрыОперации.Ширина, ПараметрыОперации.Высота);
	КонецЕсли;

	Возврат "";

КонецФункции

// Создаёт структуру данных операции отображения информации.
//
// Возвращаемое значение:
//  Структура:
//   * Результат - Булево - признак успешного выполнения операции.
//   * СтрокиТекста - Строка - текст для дисплеев без HTML.
//   * ЗначениеQRКода - Строка - значение QR-кода.
//   * КартинкаQRКода - Строка - Base64-представление изображения QR-кода.
//   * СтатусОперации - Число - код статуса операции драйвера.
//   * КодСтатусаОперации - Число - код статуса операции для драйвера дисплея.
//   * КодСтатусаРабочегоМеста - Число - код статуса рабочего места.
//   * ТекстОшибки - Строка - описание ошибки драйвера.
//   * ТекстHTML - Строка - HTML-код для отображения.
//   * КешироватьМедиаФайлы - Булево - признак кеширования медиафайлов.
//   * МедиаФайлы - Массив Из Структура - медиафайлы для передачи драйверу.
//   * ЗагруженныеКартинки - Массив Из Строка - имена картинок, уже добавленных в МедиаФайлы.
//   * ПолученныеФайлыРекламы - Массив Из Строка - имена рекламных файлов, уже полученных с сервера.
//   * ЗагруженныеФайлыРекламы - Массив Из Строка - имена рекламных файлов, уже переданных в драйвер.
//   * ИндексТекущейРекламы - Число - индекс текущей рекламы в массиве Реклама.
//   * РасположениеРекламы - Строка - расположение рекламного блока.
//   * ПроцентРекламы - Число - доля рекламного блока в процентах.
//   * Реклама - Массив Из Структура - элементы рекламы, см. ПараметрыРекламы.
//   * ФорматЧисла - Строка - строка формата для вывода сумм.
//
Функция НовыеДанныеОперацииОтображенияИнформации() Экспорт

	ДанныеОперации = Новый Структура();
	ДанныеОперации.Вставить("Результат", Истина);
	ДанныеОперации.Вставить("СтрокиТекста", "");
	ДанныеОперации.Вставить("ЗначениеQRКода", ""); // Строка - значение QR-кода.
	ДанныеОперации.Вставить("КартинкаQRКода", ""); // Строка - Base64-представление изображения QR-кода.
	// СтатусОперации: 0-Не установлены, 1-Выполнено успешно, 2-Операция не выполнена
	ДанныеОперации.Вставить("СтатусОперации", 0);
	ДанныеОперации.Вставить("КодСтатусаОперации", 0);
	ДанныеОперации.Вставить("КодСтатусаРабочегоМеста", 0);
	ДанныеОперации.Вставить("ТекстОшибки", "");
	ДанныеОперации.Вставить("ТекстHTML", "");
	ДанныеОперации.Вставить("КешироватьМедиаФайлы", Ложь);
	ДанныеОперации.Вставить("МедиаФайлы", Новый Массив);
	ДанныеОперации.Вставить("ЗагруженныеКартинки", Новый Массив);
	ДанныеОперации.Вставить("ПолученныеФайлыРекламы", Новый Массив);
	ДанныеОперации.Вставить("ЗагруженныеФайлыРекламы", Новый Массив);
	ДанныеОперации.Вставить("ИндексТекущейРекламы", 0);
	ДанныеОперации.Вставить("РасположениеРекламы", "");
	ДанныеОперации.Вставить("ПроцентРекламы", 0);
	ДанныеОперации.Вставить("Реклама", Новый Массив);
	ДанныеОперации.Вставить("ФорматЧисла", "ЧДЦ=2; ЧРД=.; ЧН=0.00");
	Возврат ДанныеОперации;

КонецФункции

// Создаёт структуру данных операции вывода QR-кода.
//
// Возвращаемое значение:
//  Структура:
//   * СтрокиТекста - Строка - сопроводительный текст для вывода.
//   * ЗначениеQRКода - Строка - значение QR-кода.
//   * КартинкаQRКода - Строка - Base64-представление изображения QR-кода.
//
Функция НовыеДанныеОперацииВыводаQRКода() Экспорт
	
	ДанныеОперации = Новый Структура;
	ДанныеОперации.Вставить("СтрокиТекста", "");
	ДанныеОперации.Вставить("ЗначениеQRКода", "");
	ДанныеОперации.Вставить("КартинкаQRКода", "");
	Возврат ДанныеОперации;
	
КонецФункции

#КонецОбласти
