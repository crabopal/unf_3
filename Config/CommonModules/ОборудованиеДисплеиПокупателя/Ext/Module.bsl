#Область ПодготовкаДанныхОперации

// Подготавливает данные операции при вызове команды оборудования.
//
// Параметры:
//  ДанныеОперации       - Структура - данные операции, дополняемые подготовленными данными.
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  Команда              - Строка - имя команды оборудования.
//  ПараметрыОперации    - Структура - параметры текущей операции.
//
Процедура ПриПодготовкеДанныхОперации(ДанныеОперации, ПараметрыПодключения, Команда, ПараметрыОперации) Экспорт

	ПодключениеОсновногоУстройства =
		ПараметрыПодключения.ПодключенияУстройств.Получить(ПараметрыПодключения.ОсновноеУстройство);
	КомандыДисплея = ОборудованиеДисплеиПокупателяКлиентСервер.КомандыДисплеяПокупателя();
	
	Если Команда = КомандыДисплея.ОтобразитьИнформацию Тогда
		
		ПодготовитьДанныеОперацииОтображенияИнформации(ДанныеОперации, ПодключениеОсновногоУстройства, ПараметрыОперации);
		
	ИначеЕсли Команда = КомандыДисплея.ВывестиQRКод Тогда
		
		Если Не ЗначениеЗаполнено(ДанныеОперации) Тогда
			ДанныеОперации = ОборудованиеДисплеиПокупателяКлиентСервер.НовыеДанныеОперацииВыводаQRКода();
		КонецЕсли;
		ДанныеОперации.СтрокиТекста = ПараметрыОперации.СтрокиТекста;
		ДанныеОперации.ЗначениеQRКода = ПараметрыОперации.ЗначениеQRКода;
		Если ЗначениеЗаполнено(ДанныеОперации.ЗначениеQRКода) Тогда
			РазмерПоУмолчанию = 300;
			ДанныеОперации.КартинкаQRКода = КартинкаQRКодаBase64(ПараметрыОперации.ЗначениеQRКода, РазмерПоУмолчанию);
		КонецЕсли;
		
	Иначе
		
		ПодготовленныеДанныеОперации = ПодготовитьДанныеОперации(ПодключениеОсновногоУстройства, Команда, ПараметрыОперации);
		ОбщегоНазначенияБПОКлиентСервер.ДополнитьСтруктуру(ДанныеОперации, ПодготовленныеДанныеОперации, Истина);
		
	КонецЕсли;

КонецПроцедуры

// Формирует данные операции для передачи драйверу дисплея покупателя.
// Определяет способ отображения по команде и виду операции, заполняет HTML, текст,
// QR-код, медиафайлы и коды статусов.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  Команда              - Строка - имя команды оборудования.
//  ПараметрыОперации    - Структура - параметры текущей операции.
//
// Возвращаемое значение:
//  Структура:
//   * ТекстHTML - Строка - HTML-содержимое для отображения.
//   * СтатусОперации - Число - статус операции.
//   * СтрокиТекста - Строка - текст для обычных дисплеев.
//   * ЗначениеQRКода - Строка - значение QR-кода.
//   * КодСтатусаРабочегоМеста - Произвольный - код статуса рабочего места.
//   * КодСтатусаОперации - Произвольный - код статуса операции.
//   * КешироватьМедиаФайлы - Булево - признак кеширования медиафайлов.
//   * МедиаФайлы - Массив - медиафайлы для отображения.
Функция ПодготовитьДанныеОперации(ПараметрыПодключения, Команда, ПараметрыОперации) Экспорт

	Возврат ПараметрыОперации;

КонецФункции

#КонецОбласти

#Область ОбработкаРезультатаОперации

// Передает результаты выполнения операции на дальнейшую обработку.
// Извлекает параметры основного устройства и вызывает обработчик результатов операции.
//
// Параметры:
//  ДанныеОперации       - Структура - данные операции, дополняемые результатами выполнения.
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  Команда              - Строка    - имя выполненной команды оборудования.
//  РезультатОперации    - Структура - результат выполнения операции от драйвера устройства.
//
Процедура ПриОбработкеРезультатовОперации(ДанныеОперации, ПараметрыПодключения, Команда, РезультатОперации) Экспорт

	ПодключениеОсновногоУстройства = ПараметрыПодключения.ПодключенияУстройств.
		Получить(ПараметрыПодключения.ОсновноеУстройство);

	ОбработатьДанныеОперации(
		ПодключениеОсновногоУстройства, Команда, РезультатОперации, ДанныеОперации);

КонецПроцедуры

// Обрабатывает результаты выполнения операции на дисплее покупателя.
// В текущей реализации дополнительная обработка не выполняется.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения основного устройства.
//  Команда              - Строка    - имя команды оборудования.
//  РезультатВыполнения  - Структура - результат выполнения операции.
//  ДанныеОперации       - Структура - данные операции для возможного дополнения.
//
Процедура ОбработатьДанныеОперации(ПараметрыПодключения, Команда, РезультатВыполнения, ДанныеОперации) Экспорт

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПодготовкаДанныхОперации

Процедура ПодготовитьДанныеОперацииОтображенияИнформации(ДанныеОперации, ПараметрыПодключения, ПараметрыОперации)
	
	Если Не ЗначениеЗаполнено(ДанныеОперации) Тогда
		ДанныеОперации = ОборудованиеДисплеиПокупателяКлиентСервер.НовыеДанныеОперацииОтображенияИнформации();
	КонецЕсли;
	ДанныеОперации.ФорматЧисла = ФорматЧисла(ПараметрыПодключения.ДисплейОтображаетHTML);

	ПодготовитьДанныеДляВыводаИнформацииБезПоддержкиHTML(ДанныеОперации, ПараметрыОперации); 
	
	// ++ НеМобильноеПриложение
	Если ПараметрыПодключения.ДисплейОтображаетHTML Тогда
	
		ЗаполнитьДанныеИзШаблонаУстройства(ДанныеОперации, ПараметрыПодключения);
		ДанныеОперации.ТекстHTML = "<p>No information</p>";
		Если ПараметрыОперации.Операция = "СервисныйРежим" Тогда
			ПостроитьСтраницуСервисныйРежим(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		ИначеЕсли ПараметрыОперации.Операция = "ПлатежнаяОперация" Тогда
			ПостроитьСтраницуПлатежнаяОперация(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		ИначеЕсли ПараметрыОперации.Операция = "СписокТоваров" Тогда
			ПостроитьСтраницуСписокТоваров(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		ИначеЕсли ПараметрыОперации.Операция = "Корзина" Тогда
			ПостроитьСтраницуКорзина(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		ИначеЕсли ПараметрыОперации.Операция = "ФискальныйЧек" Тогда
			ПостроитьСтраницуФискальныйЧек(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		ИначеЕсли ПараметрыОперации.Операция = "Картинка" Тогда
			ПостроитьСтраницуКартинка(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		Иначе
			ПостроитьСтраницуИнформация(ПараметрыПодключения, ДанныеОперации, ПараметрыОперации);
		КонецЕсли;
		
		СтандартнаяОбработка = Истина;
		ТекстHTML = ДанныеОперации.ТекстHTML;
		ОборудованиеДисплеиПокупателяПереопределяемый.ПослеФормированииТекстаHTML(ТекстHTML, СтандартнаяОбработка);
		Если Не СтандартнаяОбработка Тогда
			ДанныеОперации.ТекстHTML = ТекстHTML;
		КонецЕсли;
		
		ДанныеОперации.КешироватьМедиаФайлы = (ДанныеОперации.МедиаФайлы.Количество() > 0);
		
	КонецЕсли;
	
	// -- НеМобильноеПриложение
	
КонецПроцедуры

// ++ НеМобильноеПриложение

// Заполняет данные операции параметрами рекламы и корзины из шаблона, назначенного устройству.
//
// Параметры:
//  ДанныеОперации - Структура - данные операции DisplayInfo, дополняемые рекламой,
//                   расположением, процентом рекламного блока и цветами корзины.
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//
Процедура ЗаполнитьДанныеИзШаблонаУстройства(ДанныеОперации, ПараметрыПодключения)

	ПараметрыРекламыШаблона = ПолучитьДанныеИзШаблонаУстройства(
		ПараметрыПодключения.ИдентификаторУстройства,
		ДанныеОперации.ПолученныеФайлыРекламы);
	ДанныеОперации.Реклама = ПараметрыРекламыШаблона.Реклама;
	ДанныеОперации.РасположениеРекламы = ПараметрыРекламыШаблона.РасположениеРекламы;
	ДанныеОперации.ПроцентРекламы = ПараметрыРекламыШаблона.ПроцентРекламы;
	ДанныеОперации.Вставить("КорзинаШапкаЦвет", ПараметрыРекламыШаблона.КорзинаШапкаЦвет);
	ДанныеОперации.Вставить("КорзинаПодвалЦвет", ПараметрыРекламыШаблона.КорзинаПодвалЦвет);
	ДанныеОперации.Вставить("КорзинаПризвольнаяКолонкаЦвет",
		ПараметрыРекламыШаблона.КорзинаПризвольнаяКолонкаЦвет);
	ДанныеОперации.Вставить("КорзинаОтображатьСкидку", ПараметрыРекламыШаблона.КорзинаОтображатьСкидку);
	ДанныеОперации.Вставить("КорзинаОтображатьПроизвольнуюКолонку", ПараметрыРекламыШаблона.КорзинаОтображатьПроизвольнуюКолонку);

	Если ПараметрыРекламыШаблона.Реклама.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементРекламы Из ПараметрыРекламыШаблона.Реклама Цикл
		Картинка = ЭлементРекламы.Картинка;
		Если Не ПустаяСтрока(Картинка.Base64) Или Картинка.Данные <> Неопределено Тогда
			ДанныеОперации.Медиафайлы.Добавить(Картинка);
		КонецЕсли;
	КонецЦИкла;

КонецПроцедуры

// Заполняет параметры HTML-шаблона данными рекламного блока и корзины из данных операции.
//
// Параметры:
//  ПараметрыШаблона - Структура - параметры HTML-шаблона, дополняемые полями Реклама,
//                     ИндексТекущейРекламы, РасположениеРекламы, ПроцентРекламы
//                     и цветами корзины.
//  ДанныеОперации - Структура - данные операции DisplayInfo.
//
Процедура ЗаполнитьПараметрыШаблонаРекламой(ПараметрыШаблона, ДанныеОперации)

	Реклама = Новый Массив;
	Если ДанныеОперации.Свойство("Реклама")
		И ТипЗнч(ДанныеОперации.Реклама) = Тип("Массив") Тогда
		Реклама = ДанныеОперации.Реклама;
	КонецЕсли;
	ПараметрыШаблона.Реклама = Реклама;

	ИндексТекущейРекламы = 0;
	Если ДанныеОперации.Свойство("ИндексТекущейРекламы")
		И ТипЗнч(ДанныеОперации.ИндексТекущейРекламы) = Тип("Число") Тогда
		ИндексТекущейРекламы = ДанныеОперации.ИндексТекущейРекламы;
	КонецЕсли;
	ПараметрыШаблона.ИндексТекущейРекламы = ИндексТекущейРекламы;

	РасположениеРекламы = "";
	Если ДанныеОперации.Свойство("РасположениеРекламы") Тогда
		РасположениеРекламы = ДанныеОперации.РасположениеРекламы;
	КонецЕсли;
	ПараметрыШаблона.РасположениеРекламы = РасположениеРекламы;

	ПроцентРекламы = 0;
	Если ДанныеОперации.Свойство("ПроцентРекламы") Тогда
		ПроцентРекламы = ДанныеОперации.ПроцентРекламы;
	КонецЕсли;
	ПараметрыШаблона.ПроцентРекламы = ПроцентРекламы;

КонецПроцедуры

// Возвращает источник картинки рекламного элемента для подстановки в HTML.
//
// Параметры:
//  ЭлементРекламы - Структура - элемент рекламы, см.
//                   ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы().
//
// Возвращаемое значение:
//  Строка, Структура, Неопределено - имя файла, структура картинки или Неопределено,
//  если источник не задан.
//
Функция КартинкаРекламыИзЭлемента(ЭлементРекламы)

	Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = ИмяФайлаИзЭлементаРекламы(ЭлементРекламы);
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		Возврат ИмяФайла;
	КонецЕсли;

	Если Не ЭлементРекламы.Свойство("Картинка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭлементРекламы.Картинка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = ИмяФайлаИзКартинкиРекламы(ЭлементРекламы.Картинка);
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		Возврат ИмяФайла;
	КонецЕсли;

	Возврат ЭлементРекламы.Картинка;

КонецФункции

// Возвращает имя рекламного файла из элемента рекламы.
//
// Параметры:
//  ЭлементРекламы - Структура - элемент рекламы.
//
// Возвращаемое значение:
//  Строка - имя файла или пустая строка.
//
Функция ИмяФайлаИзЭлементаРекламы(ЭлементРекламы)

	ИмяФайла = "";
	Если ЭлементРекламы.Свойство("Имя") Тогда
		ИмяФайла = ЭлементРекламы.Имя;
	КонецЕсли;
	Возврат ИмяФайла;

КонецФункции

// Возвращает имя файла из значения картинки рекламы.
//
// Параметры:
//  КартинкаРекламы - Строка, Структура - имя файла или структура медиафайла.
//
// Возвращаемое значение:
//  Строка - имя файла или пустая строка.
//
Функция ИмяФайлаИзКартинкиРекламы(КартинкаРекламы)

	Если ТипЗнч(КартинкаРекламы) = Тип("Строка") Тогда
		Возврат КартинкаРекламы;
	КонецЕсли;
	Если ТипЗнч(КартинкаРекламы) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	ИмяФайла = "";
	Если КартинкаРекламы.Свойство("ИмяФайла") Тогда
		ИмяФайла = КартинкаРекламы.ИмяФайла;
	КонецЕсли;
	Возврат ИмяФайла;

КонецФункции

// Возвращает стандартную рекламу дисплея покупателя из шаблона, назначенного устройству.
// После чтения шаблона дополняет результат файлами из переопределяемого источника.
//
// Параметры:
//  ИдентификаторУстройства - СправочникСсылка.ПодключаемоеОборудование - устройство дисплея покупателя.
//  ПолученныеФайлыРекламы - Массив Из Строка, Неопределено - имена рекламных файлов, уже полученных с сервера.
//
// Возвращаемое значение:
//  Структура:
//   * РасположениеРекламы - Строка - расположение рекламного блока.
//   * ПроцентРекламы - Число - доля рекламного блока в процентах.
//   * Реклама - Массив Из Структура - элементы рекламы, см. ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы.
//   * КорзинаШапкаЦвет - Строка - цвет шапки корзины.
//   * КорзинаПодвалЦвет - Строка - цвет подвала корзины.
//   * КорзинаПризвольнаяКолонкаЦвет - Строка - цвет произвольной колонки.
//
Функция ПолучитьДанныеИзШаблонаУстройства(ИдентификаторУстройства, ПолученныеФайлыРекламы = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("РасположениеРекламы", "");
	Результат.Вставить("ПроцентРекламы", 0);
	Результат.Вставить("Реклама", Новый Массив);
	Результат.Вставить("ПолученныеФайлыРекламы", ПолученныеФайлыРекламы);
	Результат.Вставить("КорзинаШапкаЦвет", "#008000");
	Результат.Вставить("КорзинаПодвалЦвет", "#008000");
	Результат.Вставить("КорзинаПризвольнаяКолонкаЦвет", "#000000");
	Результат.Вставить("КорзинаОтображатьСкидку", Ложь);
	Результат.Вставить("КорзинаОтображатьПроизвольнуюКолонку", Ложь);

	Если Не ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		Возврат Результат;
	КонецЕсли;

	РеквизитыУстройства = ОбщегоНазначенияБПО.ЗначенияРеквизитовОбъекта(
		ИдентификаторУстройства,
		"ШаблонДисплеяПокупателя");
	ШаблонДисплеяПокупателя = РеквизитыУстройства.ШаблонДисплеяПокупателя;
	Если ЗначениеЗаполнено(ШаблонДисплеяПокупателя) Тогда

		ШаблонДисплеяПокупателяОбъект = ШаблонДисплеяПокупателя.ПолучитьОбъект();
		Результат.РасположениеРекламы = ШаблонДисплеяПокупателяОбъект.РасположениеРекламы;
		Результат.ПроцентРекламы = ШаблонДисплеяПокупателяОбъект.ПроцентЗаполненияОкна;
		Результат.КорзинаШапкаЦвет = ШаблонДисплеяПокупателяОбъект.КорзинаШапкаЦвет;
		Результат.КорзинаПодвалЦвет = ШаблонДисплеяПокупателяОбъект.КорзинаПодвалЦвет;
		Результат.КорзинаПризвольнаяКолонкаЦвет =
			АдаптироватьЦвет(ШаблонДисплеяПокупателяОбъект.КорзинаПризвольнаяКолонкаЦвет);
		Результат.КорзинаОтображатьСкидку = ШаблонДисплеяПокупателяОбъект.КорзинаОтображатьСкидку;
		Результат.КорзинаОтображатьПроизвольнуюКолонку = ШаблонДисплеяПокупателяОбъект.КорзинаОтображатьПроизвольнуюКолонку;

		Для Каждого СтрокаРекламы Из ШаблонДисплеяПокупателяОбъект.Реклама Цикл
			ПараметрыРекламыИзШаблона = ПараметрыРекламыИзСтрокиШаблона(СтрокаРекламы, ПолученныеФайлыРекламы);
			Если ПараметрыРекламыИзШаблона <> Неопределено Тогда
				Результат.Реклама.Добавить(ПараметрыРекламыИзШаблона);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Результат = НормализоватьПараметрыРекламногоБлока(Результат);
	ОборудованиеДисплеиПокупателяПереопределяемый.ПриПолученииФайловРекламы(
		ИдентификаторУстройства,
		Результат.Реклама,
		Результат);
	Результат = НормализоватьПараметрыРекламногоБлока(Результат);

	Возврат Результат;

КонецФункции

// Приводит параметры рекламного блока к допустимым значениям.
//
// Параметры:
//  ПараметрыРекламы - Структура - параметры рекламного блока:
//   * РасположениеРекламы - Строка
//   * ПроцентРекламы - Число
//   * Реклама - Массив
//
// Возвращаемое значение:
//  Структура - нормализованные параметры рекламного блока.
//
Функция НормализоватьПараметрыРекламногоБлока(ПараметрыРекламы)

	ПараметрыРекламы.РасположениеРекламы = НормализоватьРасположениеРекламы(
		ПараметрыРекламы.РасположениеРекламы);
	ПараметрыРекламы.ПроцентРекламы = НормализоватьПроцентРекламы(ПараметрыРекламы.ПроцентРекламы);
	ПараметрыРекламы.Реклама = НормализоватьПараметрыРекламы(ПараметрыРекламы.Реклама);

	Возврат ПараметрыРекламы;

КонецФункции

// Возвращает расположение рекламы, если оно входит в список допустимых значений.
//
// Параметры:
//  РасположениеРекламы - Строка - расположение рекламного блока.
//
// Возвращаемое значение:
//  Строка - допустимое расположение или пустая строка.
//
Функция НормализоватьРасположениеРекламы(РасположениеРекламы)

	Если РасположениеРекламыДопустимо(РасположениеРекламы) Тогда
		Возврат РасположениеРекламы;
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет, что расположение рекламы поддерживается HTML-шаблоном.
//
// Параметры:
//  РасположениеРекламы - Строка - расположение рекламного блока.
//
// Возвращаемое значение:
//  Булево - Истина, если расположение допустимо.
//
Функция РасположениеРекламыДопустимо(РасположениеРекламы)

	ДопустимыеРасположенияРекламы = Новый Массив;
	ДопустимыеРасположенияРекламы.Добавить("Справа");
	ДопустимыеРасположенияРекламы.Добавить("Слева");
	ДопустимыеРасположенияРекламы.Добавить("Сверху");
	ДопустимыеРасположенияРекламы.Добавить("Снизу");

	Возврат ДопустимыеРасположенияРекламы.Найти(РасположениеРекламы) <> Неопределено;

КонецФункции

// Возвращает процент заполнения рекламного блока в допустимом диапазоне.
//
// Параметры:
//  ПроцентРекламы - Число - доля рекламного блока в процентах.
//
// Возвращаемое значение:
//  Число - исходный процент или 0, если значение недопустимо.
//
Функция НормализоватьПроцентРекламы(ПроцентРекламы)

	МаксимальныйПроцентРекламы = 100;

	Если ТипЗнч(ПроцентРекламы) <> Тип("Число")
		Или ПроцентРекламы <= 0
		Или ПроцентРекламы >= МаксимальныйПроцентРекламы Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ПроцентРекламы;

КонецФункции

// Приводит массив рекламы к единому контракту и удаляет дубли по имени файла.
//
// Параметры:
//  Реклама - Массив - элементы рекламы.
//
// Возвращаемое значение:
//  Массив Из Структура - элементы рекламы, см. ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы.
//
Функция НормализоватьПараметрыРекламы(Реклама)

	Если ТипЗнч(Реклама) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = Новый Массив;
	УникальныеИменаФайлов = Новый Соответствие;

	Для Каждого ЭлементРекламы Из Реклама Цикл
		НормализованныйЭлемент = НормализоватьПараметрыРекламыЭлемента(ЭлементРекламы);
		Если НормализованныйЭлемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если УникальныеИменаФайлов.Получить(НормализованныйЭлемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УникальныеИменаФайлов.Вставить(НормализованныйЭлемент.Имя, Истина);
		Результат.Добавить(НормализованныйЭлемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Приводит элемент рекламы к единому внутреннему контракту.
//
// Параметры:
//  ЭлементРекламы - Структура - исходный элемент рекламы.
//
// Возвращаемое значение:
//  Структура, Неопределено - нормализованный элемент рекламы, см.
//  ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы(),
//  или Неопределено, если элемент не содержит обязательных данных.
//
Функция НормализоватьПараметрыРекламыЭлемента(ЭлементРекламы)

	Если ТипЗнч(ЭлементРекламы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЭлементРекламы.Свойство("Картинка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ЭлементРекламы.Картинка) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = "";
	Если ЭлементРекламы.Свойство("Имя") Тогда
		ИмяФайла = ЭлементРекламы.Имя;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Если ЭлементРекламы.Картинка.Свойство("ИмяФайла") Тогда
			ИмяФайла = ЭлементРекламы.Картинка.ИмяФайла;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЕстьДанные = ЭлементРекламы.Картинка.Свойство("Данные")
		И ЗначениеЗаполнено(ЭлементРекламы.Картинка.Данные);
	ЕстьBase64 = ЭлементРекламы.Картинка.Свойство("Base64")
		И Не ПустаяСтрока(ЭлементРекламы.Картинка.Base64);
	ФайлПолученССервера = ЭлементРекламы.Картинка.Свойство("ПолученССервера")
		И ЭлементРекламы.Картинка.ПолученССервера;
	Если Не ЕстьДанные И Не ЕстьBase64 И Не ФайлПолученССервера Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы();
	Результат.Имя = ИмяФайла;
	Если ЭлементРекламы.Свойство("ВремяОтображения")
		И ТипЗнч(ЭлементРекламы.ВремяОтображения) = Тип("Число")
		И ЭлементРекламы.ВремяОтображения > 0 Тогда
		Результат.ВремяОтображения = ЭлементРекламы.ВремяОтображения;
	КонецЕсли;

	ЭлементРекламы.Картинка.ИмяФайла = ИмяФайла;
	Результат.Картинка = ЭлементРекламы.Картинка;

	Возврат Результат;

КонецФункции

// Формирует параметры рекламного элемента по строке табличной части шаблона.
//
// Параметры:
//  СтрокаРекламы - Произвольный - строка табличной части Реклама шаблона
//                  дисплея покупателя.
//  ПолученныеФайлыРекламы - Массив Из Строка, Неопределено - имена рекламных файлов,
//                           уже полученных с сервера.
//
// Возвращаемое значение:
//  Структура, Неопределено - параметры рекламного элемента, см.
//  ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы(),
//  или Неопределено, если картинку получить нельзя.
//
Функция ПараметрыРекламыИзСтрокиШаблона(СтрокаРекламы, ПолученныеФайлыРекламы)

	Если СтрокаРекламы.Картинка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыРекламы = ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы();
	ПараметрыРекламы.Имя = СтрокаРекламы.Имя;
	Если ПустаяСтрока(ПараметрыРекламы.Имя) Тогда
		ПараметрыРекламы.Имя = СтрШаблон("ad-%1", Формат(СтрокаРекламы.НомерСтроки, "ЧГ=0"));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаРекламы.ВремяОтображения) Тогда
		ПараметрыРекламы.ВремяОтображения = СтрокаРекламы.ВремяОтображения;
	КонецЕсли;

	ПараметрыРекламы.Картинка = ОборудованиеДисплеиПокупателяКлиентСервер.НовыйМедиаФайл(
		ПараметрыРекламы.Имя);
	Если ФайлРекламыУжеПолучен(ПолученныеФайлыРекламы, ПараметрыРекламы.Имя) Тогда
		ПараметрыРекламы.Картинка.Вставить("ПолученССервера", Истина);
		Возврат ПараметрыРекламы;
	КонецЕсли;

	ДанныеКартинки = СтрокаРекламы.Картинка.Получить();
	Если ДанныеКартинки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыРекламы.Картинка.Данные = ДанныеКартинки;

	Возврат ПараметрыРекламы;

КонецФункции

// Проверяет, что рекламный файл уже был получен с сервера.
//
// Параметры:
//  ПолученныеФайлыРекламы - Массив Из Строка, Неопределено - имена полученных файлов.
//  ИмяФайла - Строка - имя рекламного файла.
//
// Возвращаемое значение:
//  Булево - Истина, если имя файла найдено в списке полученных.
//
Функция ФайлРекламыУжеПолучен(ПолученныеФайлыРекламы, ИмяФайла)

	Если ТипЗнч(ПолученныеФайлыРекламы) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПолученныеФайлыРекламы.Найти(ИмяФайла) <> Неопределено;

КонецФункции

// -- НеМобильноеПриложение

Процедура ПодготовитьДанныеДляВыводаИнформацииБезПоддержкиHTML(ДанныеОперации, ПараметрыОперации)
	
	ДанныеОперации.СтрокиТекста = ПараметрыОперации.СтрокиТекста;
	Если Не ПустаяСтрока(ПараметрыОперации.ЗначениеQRКода) Тогда
		ДанныеОперации.ЗначениеQRКода = ПараметрыОперации.ЗначениеQRКода;
	КонецЕсли;

	Если ПустаяСтрока(ДанныеОперации.СтрокиТекста) Тогда
		
		Если ПараметрыОперации.Операция = "ФискальныйЧек" Тогда
			ДанныеОперации.СтрокиТекста = НСтр("ru='СПАСИБО ЗА ПОКУПКУ!'");
		ИначеЕсли ПараметрыОперации.Операция = "ПлатежнаяОперация" Тогда
			Операция = ТекстСтатуса(ПараметрыОперации);
			ДанныеОперации.СтрокиТекста = НСтр("ru='ПЛАТЕЖНАЯ ОПЕРАЦИЯ'") + Символы.ПС + Операция;
		ИначеЕсли ПараметрыОперации.Операция = "СписокТоваров"
			Или ПараметрыОперации.Операция = "Корзина" Тогда
			Сумма = Формат(ПараметрыОперации.ПодвалСумма, ДанныеОперации.ФорматЧисла);
			ДанныеОперации.СтрокиТекста = НСтр("ru='ИТОГО:'") + " " + Сумма;
		Иначе // BSLLS:EmptyCodeBlock-off
			// без изменений
		КонецЕсли;
	КонецЕсли;
		
	КодСтатусаОперации = ОборудованиеДисплеиПокупателяКлиентСервер
		.КодСтатусаОперацииДляОтображенияИнформации(ПараметрыОперации.СтатусОперации);
	ДанныеОперации.Вставить("КодСтатусаОперации", КодСтатусаОперации);

	КодСтатусаРабочегоМеста = ОборудованиеДисплеиПокупателяКлиентСервер
		.КодСтатусаРабочегоМестаДляДисплея(ПараметрыОперации.СтатусРабочегоМеста);
	ДанныеОперации.Вставить("КодСтатусаРабочегоМеста", КодСтатусаРабочегоМеста);
	
КонецПроцедуры

#КонецОбласти

// ++ НеМобильноеПриложение

#Область Страницы

// Формирует HTML-страницу сервисного режима для дисплея покупателя.
// Отображает статус готовности кассы: «Готов к продаже», «Касса не работает» или «Сервисный режим».
// Также добавляет ссылку на приложение «Мои чеки онлайн» для проверки чеков.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом и статусом.
//  ПараметрыОперации    - Структура - параметры операции (название организации, готовность к работе и др.).
//
Процедура ПостроитьСтраницуСервисныйРежим(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)
	
	Параметры = ПараметрыШаблона();
	Параметры.Заголовок = XMLСтрока(ПараметрыОперации.НазваниеОрганизации);
	
	Если ПараметрыОперации.ГотовностьКРаботе = Истина Тогда
		Параметры.Операция = НСтр("ru = 'ГОТОВ К ПРОДАЖЕ'");
		Параметры.Описание = НСтр("ru='ДОБРО ПОЖАЛОВАТЬ!'"); // АПК: 374 - интерфейсная особенность
		Параметры.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ВыполненоУспешно;
		Параметры.ОсновнойЦвет = ЦветаШаблона().Зеленый;
	ИначеЕсли ПараметрыОперации.ГотовностьКРаботе = Ложь Тогда
		Параметры.Операция = НСтр("ru = 'НЕДОСТУПНО'");
		Параметры.Описание = НСтр("ru='КАССА НЕ РАБОТАЕТ!'"); // АПК: 374 - интерфейсная особенность
		Параметры.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОперацияНеВыполнена;
		Параметры.ОсновнойЦвет = ЦветаШаблона().Красный;
	Иначе
		Параметры.Операция = НСтр("ru = 'НЕДОСТУПНО'");
		Параметры.Описание = НСтр("ru='СЕРВИСНЫЙ РЕЖИМ'");
		Параметры.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации;
		Параметры.ОсновнойЦвет = ЦветаШаблона().Красный;
	КонецЕсли;
	
	ИмяФайла = Перечисления.СтатусОперацииНаДисплее.ИмяФайлаИконкиСтатуса(Параметры.СтатусОперации);
	ДобавитьМедиафайл(ДанныеОперации, ИмяФайла);
	
	ЗаполнитьПараметрыШаблонаРекламой(Параметры, ДанныеОперации);
	Параметры.Ширина     = ПараметрыОперации.Ширина;
	Параметры.Высота     = ПараметрыОперации.Высота;

	ДанныеОперации.ТекстHTML = ПостроитьHTMLПоШаблону(ПараметрыПодключения, Параметры);

КонецПроцедуры

// Формирует HTML-страницу с произвольной информацией для дисплея покупателя.
// Отображает переданный текст, заголовок организации и QR-код (например, для сканирования).
// Поддерживает произвольный набор кнопок и настраиваемый размер шрифта.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (строки текста, QR-код, кнопки, шрифт).
//
Процедура ПостроитьСтраницуИнформация(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	Параметры = ПараметрыШаблона();
	Параметры.Заголовок = XMLСтрока(ПараметрыОперации.НазваниеОрганизации);
	Параметры.Операция = НСтр("ru = 'ИНФОРМАЦИЯ'");
	Параметры.Информация = ПараметрыОперации.СтрокиТекста;
	Если ЗначениеЗаполнено(ПараметрыОперации.КартинкаBase64) Тогда
		Расширение = ОборудованиеДисплеиПокупателяКлиентСервер.РасширениеМедиафайла(ПараметрыОперации.КартинкаBase64);
		Параметры.Картинка = СтрШаблон("data:image/%1;base64,%2", Расширение, ПараметрыОперации.КартинкаBase64);
	Иначе
		Параметры.Картинка = ПараметрыОперации.Картинка;
	КонецЕсли;
	Параметры.СтатусОперации = ПараметрыОперации.СтатусОперации;
	Параметры.ОсновнойЦвет = ЦветПоСтатусу(ПараметрыОперации.СтатусОперации);
	
	ИмяФайла = Перечисления.СтатусОперацииНаДисплее.ИмяФайлаИконкиСтатуса(Параметры.СтатусОперации);
	ДобавитьМедиафайл(ДанныеОперации, ИмяФайла);
	
	Для каждого Кнопка Из ПараметрыОперации.Кнопки Цикл
		Параметры.Кнопки.Добавить(Кнопка);
	КонецЦикла;
	ЗаполнитьПараметрыШаблонаРекламой(Параметры, ДанныеОперации);
	Параметры.Ширина     = ПараметрыОперации.Ширина;
	Параметры.Высота     = ПараметрыОперации.Высота;
	ДанныеОперации.ТекстHTML = ПостроитьHTMLПоШаблону(ПараметрыПодключения, Параметры);

КонецПроцедуры

// Формирует HTML-страницу с отображением картинки на дисплее покупателя.
// Показывает изображение (base64 или медиафайл) и сопроводительный текст.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (картинка, медиафайлы, текст).
//
Процедура ПостроитьСтраницуКартинка(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	Параметры = ПараметрыШаблона();
	Если ЗначениеЗаполнено(ПараметрыОперации.КартинкаBase64) Тогда
		Расширение = ОборудованиеДисплеиПокупателяКлиентСервер.РасширениеМедиафайла(ПараметрыОперации.КартинкаBase64);
		Параметры.Картинка = СтрШаблон("data:image/%1;base64,%2", Расширение, ПараметрыОперации.КартинкаBase64);
	Иначе
		Параметры.Картинка = ПараметрыОперации.Картинка;
	КонецЕсли;
	ЗаполнитьПараметрыШаблонаРекламой(Параметры, ДанныеОперации);
	Параметры.Ширина     = ПараметрыОперации.Ширина;
	Параметры.Высота     = ПараметрыОперации.Высота;
	ДанныеОперации.ТекстHTML = ПостроитьHTMLКартинкаПоШаблону(ПараметрыПодключения, Параметры);
	
КонецПроцедуры

// Формирует HTML-страницу «Фискальный чек» для дисплея покупателя.
// Отображает благодарность за покупку, QR-код чека для сканирования в мобильном приложении
// и кнопку печати копии чека (через «Мой Налог»).
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (QR-код чека, размер шрифта).
//
Процедура ПостроитьСтраницуФискальныйЧек(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	Параметры = ПараметрыШаблона();
	Если ЗначениеЗаполнено(ПараметрыОперации.ЗначениеQRКода) Тогда
		Размер = 400;
		КартинкаBase64 = КартинкаQRКодаBase64(ПараметрыОперации.ЗначениеQRКода, Размер);
		Параметры.QRКод = СтрШаблон("data:image/png;base64,%1", КартинкаBase64);
	КонецЕсли;

	Параметры.Заголовок = НСтр("ru='Получите электронный чек'");
	Параметры.Операция = НСтр("ru='СПАСИБО ЗА ПОКУПКУ'");
	Параметры.Описание = НСтр("ru='Сканируйте QR-код в мобильном приложении'");
	Параметры.ОсновнойЦвет = ЦветаШаблона().Оранжевый;
	
	ДисплейОтрабатываетНажатия = ПараметрыПодключения.ДисплейОтрабатываетНажатия;
	Если ДисплейОтрабатываетНажатия  Тогда
		ИмяФайла = "print.png";
		Параметры.КнопкаПечать = ИмяФайла;
		ДобавитьМедиафайл(ДанныеОперации, ИмяФайла);
	Иначе
		Если ПараметрыОперации.ВыводитьQRКодДляАлкоголя Тогда
			Параметры.ПриложениеМойНалогИАТК = Истина;
			ИмяФайла = "block_my_apps.png";
		Иначе
			Параметры.ПриложениеМойНалог = Истина;
			ИмяФайла = "block_my_tax.png";
		КонецЕсли;
		ДобавитьМедиафайл(ДанныеОперации, ИмяФайла);
	КонецЕсли;
	
	ЗаполнитьПараметрыШаблонаРекламой(Параметры, ДанныеОперации);
	Параметры.Ширина     = ПараметрыОперации.Ширина;
	Параметры.Высота     = ПараметрыОперации.Высота;
	ДанныеОперации.ТекстHTML = ПостроитьHTMLПоШаблону(ПараметрыПодключения, Параметры);

КонецПроцедуры

// Формирует HTML-страницу платёжной операции для дисплея покупателя.
// Отображает статус платежа (успешно, ожидание, отказ), тип оплаты (наличная/безналичная),
// сумму или сдачу, а также QR-код для оплаты через СБП или ЮКассу.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (тип платёжной системы, сумма, QR-код).
//
Процедура ПостроитьСтраницуПлатежнаяОперация(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	Параметры = ПараметрыШаблона();
	Параметры.Операция = ТекстСтатуса(ПараметрыОперации);
	Параметры.Заголовок = ТекстТипаПлатежнойСистемы(ПараметрыОперации);
	СтатусОперации = ПараметрыОперации.СтатусОперации;
	Параметры.СтатусОперации = СтатусОперации;
	Если СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации Тогда
		Параметры.Комментарий = ПоясняющийТекстПлатежнойСтраницы(ПараметрыОперации.ТипПлатежнойСистемы);
	КонецЕсли;

	Если ПоказыватьQRКодНаПлатежнойСтранице(ПараметрыОперации) Тогда
		Размер = 300;
		КартинкаBase64 = КартинкаQRКодаBase64(ПараметрыОперации.ЗначениеQRКода, Размер);
		Параметры.QRКод = СтрШаблон("data:image/png;base64,%1", КартинкаBase64);
	КонецЕсли;
	ПодготовитьОписаниеПлатежнойСтраницы(Параметры, ПараметрыПодключения, ПараметрыОперации);
	
	// добавить статус операции
	ИмяФайла = Перечисления.СтатусОперацииНаДисплее.ИмяФайлаИконкиСтатуса(Параметры.СтатусОперации);
	ДобавитьМедиафайл(ДанныеОперации, ИмяФайла);
	
	Параметры.ОсновнойЦвет = ЦветПоСтатусу(Параметры.СтатусОперации);
	ЗаполнитьПараметрыШаблонаРекламой(Параметры, ДанныеОперации);
	Параметры.Ширина     = ПараметрыОперации.Ширина;
	Параметры.Высота     = ПараметрыОперации.Высота;
	ДанныеОперации.ТекстHTML = ПостроитьHTMLПоШаблону(ПараметрыПодключения, Параметры);

КонецПроцедуры


Функция ПоказыватьQRКодНаПлатежнойСтранице(Знач ПараметрыОперации)

	Если ПараметрыОперации.СтатусОперации <> Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПараметрыОперации.ЗначениеQRКода) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипПлатежнойСистемы = ПараметрыОперации.ТипПлатежнойСистемы;
	Возврат ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.СистемаБыстрыхПлатежей
		Или ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.ЮКасса
		Или ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.СертификатНСПК;

КонецФункции

Функция ПоясняющийТекстПлатежнойСтраницы(Знач ТипПлатежнойСистемы)

	Если ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.СистемаБыстрыхПлатежей Тогда
		Возврат НСтр("ru='Для совершения платежа отсканируйте QR-код'");
	ИначеЕсли ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.ЮКасса Тогда
		Возврат НСтр("ru='Для входа в личный кабинет отсканируйте QR-код'");
	ИначеЕсли ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.СертификатНСПК Тогда
		Возврат НСтр("ru = 'Предъявите карту ""МИР"" для операции'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Процедура ПодготовитьОписаниеПлатежнойСтраницы(Параметры, Знач ПараметрыПодключения, Знач ПараметрыОперации)

	Если Не ПустаяСтрока(ПараметрыОперации.ДополнительныйТекст) Тогда
		Параметры.Описание = ПараметрыОперации.ДополнительныйТекст;
		Возврат;
	КонецЕсли;

	ФорматЧислаСтраницы = ФорматЧисла(ПараметрыПодключения.ДисплейОтображаетHTML);
	Если ВывестиСдачу(ПараметрыОперации) Тогда
		Параметры.Описание = НСтр("ru='СДАЧА'");
		Параметры.Информация = Формат(ПараметрыОперации.Сдача, ФорматЧислаСтраницы);
	Иначе
		Параметры.Описание = НСтр("ru='СУММА'");
		Параметры.Информация = Формат(ПараметрыОперации.Сумма, ФорматЧислаСтраницы);
	КонецЕсли;


КонецПроцедуры

// Формирует HTML-страницу со списком товаров в виде таблицы для дисплея покупателя.
// Строит таблицу с настраиваемыми колонками (наименование, цена, количество, скидка и т.д.),
// выделяет последнюю строку, выводит подвал с итогом и скидкой.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (табличная часть, колонки, подвал).
//
Процедура ПостроитьСтраницуСписокТоваров(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	ПараметрыШаблона = ПараметрыШаблонаТовары();
	ПараметрыШаблона.ОсновнойЦвет = ЦветаШаблона().Зеленый;
	ПараметрыШаблона.Высота = ПараметрыОперации.Высота;
	ПараметрыШаблона.Ширина = ПараметрыОперации.Ширина;
	ПараметрыШаблона.ПодвалСумма = ПараметрыОперации.ПодвалСумма;
	ПараметрыШаблона.ПодвалСкидка = ПараметрыОперации.ПодвалСкидка;
	ПараметрыШаблона.КолонкиТабличнойЧасти = ПараметрыОперации.КолонкиТабличнойЧасти;
	ПараметрыШаблона.ТабличнаяЧасть = ПараметрыОперации.ТабличнаяЧасть;
	
	ЗаполнитьПараметрыШаблонаРекламой(ПараметрыШаблона, ДанныеОперации);
	
	ТекстHTML = ПостроитьHTMLТаблицуТоваровПоШаблону(ПараметрыПодключения, ПараметрыШаблона );
	
	ДанныеОперации.ТекстHTML = ТекстHTML;
	
КонецПроцедуры

// Формирует HTML-страницу корзины покупок для дисплея покупателя.
// Использует DOM-манипуляции с шаблоном чека: добавляет заголовки, строки товаров,
// итоги (количество позиций, сумма), рекламный блок и учитывает ориентацию экрана.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ДанныеОперации       - Структура - данные операции, заполняются HTML-текстом.
//  ПараметрыОперации    - Структура - параметры операции (корзина, реклама, размеры экрана).
//
Процедура ПостроитьСтраницуКорзина(Знач ПараметрыПодключения, Знач ДанныеОперации, Знач ПараметрыОперации)

	ПараметрыШаблона = ПараметрыШаблонаТовары();
	ПараметрыШаблона.ОсновнойЦвет = ЦветаШаблона().Зеленый;
	ПараметрыШаблона.Корзина = ПараметрыОперации.Корзина;
	ПараметрыШаблона.ПодвалСумма = ПараметрыОперации.ПодвалСумма;
	ПараметрыШаблона.Высота = ПараметрыОперации.Высота;
	ПараметрыШаблона.Ширина = ПараметрыОперации.Ширина;
	ПараметрыШаблона.ЗаголовокПроизвольнойКолонки = ПараметрыОперации.ЗаголовокПроизвольнойКолонки;

	ПараметрыШаблона.КорзинаШапкаЦвет = ДанныеОперации.КорзинаШапкаЦвет;
	ПараметрыШаблона.КорзинаПодвалЦвет = ДанныеОперации.КорзинаПодвалЦвет;
	ПараметрыШаблона.КорзинаПризвольнаяКолонкаЦвет = ДанныеОперации.КорзинаПризвольнаяКолонкаЦвет;
	ПараметрыШаблона.ЕстьСкидка = ДанныеОперации.КорзинаОтображатьСкидку;
	ПараметрыШаблона.ЕстьПроизвольнаяКолонка = ДанныеОперации.КорзинаОтображатьПроизвольнуюКолонку;
	
	ЗаполнитьПараметрыШаблонаРекламой(ПараметрыШаблона, ДанныеОперации);
	
	ТекстHTML = ПостроитьHTMLКорзинаПоШаблону(ПараметрыПодключения, ПараметрыШаблона);
	
	ДанныеОперации.ТекстHTML = ТекстHTML;

КонецПроцедуры

#КонецОбласти

#Область ФормированиеHTML

// Создает рекламный блок в макете дисплея покупателя и корректирует размеры контентной области.
// Если реклама не задана, блок не создается.
// После выполнения обновляет ПараметрыШаблона.Ширина/Высота под фактический размер контентной зоны.
//
// Параметры:
//  ОберткаМакета    - УзелDOM    - элемент div.layout-wrapper.
//  БлокСодержимое   - УзелDOM    - элемент div.content-panel.
//  ПараметрыШаблона - Структура  - параметры шаблона (ИндексТекущейРекламы, РасположениеРекламы,
//                                  ПроцентРекламы, Реклама, Ширина, Высота).
//
Процедура УстановитьРекламу(ОберткаМакета, БлокСодержимое, ПараметрыШаблона)

	КартинкаРеклама = КартинкаРекламыИзПараметровШаблона(ПараметрыШаблона);
	Если ПустаяСтрока(КартинкаРеклама) Тогда
		Возврат;
	КонецЕсли;

	РасположениеРекламы = ПараметрыШаблона.РасположениеРекламы;
	Если ПустаяСтрока(РасположениеРекламы) Тогда
		РасположениеРекламы = РасположениеРекламыПоУмолчанию(ПараметрыШаблона.Ширина, ПараметрыШаблона.Высота);
	КонецЕсли;

	ПроцентРекламы = ПараметрыШаблона.ПроцентРекламы;
	Если Не ЗначениеЗаполнено(ПроцентРекламы) ИЛИ ПроцентРекламы = 0 Тогда
		ПроцентРекламы = ПроцентРекламыПоУмолчанию(РасположениеРекламы);
	КонецЕсли;

	ПрПроцент = Формат(ПроцентРекламы, "ЧГ=0") + "%";
	СтилиРекламы = СтилиРасположенияРекламы(РасположениеРекламы, ПрПроцент);

	БлокСодержимое.УстановитьАтрибут("style", СтилиРекламы.СтильСодержимого);
	БлокРекламы = НовыйУзел(ОберткаМакета, "div", "ad-panel");
	БлокРекламы.УстановитьАтрибут("style", СтилиРекламы.СтильБлока);
	НовыйУзел(БлокРекламы, "img").Источник = КартинкаРеклама;

	ОбновитьРазмерыПодРекламу(РасположениеРекламы, ПроцентРекламы, ПараметрыШаблона);

КонецПроцедуры

// Возвращает картинку текущего рекламного элемента из параметров HTML-шаблона.
//
// Параметры:
//  ПараметрыШаблона - Структура - параметры HTML-шаблона с массивом Реклама
//                     и индексом текущей рекламы.
//
// Возвращаемое значение:
//  Строка, Структура - имя файла, структура картинки или пустая строка,
//  если реклама не задана.
//
Функция КартинкаРекламыИзПараметровШаблона(ПараметрыШаблона)

	Если Не ПараметрыШаблона.Свойство("Реклама")
		Или ТипЗнч(ПараметрыШаблона.Реклама) <> Тип("Массив")
		Или ПараметрыШаблона.Реклама.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ИндексТекущейРекламы = 0;
	Если ПараметрыШаблона.Свойство("ИндексТекущейРекламы")
		И ТипЗнч(ПараметрыШаблона.ИндексТекущейРекламы) = Тип("Число") Тогда
		ИндексТекущейРекламы = ПараметрыШаблона.ИндексТекущейРекламы;
	КонецЕсли;
	Если ИндексТекущейРекламы < 0
		Или ИндексТекущейРекламы >= ПараметрыШаблона.Реклама.Количество() Тогда
		ИндексТекущейРекламы = 0;
	КонецЕсли;

	Возврат КартинкаРекламыИзЭлемента(ПараметрыШаблона.Реклама[ИндексТекущейРекламы]);

КонецФункции

Функция РасположениеРекламыПоУмолчанию(Ширина, Высота)
	Если ЗначениеЗаполнено(Ширина) И ЗначениеЗаполнено(Высота) И Ширина > Высота Тогда
		Возврат "Справа";
	КонецЕсли;
	Возврат "Снизу";
КонецФункции

Функция ПроцентРекламыПоУмолчанию(РасположениеРекламы)
	ПроцентБоковойРекламы   = 30;
	ПроцентВертикальнойРекламы = 25;
	Если РасположениеРекламы = "Справа" ИЛИ РасположениеРекламы = "Слева" Тогда
		Возврат ПроцентБоковойРекламы;
	КонецЕсли;
	Возврат ПроцентВертикальнойРекламы;
КонецФункции

Функция СтилиРасположенияРекламы(РасположениеРекламы, ПрПроцент)
	Если РасположениеРекламы = "Справа" Тогда
		СтильСодержимого = "right:" + ПрПроцент;
		СтильБлока = "position:absolute;top:0;right:0;bottom:0;width:" + ПрПроцент;
	ИначеЕсли РасположениеРекламы = "Слева" Тогда
		СтильСодержимого = "left:" + ПрПроцент;
		СтильБлока = "position:absolute;top:0;left:0;bottom:0;width:" + ПрПроцент;
	ИначеЕсли РасположениеРекламы = "Сверху" Тогда
		СтильСодержимого = "top:" + ПрПроцент;
		СтильБлока = "position:absolute;top:0;left:0;right:0;height:" + ПрПроцент;
	Иначе // Снизу
		СтильСодержимого = "bottom:" + ПрПроцент;
		СтильБлока = "position:absolute;left:0;right:0;bottom:0;height:" + ПрПроцент;
	КонецЕсли;
	Возврат Новый Структура("СтильСодержимого, СтильБлока", СтильСодержимого, СтильБлока);
КонецФункции

Процедура ОбновитьРазмерыПодРекламу(РасположениеРекламы, ПроцентРекламы, ПараметрыШаблона)
	Ширина = ПараметрыШаблона.Ширина;
	Высота = ПараметрыШаблона.Высота;
	Если Не (ЗначениеЗаполнено(Ширина) И ЗначениеЗаполнено(Высота)) Тогда
		Возврат;
	КонецЕсли;
	СтоПроцентов = 100;
	ДоляСодержимого = (СтоПроцентов - ПроцентРекламы) / СтоПроцентов;
	Если РасположениеРекламы = "Справа" ИЛИ РасположениеРекламы = "Слева" Тогда
		ПараметрыШаблона.Ширина = Окр(Ширина * ДоляСодержимого, 0);
	Иначе
		ПараметрыШаблона.Высота = Окр(Высота * ДоляСодержимого, 0);
	КонецЕсли;
КонецПроцедуры

// Формирует HTML по стандартному шаблону дисплея покупателя.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства. Используется поле
//                                  ДисплейОтрабатываетНажатия.
//  ПараметрыШаблона     - Структура - параметры заполнения шаблона, см. ПараметрыШаблона().
//
// Возвращаемое значение:
//  Строка - HTML-код страницы дисплея покупателя.
//
Функция ПостроитьHTMLПоШаблону(ПараметрыПодключения, ПараметрыШаблона)

	Шаблон = ПолучитьОбщийМакет("ШаблонДисплеяПокупателя");
	Документ = Шаблон.ПолучитьДокументHTML();

	ОберткаМакета  = ПостроитьОсновнойМакет(Документ);
	БлокСодержимое = НовыйУзел(ОберткаМакета, "div", "content-panel");
	НовыйУзел(БлокСодержимое, "div", "header", ПараметрыШаблона.Заголовок);
	БлокОсновной = НовыйУзел(БлокСодержимое, "div", "main");

	ДобавитьСтиль(ПараметрыШаблона, ".title-block", "padding:1%; font-size:var(--font-size-medium)");
	ДобавитьСтиль(ПараметрыШаблона, ".desc-block", "padding:1%; font-size:var(--font-size-medium)");
	ДобавитьСтиль(ПараметрыШаблона, ".info-block", 
		"padding:1%; font-size:var(--font-size-large); color:var(--text-color)");
	ДобавитьСтиль(ПараметрыШаблона, ".comment-block", "padding:1%; font-size:var(--font-size-small)");

	ДобавитьТекстовыйУзел(БлокОсновной, "title-block", ПараметрыШаблона.ЗаголовокСтраницы);
	Если ЗначениеЗаполнено(ПараметрыШаблона.QRКод) Тогда
		ДобавитьСтиль(ПараметрыШаблона, ".img-block img", "width:20%");
		ДобавитьУзелИзображения(БлокОсновной, "img-block", ПараметрыШаблона.QRКод);
	ИначеЕсли ЗначениеЗаполнено(ПараметрыШаблона.Картинка) Тогда
		ДобавитьСтиль(ПараметрыШаблона, ".img-block img", "width:auto;height:auto");
		ДобавитьУзелИзображения(БлокОсновной, "img-block", ПараметрыШаблона.Картинка);
	Иначе
		ДобавитьСтиль(ПараметрыШаблона, ".img-block img", "width:30%");
		ИмяФайла = Перечисления.СтатусОперацииНаДисплее.ИмяФайлаИконкиСтатуса(ПараметрыШаблона.СтатусОперации);
		ДобавитьУзелИзображения(БлокОсновной, "img-block", ИмяФайла);
	КонецЕсли;
	ДобавитьТекстовыйУзел(БлокОсновной, "desc-block", ПараметрыШаблона.Описание);
	ДобавитьТекстовыйУзел(БлокОсновной, "info-block", ПараметрыШаблона.Информация);
	ДобавитьТекстовыйУзел(БлокОсновной, "comment-block", ПараметрыШаблона.Комментарий);
	
	Если ПараметрыШаблона.ПриложениеМойНалогИАТК ТОгда
		ДобавитьСтиль(ПараметрыШаблона, ".my-tax-block img", "width:80%");
		ДобавитьУзелИзображения(БлокОсновной, "my-tax-block", "block_my_apps.png");
	ИначеЕсли ПараметрыШаблона.ПриложениеМойНалог Тогда
		ДобавитьСтиль(ПараметрыШаблона, ".my-tax-block img", "width:50%");
		ДобавитьУзелИзображения(БлокОсновной, "my-tax-block", "block_my_tax.png");
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыШаблона.КнопкаПечать) Тогда
		КнопкаЧека = ОборудованиеДисплеиПокупателяКлиентСервер.КнопкаДисплеяПокупателя("PrintCheque", "");
		КнопкаЧека.Картинка = ПараметрыШаблона.КнопкаПечать;
		Кнопки = ОбщегоНазначенияБПОКлиентСервер.ЗначениеВМассиве(КнопкаЧека);
		ДобавитьСтиль(ПараметрыШаблона, ".print-cheque-block button", "padding:3%; width: 30%");
		ДобавитьУзелКнопок(БлокОсновной, "print-cheque-block", Кнопки);
	КонецЕсли;

	Если ПараметрыПодключения.ДисплейОтрабатываетНажатия И ПараметрыШаблона.Кнопки.Количество() > 0 Тогда
		СтильТекстовойКнопки = 
			"margin: 4% 2%; padding:2%; font-size:var(--font-size-medium); background-color: var(--bg-button);";
		ДобавитьСтиль(ПараметрыШаблона, ".buttons-block button", СтильТекстовойКнопки);
		ДобавитьУзелКнопок(БлокОсновной, "buttons-block", ПараметрыШаблона.Кнопки);
	КонецЕсли;
	
	НовыйУзел(БлокСодержимое, "div", "footer", ПараметрыШаблона.Операция);
	
	УстановитьРекламу(ОберткаМакета, БлокСодержимое, ПараметрыШаблона);

	СформироватьСтили(Документ, ПараметрыШаблона);

	Возврат ЗавершитьПостроениеHTML(Документ);

КонецФункции

// Формирует HTML страницы с изображением по шаблону дисплея покупателя.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ПараметрыШаблона     - Структура - параметры заполнения шаблона, см. ПараметрыШаблона().
//
// Возвращаемое значение:
//  Строка - HTML-код страницы дисплея покупателя.
//
Функция ПостроитьHTMLКартинкаПоШаблону(ПараметрыПодключения, ПараметрыШаблона)

	Шаблон = ПолучитьОбщийМакет("ШаблонДисплеяПокупателя");
	Документ = Шаблон.ПолучитьДокументHTML();
	ОберткаМакета  = ПостроитьОсновнойМакет(Документ);
	Содержимое     = НовыйУзел(ОберткаМакета, "div", "content-panel");
	ДобавитьСтиль(ПараметрыШаблона, ".main", "top:0; bottom:0");
	ОсновнойБлок = НовыйУзел(Содержимое, "main");

	Если Не ПустаяСтрока(ПараметрыШаблона.Картинка) Тогда
		Высота = Формат(ПараметрыШаблона.Высота, "ЧГ=0");
		ДобавитьСтиль(ПараметрыШаблона, ".img-block img", СтрШаблон("width:auto; max-height:%1px", Высота));
		ДобавитьСтиль(ПараметрыШаблона, ".img-block", "text-align: center");
		ДобавитьУзелИзображения(ОсновнойБлок, "img-block", ПараметрыШаблона.Картинка);
	КонецЕсли;

	УстановитьРекламу(ОберткаМакета, Содержимое, ПараметрыШаблона);

	СформироватьСтили(Документ, ПараметрыШаблона);

	Возврат ЗавершитьПостроениеHTML(Документ);

КонецФункции

// Формирует HTML страницы корзины по шаблону дисплея покупателя.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ПараметрыШаблона     - Структура - параметры шаблона корзины, см. ПараметрыШаблонаТовары().
//
// Возвращаемое значение:
//  Строка - HTML-код страницы корзины.
//
Функция ПостроитьHTMLКорзинаПоШаблону(ПараметрыПодключения, ПараметрыШаблона)

	ЦветШапки = HTMLЦветИзЗначенияШаблона(ПараметрыШаблона.КорзинаШапкаЦвет);
	ЦветПодвала = HTMLЦветИзЗначенияШаблона(ПараметрыШаблона.КорзинаПодвалЦвет);
	ЦветПроизвольнойКолонки = HTMLЦветИзЗначенияШаблона(ПараметрыШаблона.КорзинаПризвольнаяКолонкаЦвет);
	Если ПустаяСтрока(ЦветШапки) Тогда
		ЦветШапки = "var(--color)";
	КонецЕсли;
	Если ПустаяСтрока(ЦветПодвала) Тогда
		ЦветПодвала = "var(--color)";
	КонецЕсли;

	// Общий размер и выравнивание колонок
	ДобавитьСтиль(ПараметрыШаблона, ".left", "width: 2%; text-align: center");
	ДобавитьСтиль(ПараметрыШаблона, ".image", "width: 15%; text-align: center");
	ДобавитьСтиль(ПараметрыШаблона, ".title", "width: auto; text-align: left");
	ДобавитьСтиль(ПараметрыШаблона, ".tag", "width: 5%;  text-align: right");
	ДобавитьСтиль(ПараметрыШаблона, ".price", "width: 10%; text-align: right");
	ДобавитьСтиль(ПараметрыШаблона, ".qty", "width: 8%;  text-align: right");
	ДобавитьСтиль(ПараметрыШаблона, ".discount", "width: 7%;  text-align: right");
	ДобавитьСтиль(ПараметрыШаблона, ".total", "width: 8%; text-align: right");
	ДобавитьСтиль(ПараметрыШаблона, ".right", "width: 2%; text-align: center");

	// заголовок таблицы
	Стили = Новый Массив;
	Стили.Добавить("background: " + ЦветШапки + "; color: white");
	Стили.Добавить("font-size: var(--font-size-medium)");
	Стили.Добавить("height: 3rem");
	Стили.Добавить("padding: 1%");
	ДобавитьСтиль(ПараметрыШаблона, ".cart-caption", СтрСоединить(Стили, ";"));
	
	// Первая и следующие стили строк
	ДобавитьСтиль(ПараметрыШаблона, ".first", "height:6rem; font-size: 1em;");
	ДобавитьСтиль(ПараметрыШаблона, ".next", "height:4rem; font-size: 0.7em;");
	// стили строк корректирующие общие колонки
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row", "");
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row td", "padding:2%;");
	ДобавитьСтиль(ПараметрыШаблона, ".first .image img", " width: 100%;");
	ДобавитьСтиль(ПараметрыШаблона, ".next .image img", " width: 30%;");
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row .title", "text-align:left;");
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row .description", "text-align:left; color: grey;");
	СтильПроизвольнойКолонки = "text-align:right";
	Если Не ПустаяСтрока(ЦветПроизвольнойКолонки) Тогда
		СтильПроизвольнойКолонки = СтильПроизвольнойКолонки + "; color: " + ЦветПроизвольнойКолонки;
	КонецЕсли;
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row .tag", СтильПроизвольнойКолонки);
	ДобавитьСтиль(ПараметрыШаблона, ".cart-row .discount","text-align:right; "); //color:red;

	// Стили блока итогов
	Стили = Новый Массив;
	Стили.Добавить("position: absolute; bottom:0");
	//Стили.Добавить("left: 5%; right: 5%; padding: 1%");
	Стили.Добавить("background: " + ЦветПодвала);
	Стили.Добавить("width:100%; left: 0; right: 0; bottom: 0;");
	Стили.Добавить("color: white");
	Стили.Добавить("font-size:var(--font-size-large)");
	ДобавитьСтиль(ПараметрыШаблона, ".cart-summary", СтрСоединить(Стили, ";"));
	
	ДобавитьСтиль(ПараметрыШаблона, ".cart-summary table", "width:100%;");
	
	ДобавитьСтиль(ПараметрыШаблона, ".cart-summary td", "margin: 2% 1%");

	// Программное построение DOM-структуры
	Шаблон = ПолучитьОбщийМакет("ШаблонДисплеяПокупателяЧек");
	Документ = Шаблон.ПолучитьДокументHTML();

	ОберткаМакета  = ПостроитьОсновнойМакет(Документ);
	Содержимое     = НовыйУзел(ОберткаМакета, "div", "content-panel");

	Узел = НовыйУзел(Содержимое, "div", "main");
	УзелТаблица = НовыйУзел(Узел, "table");

	ДобавитьЗаголовкиКорзины(УзелТаблица, ПараметрыШаблона);
	ДобавитьСтрокиКорзины(УзелТаблица, ПараметрыШаблона);
	ДобавитьСводкуКорзины(Содержимое, ПараметрыШаблона);

	УстановитьРекламу(ОберткаМакета, Содержимое, ПараметрыШаблона);

	СтильСкрытойКолонки = "display: none;";
	Если Не ПараметрыШаблона.ЕстьФото Тогда
		ДобавитьСтиль(ПараметрыШаблона, "th.image, td.image", СтильСкрытойКолонки);
	КонецЕсли;
	Если Не ПараметрыШаблона.ЕстьСкидка Тогда
		ДобавитьСтиль(ПараметрыШаблона, "th.discount, td.discount", СтильСкрытойКолонки);
	КонецЕсли;
	
	Если Не ПараметрыШаблона.ЕстьПроизвольнаяКолонка Тогда
		ДобавитьСтиль(ПараметрыШаблона, "th.tag, td.tag", СтильСкрытойКолонки);
	КонецЕсли;
	
	
	
	СформироватьСтили(Документ, ПараметрыШаблона);

	Возврат ЗавершитьПостроениеHTML(Документ);

КонецФункции

// Формирует HTML страницы списка товаров по шаблону дисплея покупателя.
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения устройства.
//  ПараметрыШаблона     - Структура - параметры шаблона списка товаров, см. ПараметрыШаблонаТовары().
//
// Возвращаемое значение:
//  Строка - HTML-код страницы списка товаров.
//
Функция ПостроитьHTMLТаблицуТоваровПоШаблону(ПараметрыПодключения, ПараметрыШаблона)

	ДополнительныеСтили = Новый Соответствие;
	
	Стили = Новый Массив;
	Стили.Добавить("background: var(--color); color: white");
	Стили.Добавить("font-size: var(--font-size-large)");
	Стили.Добавить("height: 3rem");
	Стили.Добавить("padding: 1%");
	ДополнительныеСтили.Вставить(".cart-caption", СтрСоединить(Стили, ";"));
	ДополнительныеСтили.Вставить(".tnb td", "padding: 15px;");

	Шаблон = ПолучитьОбщийМакет("ШаблонДисплеяПокупателяЧек");
	Документ = Шаблон.ПолучитьДокументHTML();

	ОберткаМакета  = ПостроитьОсновнойМакет(Документ);
	Содержимое     = НовыйУзел(ОберткаМакета, "div", "content-panel");
	Узел = НовыйУзел(Содержимое, "div", "header");
	ДобавитьЗаголовкиСпискаТоваров(Узел, ПараметрыШаблона);
	Узел = НовыйУзел(Содержимое, "div", "main-table");
	ДобавитьСтрокиСпискаТоваров(Узел, ПараметрыШаблона);
	Узел = НовыйУзел(Содержимое, "div", "footer");
	ДобавитьПодвалСпискаТоваров(Узел, ПараметрыШаблона);

	УстановитьРекламу(ОберткаМакета, Содержимое, ПараметрыШаблона);

	СформироватьСтили(Документ, ПараметрыШаблона);
	
	Возврат ЗавершитьПостроениеHTML(Документ);

КонецФункции

// Преобразует DOM-документ в HTML-строку и применяет общий размер базового шрифта.
//
// Параметры:
//  Документ - ДокументDOM - заполненный HTML-документ.
//
// Возвращаемое значение:
//  Строка - HTML-код страницы дисплея покупателя.
//
Функция ЗавершитьПостроениеHTML(Документ)
	
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	ЗаписьDOM = Новый ЗаписьDOM();
	ЗаписьDOM.Записать(Документ, ЗаписьHTML);
	Возврат ЗаписьHTML.Закрыть();
	
КонецФункции


#КонецОбласти

#Область Корзина

// Добавляет заголовок таблицы корзины.
//
// Параметры:
//  УзелТаблица       - ЭлементDOM - узел таблицы корзины.
//  ПараметрыШаблона  - Структура  - параметры шаблона корзины, см. ПараметрыШаблонаТовары().
//
Процедура ДобавитьЗаголовкиКорзины(Знач УзелТаблица, Знач ПараметрыШаблона)

	УзелЗаголовок = НовыйУзел(УзелТаблица, "thead tr", "cart-caption");
	НовыйУзел(УзелЗаголовок, "th", "left");
	НовыйУзел(УзелЗаголовок, "th", "image");
	НовыйУзел(УзелЗаголовок, "th", "title", НСтр("ru = 'Наименование'"));
	НовыйУзел(УзелЗаголовок, "th", "tag", ПараметрыШаблона.ЗаголовокПроизвольнойКолонки);
	НовыйУзел(УзелЗаголовок, "th", "price", НСтр("ru = 'Цена'"));
	НовыйУзел(УзелЗаголовок, "th", "qty", НСтр("ru = 'Кол-во'"));
	НовыйУзел(УзелЗаголовок, "th", "discount", НСтр("ru = 'Скидка'"));
	НовыйУзел(УзелЗаголовок, "th", "total", НСтр("ru = 'Сумма'"));
	НовыйУзел(УзелЗаголовок, "th", "right");

КонецПроцедуры

// Добавляет строки корзины в таблицу.
// Последняя строка корзины выводится первой.
//
// Параметры:
//  УзелТаблица       - ЭлементDOM - узел таблицы корзины.
//  ПараметрыШаблона  - Структура  - параметры шаблона корзины. Используются поля
//                                  Корзина, ЕстьФото и ЕстьСкидка.
//
Процедура ДобавитьСтрокиКорзины(Знач УзелТаблица, Знач ПараметрыШаблона)

	Корзина = ПараметрыШаблона.Корзина;
	УзелТело = НовыйУзел(УзелТаблица, "tbody");
	Если Корзина.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По Корзина.ВГраница() Цикл
		
		СтрокаКорзины = Корзина.Получить(Корзина.ВГраница() - Индекс);
		
		Если Индекс = 0 Тогда
			УзелСтрока = НовыйУзел(УзелТело, "tr", "cart-row first");
		Иначе
			УзелСтрока = НовыйУзел(УзелТело, "tr", "cart-row next");
		КонецЕсли;
		
		Узел = НовыйУзел(УзелСтрока, "td", "left");
		Узел = НовыйУзел(УзелСтрока, "td", "image");
		Узел = НовыйУзел(Узел, "div img");
		Если ЗначениеЗаполнено(СтрокаКорзины.Фото) Тогда
			Узел.Источник = СтрокаКорзины.Фото;
			ПараметрыШаблона.ЕстьФото = Истина;
		КонецЕсли;
		
		УзелИнфо = НовыйУзел(УзелСтрока, "td", "info");
		Узел = НовыйУзел(УзелИнфо, "div", "title", СтрокаКорзины.Наименование);
		Узел = НовыйУзел(УзелИнфо, "div", "description", СтрокаКорзины.Описание);
		
		Узел = НовыйУзел(УзелСтрока, "td", "tag", СтрокаКорзины.ПроизвольнаяКолонка);
		Узел = НовыйУзел(УзелСтрока, "td", "price", СтрокаКорзины.Цена);
		Узел = НовыйУзел(УзелСтрока, "td", "qty", СтрокаКорзины.Количество);
		Узел = НовыйУзел(УзелСтрока, "td", "discount", СтрокаКорзины.Скидка);
		Узел = НовыйУзел(УзелСтрока, "td", "total", СтрокаКорзины.Сумма);
		Узел = НовыйУзел(УзелСтрока, "td", "right");

	КонецЦикла;

КонецПроцедуры

// Добавляет блок итоговой суммы корзины.
//
// Параметры:
//  Контейнер         - ЭлементDOM - контейнер, в который добавляется блок итогов.
//  ПараметрыШаблона  - Структура  - параметры шаблона корзины. Используются поля
//                                  Корзина и ПодвалСумма.
//
Процедура ДобавитьСводкуКорзины(Контейнер, ПараметрыШаблона)

	ТекстИтого = Формат(ПараметрыШаблона.ПодвалСумма, "ЧДЦ=2");
	
	Узел = НовыйУзел(Контейнер, "div", "cart-summary");
	УзелСтрока = НовыйУзел(Узел, "table tbody tr");
	
	Узел = НовыйУзел(УзелСтрока, "td", "left");
	Узел = НовыйУзел(УзелСтрока, "td", "image");
	Узел = НовыйУзел(УзелСтрока, "td", "title", НСтр("ru='Всего на сумму'"));
	Узел.УстановитьАтрибут("colspan", "3");
	Узел = НовыйУзел(УзелСтрока, "td", "qty");
	Узел = НовыйУзел(УзелСтрока, "td", "discount");
	Узел = НовыйУзел(УзелСтрока, "td", "total", ТекстИтого);
	Узел = НовыйУзел(УзелСтрока, "td", "right");

КонецПроцедуры

// Добавляет заголовки колонок списка товаров.
//
// Параметры:
//  Узел              - ЭлементDOM - контейнер заголовка списка товаров.
//  ПараметрыШаблона  - Структура  - параметры шаблона списка товаров. Используется поле
//                                  КолонкиТабличнойЧасти.
//
Процедура ДобавитьЗаголовкиСпискаТоваров(Узел, ПараметрыШаблона)

	КолонкиТабличнойЧасти = ПараметрыШаблона.КолонкиТабличнойЧасти;
	
	УзелТаблица = НовыйУзел(Узел, "table", "tnb");
	УзелТаблица.УстановитьАтрибут("width", "100%");
	УзелЗаголовок = НовыйУзел(УзелТаблица, "tr");
	Для Каждого Колонка Из КолонкиТабличнойЧасти Цикл

		Заголовок = ?(ПустаяСтрока(Колонка.Заголовок), Колонка.Имя, Колонка.Заголовок);
		Узел = НовыйУзел(УзелЗаголовок, "th", , Заголовок);
		Узел.УстановитьАтрибут("width", Строка(?(Колонка.Ширина > 0, Колонка.Ширина, 10)) + "%");
		
		АтрибутВыравнивания = "align";
		Если Колонка.Выравнивание = ГоризонтальноеПоложение.Лево Тогда
			Узел.УстановитьАтрибут(АтрибутВыравнивания, "left");
		ИначеЕсли Колонка.Выравнивание = ГоризонтальноеПоложение.Право Тогда
			Узел.УстановитьАтрибут(АтрибутВыравнивания, "right");
		Иначе
			Узел.УстановитьАтрибут(АтрибутВыравнивания, "center");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Добавляет строки списка товаров.
// Последняя строка помечается атрибутом position_anchor.
//
// Параметры:
//  Узел              - ЭлементDOM - контейнер строк списка товаров.
//  ПараметрыШаблона  - Структура  - параметры шаблона списка товаров. Используются поля
//                                  КолонкиТабличнойЧасти и ТабличнаяЧасть.
//
Процедура ДобавитьСтрокиСпискаТоваров(Узел, ПараметрыШаблона)

	КолонкиТабличнойЧасти = ПараметрыШаблона.КолонкиТабличнойЧасти;
	ТабличнаяЧасть = ПараметрыШаблона.ТабличнаяЧасть;

	УзелТаблица = НовыйУзел(Узел, "table", "tnb");
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По ТабличнаяЧасть.ВГраница() Цикл

		СтрокаТабличнойЧасти = ТабличнаяЧасть[Индекс];
		УзелСтрока = НовыйУзел(УзелТаблица, "tr");
		ЭтоПоследняяСтрока = (Индекс = ТабличнаяЧасть.ВГраница());
		Если ЭтоПоследняяСтрока Тогда
			УзелСтрока.УстановитьАтрибут("position_anchor", "true");
			УзелСтрока.УстановитьАтрибут("style", "background: #D5EAFF");
		КонецЕсли;

		Для Каждого Колонка Из КолонкиТабличнойЧасти Цикл
			Значение = Строка(СтрокаТабличнойЧасти[Колонка.Имя]);
			Узел = НовыйУзел(УзелСтрока, "td", "cell", Значение);
			Ширина = Строка(?(Колонка.Ширина > 0, Колонка.Ширина, 10)) + "%";
			Узел.УстановитьАтрибут("width", Ширина);
			
			
			АтрибутВыравнивания = "align";
			Если Колонка.Выравнивание = ГоризонтальноеПоложение.Лево Тогда
				Узел.УстановитьАтрибут(АтрибутВыравнивания, "left");
			ИначеЕсли Колонка.Выравнивание = ГоризонтальноеПоложение.Право Тогда
				Узел.УстановитьАтрибут(АтрибутВыравнивания, "right");
			Иначе
				Узел.УстановитьАтрибут(АтрибутВыравнивания, "center");
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Добавляет подвал списка товаров с итоговой суммой.
//
// Параметры:
//  Узел              - ЭлементDOM - контейнер подвала списка товаров.
//  ПараметрыШаблона  - Структура  - параметры шаблона списка товаров. Используются поля
//                                  ПодвалСумма и ФорматЧисла.
//
Процедура ДобавитьПодвалСпискаТоваров(Узел, ПараметрыШаблона)

	ПодвалСумма = ПараметрыШаблона.ПодвалСумма;
	ФорматЧисла = ПараметрыШаблона.ФорматЧисла;
	
	УзелТаблица = НовыйУзел(Узел, "table", "tnb");
	Узел.УстановитьАтрибут("width", "100%");
	УзелСтрока = НовыйУзел(УзелТаблица, "tr");
	Узел = НовыйУзел(УзелСтрока, "th",, НСтр("ru = 'Итого'"));
	Узел.УстановитьАтрибут("align", "right");
	Узел.УстановитьАтрибут("colspan", "4");
	Узел = НовыйУзел(УзелСтрока, "th",, Формат(ПодвалСумма, ФорматЧисла));
	Узел.УстановитьАтрибут("align", "right");
	Узел.УстановитьАтрибут("width", "15%");
	
КонецПроцедуры

#КонецОбласти

#Область ОперацииDOM

// Создаёт корневой DOM-каркас дисплея покупателя: div.layout-wrapper в теле документа.
// Возвращает узел layout-wrapper, в который вызывающий код добавляет div.content-panel
// через НовыйУзел(ОбёрткаМакета, "div", "content-panel").
//
// Параметры:
//  Документ - ДокументHTML - DOM-документ шаблона.
//
// Возвращаемое значение:
//  УзелDOM - элемент div.layout-wrapper.
//
Функция ПостроитьОсновнойМакет(Документ)
	ЭлементBody = Документ.ПолучитьЭлементыПоИмени("body")[0];
	Возврат НовыйУзел(ЭлементBody, "div", "layout-wrapper");
КонецФункции

Функция НовыйУзел(Знач Контейнер, Знач ТипыУзлов, Знач Класс = "", Знач Значение = "")
	
	Документ = Контейнер.ДокументВладелец;
	
	ТипыУзлов = СтрРазделить(ТипыУзлов, " ");
	Для Каждого ТипУзла Из ТипыУзлов Цикл
		Узел = Документ.СоздатьЭлемент(ТипУзла);
		Контейнер.ДобавитьДочерний(Узел);
		Контейнер = Узел;
	КонецЦикла;
	Если ЗначениеЗаполнено(Класс) Тогда
		Узел.УстановитьАтрибут("class", Класс);
	КонецЕсли;
	Узел.ТекстовоеСодержимое = Строка(Значение);
	
	Возврат Узел;
	
КонецФункции

Процедура ДобавитьТекстовыйУзел(Контейнер, Класс, Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ЧислоСтрок = СтрЧислоСтрок(Текст);
	Если ЧислоСтрок = 1 Тогда
		Узел = НовыйУзел(Контейнер, "div", Класс, Текст);
	Иначе
		Документ = Контейнер.ДокументВладелец;
		Узел = НовыйУзел(Контейнер, "div", Класс);
		Для Индекс = 1 По ЧислоСтрок - 1 Цикл
			Строка = СтрПолучитьСтроку(Текст, Индекс);
			Узел.ДобавитьДочерний(Документ.СоздатьТекстовыйУзел(Строка));
			Узел.ДобавитьДочерний(Документ.СоздатьЭлемент("br"));
		КонецЦикла;
		Строка = СтрПолучитьСтроку(Текст, Индекс);
		Узел.ДобавитьДочерний(Документ.СоздатьТекстовыйУзел(Строка));
	КонецЕсли;
	
КонецПроцедуры

// Добавляет блок изображения в контейнер.
// Если источник не задан, блок не создаётся.
//
// Параметры:
//  Контейнер  - ЭлементDOM - контейнер для добавляемого блока.
//  Класс      - Строка     - CSS-класс блока изображения.
//  Источник   - Строка     - значение свойства src тега img.
//
Процедура ДобавитьУзелИзображения(Контейнер, Класс, Источник)

	Если ПустаяСтрока(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Блок = НовыйУзел(Контейнер, "div", Класс);
	Изображение = НовыйУзел(Блок, "img");
	Изображение.Источник = Источник;

КонецПроцедуры

// Добавляет блок кнопок в контейнер.
// Если массив кнопок пуст, блок не создаётся.
//
// Параметры:
//  Контейнер  - ЭлементDOM - контейнер для добавляемого блока.
//  Класс      - Строка     - CSS-класс блока кнопок.
//  Кнопки     - Массив Из Структура - кнопки, см. КнопкаДисплеяПокупателя().
//
Процедура ДобавитьУзелКнопок(Контейнер, Класс, Кнопки)

	Если Кнопки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПикселейНаСимвол = 30;
	СимволовВКнопке = 10;
	Для Каждого Кнопка Из Кнопки Цикл
		СимволовВКнопке = Макс(СимволовВКнопке, СтрДлина(Кнопка.Наименование));
	КонецЦикла;
	ОптимальнаяШирина = СимволовВКнопке * ПикселейНаСимвол;
	
	Блок = НовыйУзел(Контейнер, "div", Класс);
	Для Каждого Кнопка Из Кнопки Цикл
		Если ПустаяСтрока(Кнопка.Картинка) Тогда
			УзелКнопка = НовыйУзел(Блок, "button", , Кнопка.Наименование);
			УзелКнопка.УстановитьАтрибут("style", СтрШаблон("width:%1px", ОптимальнаяШирина));
		Иначе
			УзелКнопка = НовыйУзел(Блок, "button");
			Изображение = НовыйУзел(УзелКнопка, "img");
			Изображение.Источник = Кнопка.Картинка;
		КонецЕсли;
		УзелКнопка.УстановитьАтрибут("onclick", Кнопка.Идентификатор);
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьСтили(Документ, ПараметрыШаблона)
	
	Стили = Документ.ПолучитьЭлементыПоИмени("style");
	Если Стили.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Стиль = Стили[0];
	ТекстСтиля = Стиль.ТекстовоеСодержимое;
	
	ОсновнойЦвет = ПараметрыШаблона.ОсновнойЦвет;
	АдаптированныйЦвет = АдаптироватьЦвет(ОсновнойЦвет);
	ТекстСтиля = СтрЗаменить(ТекстСтиля, "--color: #000000", СтрШаблон("--color: %1", ОсновнойЦвет));
	ТекстСтиля = СтрЗаменить(ТекстСтиля, 
		"--color-swapped: #000000", 
		СтрШаблон("--color-swapped: %1", АдаптированныйЦвет));
		
	Ширина = ПараметрыШаблона.Ширина;
	Высота = ПараметрыШаблона.Высота;
	Если ЗначениеЗаполнено(Ширина) И ЗначениеЗаполнено(Высота) Тогда
		РазмерШрифта = ОборудованиеДисплеиПокупателяКлиентСервер
			.ВычислитьРазмерБазовогоШрифтаДисплея(Ширина, Высота);
		ТекстСтиля =СтрЗаменить(ТекстСтиля, "--font-size-base: 30px", "--font-size-base: " + РазмерШрифта);
	КонецЕсли;
		
	СтрокиСтилей = Новый Массив;
	СтрокиСтилей.Добавить(ТекстСтиля);
	Для Каждого ДополнительныйСтиль Из ПараметрыШаблона.ДополнительныеСтили Цикл
		
		СтрокаСтиля = СтрШаблон("%1 {%2}", ДополнительныйСтиль.Имя, ДополнительныйСтиль.Значение);
		СтрокиСтилей.Добавить(СтрокаСтиля);
			
	КонецЦикла;
	СтрокиСтилей.Добавить(Символы.ПС);
	Стиль.ТекстовоеСодержимое = СтрСоединить(СтрокиСтилей, Символы.ПС);
	
КонецПроцедуры

#КонецОбласти

// -- НеМобильноеПриложение

#Область ВспомогательныйТекст

// Определяет, нужно ли отображать сдачу на дисплее покупателя.
// Сдача показывается при наличной оплате, если операция выполнена успешно или находится в ожидании,
// и сумма сдачи больше нуля.
//
// Параметры:
//  ПараметрыОперации - Структура - параметры операции (статус, наличная оплата, сдача).
//
// Возвращаемое значение:
//  Булево - Истина, если нужно вывести сдачу.
//
Функция ВывестиСдачу(ПараметрыОперации)

	СтатусОперации = ПараметрыОперации.СтатусОперации;
	Результат = (СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ВыполненоУспешно
		Или СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации);
	Результат = Результат И ПараметрыОперации.НаличнаяОплата И ПараметрыОперации.Сдача > 0;
	Возврат Результат;

КонецФункции

// Возвращает текстовое представление статуса операции для отображения на дисплее.
// Статусы: «УСПЕШНО», «ОТКАЗ», «ОЖИДАНИЕ ОПЛАТЫ», «ОЖИДАНИЕ ВОЗВРАТА ОПЛАТЫ», «ИНФОРМАЦИЯ».
//
// Параметры:
//  ПараметрыОперации - Структура - параметры операции (статус операции, возврат).
//
// Возвращаемое значение:
//  Строка - локализованный текст статуса.
//
Функция ТекстСтатуса(Знач ПараметрыОперации)

	СтатусТекст = "";
	Если ПараметрыОперации.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ВыполненоУспешно Тогда
		СтатусТекст = НСтр("ru='УСПЕШНО'");
	ИначеЕсли ПараметрыОперации.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОперацияНеВыполнена Тогда
		СтатусТекст = НСтр("ru='ОТКАЗ'");
	ИначеЕсли ПараметрыОперации.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации Тогда
		Если ПараметрыОперации.Возврат Тогда
			СтатусТекст = НСтр("ru='ОЖИДАНИЕ ВОЗВРАТА ОПЛАТЫ'");
		Иначе
			СтатусТекст = НСтр("ru='ОЖИДАНИЕ ОПЛАТЫ'");
		КонецЕсли;
	ИначеЕсли ПараметрыОперации.СтатусОперации = Перечисления.СтатусОперацииНаДисплее.Информация Тогда
		СтатусТекст = НСтр("ru='ИНФОРМАЦИЯ'");
	Иначе
		СтатусТекст = "";
	КонецЕсли;
	Возврат СтатусТекст;

КонецФункции

// Возвращает текстовое представление типа платёжной системы для дисплея.
// Определяет текст по виду оплаты: наличная/безналичная, возврат/обычная оплата,
// либо по конкретному типу платёжной системы (СБП, ЮКасса и др.).
//
// Параметры:
//  ПараметрыОперации - Структура - параметры операции (наличная оплата, тип платёжной системы, возврат).
//
// Возвращаемое значение:
//  Строка - локализованный текст типа оплаты («НАЛИЧНАЯ ОПЛАТА», «БЕЗНАЛИЧНЫЙ ВОЗВРАТ» и т.д.).
//
Функция ТекстТипаПлатежнойСистемы(Знач ПараметрыОперации)

	ТипПлатежнойСистемы = "";
	Если ПараметрыОперации.НаличнаяОплата Тогда
		Если ПараметрыОперации.Возврат Тогда
			ТипПлатежнойСистемы = НСтр("ru='НАЛИЧНЫЕ'");
		Иначе
			ТипПлатежнойСистемы = НСтр("ru='НАЛИЧНАЯ ОПЛАТА'");
		КонецЕсли;
	ИначеЕсли Не ПустаяСтрока(ПараметрыОперации.ТипПлатежнойСистемы) Тогда
		ТипПлатежнойСистемы = Строка(ПараметрыОперации.ТипПлатежнойСистемы);
	Иначе
		Если ПараметрыОперации.Возврат Тогда
			ТипПлатежнойСистемы = НСтр("ru='БЕЗНАЛИЧНЫЙ ВОЗВРАТ'");
		Иначе
			ТипПлатежнойСистемы = НСтр("ru='БЕЗНАЛИЧНАЯ ОПЛАТА'");
		КонецЕсли;
	КонецЕсли;
	Возврат ТипПлатежнойСистемы;

КонецФункции

#КонецОбласти

#Область Форматирование

// Возвращает строку формата чисел для отображения на дисплее.
// Для HTML-дисплеев - формат с разделителем-точкой и двумя знаками, без ограничения группировки.
// Для обычных дисплеев - тот же формат, но с отключённой группировкой разрядов (ЧГ=0).
//
// Параметры:
//  ДисплейОтображаетHTML - Булево - признак HTML-дисплея.
//
// Возвращаемое значение:
//  Строка - строка формата для функции Формат().
//
Функция ФорматЧисла(Знач ДисплейОтображаетHTML)

	Если ДисплейОтображаетHTML Тогда
		ФорматЧисла = "ЧДЦ=2; ЧРД=.; ЧН=0.00";
	Иначе
		ФорматЧисла = "ЧДЦ=2; ЧРД=.; ЧН=0.00; ЧГ=0";
	КонецЕсли;

	Возврат ФорматЧисла;

КонецФункции

#КонецОбласти


#Область QRКод

// Генерирует изображение QR-кода и возвращает его в виде Base64-строки.
// Использует механизм генерации штрихкодов платформы с типом кода 16 (QR) и заданным размером.
//
// Параметры:
//  ЗначениеКода - Строка - данные для кодирования в QR-код (URL, текст и т.д.).
//  Размер         - Число  - ширина и высота изображения в пикселях.
//
// Возвращаемое значение:
//  Строка - Base64-представление PNG-изображения QR-кода.
//
Функция КартинкаQRКодаBase64(Знач ЗначениеКода, Знач Размер)

	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Ширина = Размер;
	ПараметрыШтрихкода.Высота = Размер;
	ПараметрыШтрихкода.ТипКода = 16; // QR
	ПараметрыШтрихкода.Штрихкод = ЗначениеКода;
	ПараметрыШтрихкода.УбратьЛишнийФон = Истина;
	РезультатШтрихкод = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	КартинкаBase64 = Base64Строка(РезультатШтрихкод.ДвоичныеДанные);
	Возврат КартинкаBase64;

КонецФункции

// ++ НеМобильноеПриложение

Функция СтрокаBase64Картинки(ИмяФайла)
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	
	МакетКартинок = ПолучитьОбщийМакет("КартинкиДляДисплеяПокупателя");
	ИменаКартинок = СтрРазделить(МакетКартинок.ПолучитьСтроку(1), ",");
	Индекс = ИменаКартинок.Найти(ИмяФайла);
	Если Индекс = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат МакетКартинок.ПолучитьСтроку(Индекс + 2);
	
КонецФункции

// Возвращает HTML-цвет из значения шаблона дисплея покупателя.
// Пустые и некорректные значения не применяются.
//
// Параметры:
//  Цвет - Строка - цвет в формате RRGGBB или #RRGGBB.
//
// Возвращаемое значение:
//  Строка - цвет в формате #RRGGBB, или пустая строка.
//
Функция HTMLЦветИзЗначенияШаблона(Знач Цвет)

	ПозицияПервогоСимволаЦвета = 2;
	ДлинаHTMLЦвета = 6;
	Цвет = СокрЛП(Строка(Цвет));
	Если ПустаяСтрока(Цвет) Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрНачинаетсяС(Цвет, "#") Тогда
		Цвет = Сред(Цвет, ПозицияПервогоСимволаЦвета);
	КонецЕсли;
	
	Если СтрДлина(Цвет) <> ДлинаHTMLЦвета Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ПолучитьБуферДвоичныхДанныхИзHexСтроки(Цвет);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат "#" + ВРег(Цвет);

КонецФункции

Процедура ДобавитьМедиафайл(ДанныеОперации, ИмяФайла)
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеОперации.ЗагруженныеКартинки.Найти(ИмяФайла) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Медиафайл = ОборудованиеДисплеиПокупателяКлиентСервер.НовыйМедиаФайл(ИмяФайла);
	Медиафайл.Base64 = СтрокаBase64Картинки(ИмяФайла);
	ДанныеОперации.Медиафайлы.Добавить(Медиафайл);
	
КонецПроцедуры

Процедура ДобавитьСтиль(ПараметрыШаблона, Имя, Значение)
	
	Стиль = Новый Структура("Имя, Значение", Имя, Значение);
	ПараметрыШаблона.ДополнительныеСтили.Добавить(Стиль);
	
КонецПроцедуры

