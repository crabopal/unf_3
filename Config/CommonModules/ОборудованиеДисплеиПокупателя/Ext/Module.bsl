#КонецОбласти

// ++ НеМобильноеПриложение

#Область ИнициализацияСтруктур

// Создаёт структуру параметров стандартного HTML-шаблона дисплея покупателя.
//
// Возвращаемое значение:
//  Структура:
//   * Заголовок - Строка
//   * ЗаголовокСтраницы - Строка
//   * Операция - Строка
//   * Описание - Строка
//   * Информация - Строка
//   * Комментарий - Строка
//   * ОсновнойЦвет - Строка - HTML-цвет.
//   * QRКод - Строка - значение src для изображения QR-кода.
//   * Картинка - Строка - значение src для основного изображения.
//   * СтатусОперации - ПеречислениеСсылка.СтатусОперацииНаДисплее
//   * ПриложениеМойНалог - Булево
//   * КнопкаПечать - Строка - значение src для кнопки печати.
//   * Кнопки - Массив Из Структура - кнопки, см. КнопкаДисплеяПокупателя().
//   * ИндексТекущейРекламы - Число - индекс текущей рекламы в массиве Реклама.
//   * Реклама - Массив Из Структура - элементы рекламы, см.
//               ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы().
//   * РасположениеРекламы - Строка
//   * ПроцентРекламы - Число
//   * Ширина - Число, Неопределено
//   * Высота - Число, Неопределено
//   * ФорматЧисла - Строка
//   * ДополнительныеСтили - Массив Из Структура - дополнительные CSS-правила
//                                                 с полями Имя и Значение.
//
Функция ПараметрыШаблона()

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("ЗаголовокСтраницы", "");
	Результат.Вставить("Операция", "");
	Результат.Вставить("Описание", "");
	Результат.Вставить("Информация", "");
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("ОсновнойЦвет", ЦветаШаблона().Зеленый);
	Результат.Вставить("QRКод", "");
	Результат.Вставить("Картинка", "");
	Результат.Вставить("СтатусОперации", Перечисления.СтатусОперацииНаДисплее.ПустаяСсылка());
	Результат.Вставить("ПриложениеМойНалог", Ложь);
	Результат.Вставить("ПриложениеМойНалогИАТК", Ложь);
	Результат.Вставить("КнопкаПечать", "");
	Результат.Вставить("Кнопки", Новый Массив());
	Результат.Вставить("ИндексТекущейРекламы", 0);
	Результат.Вставить("Реклама", Новый Массив);
	Результат.Вставить("РасположениеРекламы", "");
	Результат.Вставить("ПроцентРекламы", 0);
	Результат.Вставить("Ширина", Неопределено);
	Результат.Вставить("Высота", Неопределено);
	Результат.Вставить("ФорматЧисла", "ЧДЦ=2; ЧРД=.; ЧН=0.00");
	Результат.Вставить("ДополнительныеСтили", Новый Массив);
	
	Возврат Результат;

КонецФункции

// Создаёт структуру параметров HTML-шаблона для корзины и списка товаров.
//
// Возвращаемое значение:
//  Структура:
//   * ОсновнойЦвет - Строка - HTML-цвет.
//   * ИндексТекущейРекламы - Число - индекс текущей рекламы в массиве Реклама.
//   * Реклама - Массив Из Структура - элементы рекламы, см.
//               ОборудованиеДисплеиПокупателяКлиентСервер.ПараметрыРекламы().
//   * РасположениеРекламы - Строка
//   * ПроцентРекламы - Число
//   * Ширина - Число, Неопределено
//   * Высота - Число, Неопределено
//   * ВыводимыеКолонки - Строка - устаревшее поле, сохранено для совместимости.
//   * ПодвалСумма - Число
//   * ПодвалСкидка - Число
//   * Корзина - Массив, Неопределено - строки корзины, см. СтрокаКорзиныДисплеяПокупателя().
//   * КорзинаШапкаЦвет - Строка - цвет шапки корзины в формате RRGGBB или #RRGGBB.
//   * КорзинаПодвалЦвет - Строка - цвет подвала корзины в формате RRGGBB или #RRGGBB.
//   * КорзинаПризвольнаяКолонкаЦвет - Строка - цвет произвольной колонки в формате RRGGBB или #RRGGBB.
//   * ЗаголовокПроизвольнойКолонки - Строка - заголовок произвольной колонки.
//   * КолонкиТабличнойЧасти - Массив, Неопределено - колонки списка товаров,
//                                                     см. ПараметрыКолонкиТабличнойЧастиДисплеяПокупателя().
//   * ТабличнаяЧасть - Массив, Неопределено - строки списка товаров.
//   * ФорматЧисла - Строка
//   * ФорматЧислаТаблица - Строка
//   * ЕстьФото - Булево
//   * ЕстьСкидка - Булево
//   * ДополнительныеСтили - Массив Из Структура - дополнительные CSS-правила
//                                                 с полями Имя и Значение.
//
Функция ПараметрыШаблонаТовары()
	
	Результат = Новый Структура();
	Результат.Вставить("ОсновнойЦвет", ЦветаШаблона().Зеленый);
	Результат.Вставить("ИндексТекущейРекламы", 0);
	Результат.Вставить("Реклама", Новый Массив);
	Результат.Вставить("РасположениеРекламы", "");
	Результат.Вставить("ПроцентРекламы", 0);
	Результат.Вставить("Ширина");
	Результат.Вставить("Высота");
	Результат.Вставить("ВыводимыеКолонки", "");
	Результат.Вставить("ПодвалСумма", 0);
	Результат.Вставить("ПодвалСкидка", 0);
	Результат.Вставить("Корзина");
	Результат.Вставить("КорзинаШапкаЦвет", "");
	Результат.Вставить("КорзинаПодвалЦвет", "");
	Результат.Вставить("КорзинаПризвольнаяКолонкаЦвет", "");
	Результат.Вставить("ЗаголовокПроизвольнойКолонки", "");
	Результат.Вставить("КолонкиТабличнойЧасти");
	Результат.Вставить("ТабличнаяЧасть");
	Результат.Вставить("ФорматЧисла", "ЧДЦ=2; ЧРД=.; ЧН=0.00");
	Результат.Вставить("ФорматЧислаТаблица", "ЧРД=.;ЧЦ=12;ЧДЦ=2;ЧН=0.00;ЧГ=0");
	Результат.Вставить("ЕстьФото", Ложь);
	Результат.Вставить("ЕстьСкидка", Ложь);
	Результат.Вставить("ЕстьПроизвольнаяКолонка", Ложь);
	Результат.Вставить("ДополнительныеСтили", Новый Массив);
	
	Возврат Результат;
	
КонецФункции


Функция ЦветаШаблона()
	
	Результат = Новый Структура;
	Результат.Вставить("Красный", "#8B0000");
	Результат.Вставить("Зеленый", "#008000");
	Результат.Вставить("Синий", "#1E90FF");
	Результат.Вставить("Желтый", "#DAA520");
	Результат.Вставить("Оранжевый", "#FF8C00");
	Результат.Вставить("Черный", "#000000");
	Результат.Вставить("Белый", "#F0FFFF");
	Возврат Результат;
	
КонецФункции

Функция ЦветПоСтатусу(Статус)
	
	Результат = Новый Соответствие;
	Результат.Вставить(Перечисления.СтатусОперацииНаДисплее.Информация, ЦветаШаблона().Синий);
	Результат.Вставить(Перечисления.СтатусОперацииНаДисплее.ВыполненоУспешно, ЦветаШаблона().Зеленый);
	Результат.Вставить(Перечисления.СтатусОперацииНаДисплее.ОжиданиеОперации, ЦветаШаблона().Желтый);
	Результат.Вставить(Перечисления.СтатусОперацииНаДисплее.ОперацияНеВыполнена, ЦветаШаблона().Красный);
	Найдено = Результат[Статус];
	Возврат ?(Найдено <> Неопределено, Найдено, ЦветаШаблона().Черный);
	
КонецФункции

Функция АдаптироватьЦвет(Цвет)
	
	Если СтрНачинаетсяС(Цвет, "#") Тогда
		Красный = Сред(Цвет, 2, 2);
		Зеленый = Сред(Цвет, 4, 2);
		Синий = Сред(Цвет, 6, 2);
	Иначе
		Красный = Сред(Цвет, 1, 2);
		Зеленый = Сред(Цвет, 3, 2);
		Синий = Сред(Цвет, 5, 2);
	КонецЕсли;
	Возврат СтрШаблон("#%1%2%3", Красный, Синий, Зеленый);
	
КонецФункции


