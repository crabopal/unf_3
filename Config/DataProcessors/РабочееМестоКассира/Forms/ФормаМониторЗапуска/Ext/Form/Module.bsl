&НаКлиенте
Процедура ПереподключитьОборудование(Команда)
	
	ТаблицаОборудования.Очистить();
	ВладелецФормы.ТаблицаОборудования.Очистить();

	МассивДляУдаления = Новый Массив;
	Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
		Если СтрокаОшибки.ВозможноПерепроверить Тогда
			МассивДляУдаления.Добавить(СтрокаОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из МассивДляУдаления Цикл
		ТаблицаОшибок.Удалить(СтрокаДляУдаления);
	КонецЦикла;
	
	ТаблицаОшибокВл = ВладелецФормы.ТаблицаОшибок;
	
	МассивДляУдаления = Новый Массив;
	Для Каждого СтрокаОшибки Из ТаблицаОшибокВл Цикл
		Если СтрокаОшибки.ВозможноПерепроверить Тогда
			МассивДляУдаления.Добавить(СтрокаОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из МассивДляУдаления Цикл
		ТаблицаОшибокВл.Удалить(СтрокаДляУдаления);
	КонецЦикла;
	
	ВосстановитьСтатусыКарточек();
	
	Для Каждого СтрокаКарточки Из Карточки Цикл
		СтрокаКарточки.Используется = Ложь;
		СтрокаКарточки.ВыполнетсяПроверка = Ложь;
		СтрокаКарточки.ПроверкаЗавершена = Ложь;
		СтрокаКарточки.ЕстьОшибки = Ложь;
		СтрокаКарточки.ЕстьОшибкиКритические = Ложь;
	КонецЦикла;
	
	ОпределитьИспользуемоеОборудование();
	
	Для Каждого СтрокаКарточки Из Карточки Цикл
		Если Не СтрокаКарточки.Используется Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаКарточки.Карточка = "ККТ"
			Или СтрокаКарточки.Карточка = "Эквайринг"
			Или СтрокаКарточки.Карточка = "Сканер"
			Или СтрокаКарточки.Карточка = "Весы"
			Или СтрокаКарточки.Карточка = "Дисплей" Тогда
				СтрокаКарточки.ВыполнетсяПроверка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	АктуализироватьКарточки();
	
	ВладелецФормы.РанееПодключенныеТипыОборудования = МенеджерОборудованияРМККлиентСервер.ПараметрыТипыОборудования();
	
	ВладелецФормы.НастроитьВспомогательноеПодключаемоеОборудование();
	
	ПодключитьОбработчикОжидания("ПроверитьОборудование", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСтатусыКарточек()
	
	Для Каждого ЭлементСтрокаКарточек Из Элементы.ГруппаОсновная.ПодчиненныеЭлементы Цикл
		Для Каждого ЭлементКарточка Из ЭлементСтрокаКарточек.ПодчиненныеЭлементы Цикл
			Элементы[ЭлементКарточка.Имя].ЦветФона = ЦветаФормы.ЦветФонаКарточки;
			Элементы[ЭлементКарточка.Имя + "Статус"].Картинка = БиблиотекаКартинок.Пустая;
			Элементы[ЭлементКарточка.Имя + "Статус"].ЦветТекста = ЦветаФормы.ЦветПредупреждение;
			ЭлементКарточка.Гиперссылка = Ложь;
		КонецЦикла;
	КонецЦикла;
	
	Элементы.СтраницыСтатус.ТекущаяСтраница = Элементы.СтраницаОбщийСтатус;
	
КонецПроцедуры

