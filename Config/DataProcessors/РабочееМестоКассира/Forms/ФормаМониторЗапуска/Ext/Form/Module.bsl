// ТС ПИоТ
&НаКлиенте
Процедура ПерейтиНаСтраницуТСПИоТ(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТСПИоТ;
	
	
	ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации(Истина);
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
	ДополнительныеПараметры = Новый Структура("Кассир, Пользователь", ВладелецФормы.Объект.Кассир, ВладелецФормы.Объект.ПользовательБД);
	ОбщегоНазначенияРМКВызовСервера.ЗаполнитьПараметрыКассираДляПечати(ПараметрыОперации, ДополнительныеПараметры);
	
	КассирФИО = ПараметрыОперации.Кассир;
	КассирИНН = ПараметрыОперации.КассирИНН;
	
	КонтрольнаяМарка = "";
	
	СТ_РегистрацияПройдена = Ложь;
	СТ_АварийныйРежим = Ложь;
	СТ_ЛМЧЗГотов = Ложь;
	СТ_АвторизацияПройдена = Ложь;
	СТ_ГотовКПроверкеКМOnline = Ложь;
	СТ_ГотовКПроверкеКМOffline = Ложь;
	СТ_АварийныйРежим = Ложь;
	СТ_ПостАварийныйРежим = Ложь;
	СТ_Error = "";
	
	СписокККТ = Элементы.ККТ.СписокВыбора;
	СписокККТ.Очистить();
	ККТ = Неопределено;
	
	Для Каждого Об1 из ТаблицаОборудования Цикл
		Если Об1.Карточка = "ККТ" Тогда
			
			Если Не ЗначениеЗаполнено(Об1.Оборудование) Тогда
				Продолжить;
			КонецЕсли;
			
			
			ТСПИОТ = Неопределено;
			НайтиТСПИОТ(Об1.Оборудование, ТСПИОТ);
			
			Если ЗначениеЗаполнено(ТСПИОТ) Тогда
				Если Не ЗначениеЗаполнено(ККТ) Тогда
					ККТ = Об1.Оборудование;
					ТСПИОТККТ = ТСПИОТ.Ссылка;
					ЗапросСтатуса(Неопределено);
				КонецЕсли;
				СписокККТ.Добавить(Об1.Оборудование);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Аутентификация(Команда)
	
	Если Не ЗначениеЗаполнено(ККТ) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru='ККТ не выбран.'"));
		Возврат;
	КонецЕсли;
	
	Элементы.СтраницаСтатусТСПИоТИдетНастройка.Видимость = Истина;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПослеПроверкиСтатусаГотовностиТСПИоТ", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьРаботуПИоТ(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, , ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапросСтатуса(Команда)
	
	Если Не ЗначениеЗаполнено(ККТ) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru='ККТ не выбран.'"));
		Возврат;
	КонецЕсли;
	
	Если СменаОткрыта() Тогда
	
		ПараметрыОперации = Неопределено;
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолучениеСтатусаПИоТ(ОповещениеПриЗавершении,
			УникальныйИдентификатор, ККТ, ПараметрыОперации, ДополнительныеПараметры);
	Иначе
		ОчиститьСтатусыПиот();
	КонецЕсли;
	
КонецПроцедуры

