	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолучениеСтатусаПИоТ(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, ПараметрыОперации, ДополнительныеПараметры);
	
КонецПроцедуры

// После 
&НаКлиенте
Процедура КомандаВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ОчиститьСообщения();
	УстройствоЗанято = Ложь;
	
	Если РезультатВыполнения.Результат Тогда
		Если РезультатВыполнения.Свойство("ФискальныеДанные") Тогда
			ОбновитьДанные(РезультатВыполнения.ФискальныеДанные);
		Иначе
			ОбновитьДанные(РезультатВыполнения);
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("СлужебнаяИнформация") Тогда
			СлужебнаяИнформация = РезультатВыполнения.СлужебнаяИнформация;
			ПИоТ_Имя = СлужебнаяИнформация.Наименование + " " + СлужебнаяИнформация.Версия;
			ПИоТ_ПустьКЛогам = СлужебнаяИнформация.ПустьКЛогам;
			ПИоТ_ПустьКФайламСобытия = СлужебнаяИнформация.ПустьКФайламСобытия;
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("СтатусСостояния") И  РезультатВыполнения.СтатусСостояния <> Неопределено Тогда 
			ОбновитьСтатусСостояния(РезультатВыполнения.СтатусСостояния);
		КонецЕсли;
		
	Иначе
		ТекстПроЗакрытуюСмену = НСтр("ru='смена не открыта'");
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		Если СтрНайти(ТекстСообщения, ТекстПроЗакрытуюСмену) > 0 И СменаОткрыта() Тогда
			ТекстСообщения = НСтр("ru='Выполняется обновление статуса ФН, пожалуйста, обновите позднее.'");
		КонецЕсли;
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодключитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ОчиститьСообщения();
	Элементы.ГруппаИнфо.Доступность = Истина;
	Элементы.ОткрытьФайлЛогирования.Доступность = Истина;
	
	НомерСмены  = Неопределено;
	НомерЧека   = Неопределено;
	СтатусСмены = Неопределено;
	
	Если РезультатВыполнения.Результат Тогда
		Если РезультатВыполнения.Свойство("ФискальныеДанные") Тогда
			ОбновитьДанные(РезультатВыполнения.ФискальныеДанные);
		КонецЕсли;
		
		ПараметрыОперации = Неопределено;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолучениеСлужебнойИнформацииПИоТ(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, ПараметрыОперации, ДополнительныеПараметры);
		
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(РезультатВыполнения);
	
	Если РезультатВыполнения.Свойство("НомерЧекаККТ") Тогда
		НомерЧека = РезультатВыполнения.НомерЧекаККТ;
	КонецЕсли;
		
	Если РезультатВыполнения.Свойство("НомерСменыККТ") Тогда
		НомерСмены = РезультатВыполнения.НомерСменыККТ;
	КонецЕсли;
		
	Если РезультатВыполнения.Свойство("СтатусСмены") Тогда
		Если РезультатВыполнения.СтатусСмены = 1 Тогда
			СтатусСмены = НСтр("ru='Закрыта'")
		ИначеЕсли РезультатВыполнения.СтатусСмены = 2 Тогда
			СтатусСмены = НСтр("ru='Открыта'")
		Иначе
			СтатусСмены = НСтр("ru='Истекла'")
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусСостояния(СтатусСостояния);
	
	СТ_РегистрацияПройдена = СтатусСостояния.РегистрацияПройдена;
	СТ_ГотовКПроверкеКМOnline = СтатусСостояния.ГотовКПроверкеКМOnline; 
	СТ_ГотовКПроверкеКМOffline = СтатусСостояния.ГотовКПроверкеКМOffline; 
	СТ_АварийныйРежим = СтатусСостояния.АварийныйРежим;
	СТ_ПостАварийныйРежим = СтатусСостояния.ПостАварийныйРежим;
	СТ_ЛМЧЗГотов = СтатусСостояния.ЛМЧЗГотов;
	СТ_АвторизацияПройдена = СтатусСостояния.АвторизацияПройдена;
	Если СтатусСостояния.Свойство("ЛМЧЗСтатусТекст") Тогда
		СТ_ЛМЧЗСтатус = СтатусСостояния.ЛМЧЗСтатусТекст;
	Иначе
		СТ_ЛМЧЗСтатус = СтатусСостояния.ЛМЧЗСтатус;
	КонецЕсли;
	СТ_Error = СтатусСостояния.ТекстОшибки;
	
	СТ_ТокенЛМЧЗ =  СтатусСостояния.ТокенЛМЧЗ;
	СТ_ТокенЛМЧЗДатаДействия = СтрЗаменить(СтатусСостояния.ТокенЛМЧЗДатаДействия, "T", " ");
	
	ПолучениеСлужебнойИнформации(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ККТПриИзменении(Элемент)
	
	ТСПИОТ = Неопределено;
	НайтиТСПИОТ(ККТ, ТСПИОТ);
	
	Если ЗначениеЗаполнено(ТСПИОТ) Тогда
		ТСПИОТККТ = ТСПИОТ.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСобытияЭксплуатацииТСПИоТНажатие(Элемент)
	
	МенеджерОборудованияТСПИОТКлиент.ОткрытьСобытияЭксплуатацииТСПИоТ(ККТ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОперацииПроверкиКМНажатие(Элемент)
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	ПараметрыВыполненияКоманды.Вставить("Уникальность", УникальныйИдентификатор);
	ПараметрыВыполненияКоманды.Вставить("Окно",);
	
	МенеджерОборудованияМаркировкаКлиент.ОткрытьОперацииПроверкиКМ(Неопределено, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ККТОткрытие(Элемент, СтандартнаяОбработка)
	
	Если Не ЕстьРольДобавлениеИзменениеТСПИоТ Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры



