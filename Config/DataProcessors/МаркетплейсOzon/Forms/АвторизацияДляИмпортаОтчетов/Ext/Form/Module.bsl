#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЗначениеЗаполнено( Параметры.УчетнаяЗапись ) Тогда
		ЗначениеВРеквизитФормы( Параметры.УчетнаяЗапись.ПолучитьОбъект(), "Объект" );
	КонецЕсли;

	Если Параметры.Свойство("ДополнительныеПараметры")
	И ТипЗнч( Параметры.ДополнительныеПараметры ) = Тип( "Структура" ) Тогда
		
		ДополнительныеПараметры = Параметры.ДополнительныеПараметры;
	
		Если ДополнительныеПараметры.Свойство("Организация")
		И ЗначениеЗаполнено( ДополнительныеПараметры.Организация ) Тогда
			Объект.Организация = ДополнительныеПараметры.Организация;
		КонецЕсли;
	КонецЕсли;
    
    УчетнаяЗапись = Объект.Ссылка;
	OzonДанныеАвторизацииЗаписаны = 
	ИнтеграцияСМаркетплейсомOzonСервер.OzonПроверитьДанныеАвторизацииПомещеныВХранилище(УчетнаяЗапись);
	
	ЗагрузитьКлючИзХранилища();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьСписокПодключений" Тогда
		// При вызове оповещения объект изменен проверкой подключения либо другой формой- перечитываем
		Прочитать();
		УчетнаяЗапись = Объект.Ссылка;
		OzonДанныеАвторизацииЗаписаны = OzonПроверитьДанныеАвторизацииПомещеныВХранилище( УчетнаяЗапись );
		ОтобразитьОповещенияПоСрокуКлюча();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеДоступом.ПриЧтенииНаСервере( ЭтотОбъект, ТекущийОбъект );
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеДоступом.ПослеЗаписиНаСервере( ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи );
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить( "ЗаписьНастройкаИнтеграцииМаркетплейс", Объект.Ссылка );
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.НастройкаЗавершена Тогда
		ОтобразитьОповещенияПоСрокуКлюча();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Функция ПодключитьOzon()
	
	УчетнаяЗапись = Объект;
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись.Организация)
		Или НЕ ЗначениеЗаполнено(УчетнаяЗапись.ИдентификаторКлиента)
		Или НЕ ЗначениеЗаполнено(КлючAPI) Тогда  
		
		ТекстСообщения = НСтр("ru = 'Заполните все поля для подключения к маркетплейсу Ozon'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеУчетнойЗаписи = Новый Структура("Организация, ИдентификаторКлиента, КлючAPI" );
	ДанныеУчетнойЗаписи.Вставить( "УникальныйИдентификатор" );
	
	ДанныеУчетнойЗаписи.Организация = УчетнаяЗапись.Организация;
	ДанныеУчетнойЗаписи.ИдентификаторКлиента = УчетнаяЗапись.ИдентификаторКлиента;
	ДанныеУчетнойЗаписи.КлючAPI = КлючAPI;
	ПроверкаПройдена = ПроверитьПодключениеКСерверу(ДанныеУчетнойЗаписи);
	
	ПоказыватьСтраницуРезультатамиАвторизации = Истина;
	
	ЗаписьУспешна = Ложь;
	
	Если ПроверкаПройдена Тогда
		
		ЗаписьУспешна = ЗаписатьДанныеВХранилище();
		
		Если ЗаписьУспешна Тогда
			Оповестить( "ОбновитьСписокПодключений" );
		Иначе
			ПоказыватьСтраницуРезультатамиАвторизации = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПоказыватьСтраницуРезультатамиАвторизации Тогда
		Если ЗаписьУспешна Тогда
			СообщениеТекст = НСтр("ru = 'Настройки подключения записаны.'");
		Иначе
			СообщениеТекст = НСтр("ru = 'Ошибка авторизации. Подробности см. в журнале регистрации или лог.'");
		КонецЕсли;
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст);
	КонецЕсли;
		
	Возврат ПроверкаПройдена;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьПодключениеКСерверу(ДанныеУчетнойЗаписи)

	Результат = ИнтеграцияСМаркетплейсомOzonСервер.ПолучитьСрокДействияУчетнойЗаписи(ДанныеУчетнойЗаписи);

	Если Результат.Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Подключение выполнено успешно.'"));
		Объект.СрокДействияКлюча = Результат.ДействителенДо;
		Возврат Истина;
	Иначе
		ШаблонОшибки = НСтр("ru = 'Во время проверки подключения к HTTP-серверу произошла ошибка: %1'");
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибки, Результат.ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(Комментарий);
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ЗаписатьДанныеВХранилище()
	
	Попытка

		Объект.ВалютаУчета = ИнтеграцияСМаркетплейсомOzonСервер.ВалютаРегламентированногоУчетаОрганизации( Объект.Организация );
		Объект.ИсточникКатегории = Перечисления.ИсточникиКатегорийДляМаркетплейса.ИерархияНоменклатуры;
		Если Не ЗначениеЗаполнено( Объект.Наименование ) Тогда
			Объект.Наименование = Строка(Объект.Организация) + " (" + Строка(Объект.ИдентификаторКлиента) + ")";
		КонецЕсли;
		Объект.ВидМаркетплейса = Перечисления.ВидыМаркетплейсов.МаркетплейсOzon;
		Записать();
		
		УчетнаяЗапись = Объект.Ссылка;
        Результат = ИнтеграцияСМаркетплейсомOzonСервер.ЗаписатьДанныеАвторизацииВХранилище( УчетнаяЗапись, КлючAPI );

	Исключение

		Результат = Ложь;

		ШаблонСообщения = НСтр("ru = 'Не удалось выполнить запись настроек подключения по причине: %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
		ОбработкаОшибок.ПодробноеПредставлениеОшибки( ИнформацияОбОшибке() ));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция OzonПроверитьДанныеАвторизацииПомещеныВХранилище( УчетнаяЗапись )
	Возврат ИнтеграцияСМаркетплейсомOzonСервер.OzonПроверитьДанныеАвторизацииПомещеныВХранилище(УчетнаяЗапись);
КонецФункции

&НаКлиенте
Процедура ОтобразитьОповещенияПоСрокуКлюча()
	// Обновляем представление срока действия
	ПредставлениеСрокДействияКлюча = ИнтеграцияСМаркетплейсомOzonКлиентСервер.ПредставлениеСрокаДействияКлюча(Объект.СрокДействияКлюча);
	 
	// Оповещение о том что срок ключа не заполнен
	ТекстБаннера = Неопределено;
	ПоказатьСсылку = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.СрокДействияКлюча) Тогда
		ТекстБаннера = СтрШаблон(
        	НСтр("ru = 'Срок действия API ключа Ozon для учетной записи ""%1"" не заполнен.
				 |Рекомендуется произвести подключение заново для заполнения срока действия.'"), 
        	Объект.Наименование);
	ИначеЕсли НЕ ИнтеграцияСМаркетплейсомOzonВызовСервера.КлючАктивен(Объект.Ссылка) Тогда
		ТекстБаннера = СтрШаблон(
        	НСтр("ru = 'Срок действия API ключа Ozon для учетной записи ""%1"" истек %2.
				 |Требуется обновить ключ в настройках маркетплейса.'"), 
        	Объект.Наименование, Формат(Объект.СрокДействияКлюча, "ДЛФ=D"));
        ПоказатьСсылку = Истина;
	КонецЕсли;
	Если ТекстБаннера <> Неопределено Тогда
		ВывестиБаннерПоСрокуКлюча(ТекстБаннера, ПоказатьСсылку);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьСтатусИлиВажноеСообщение(ЭтотОбъект, "БаннерПоСрокуКлюча");
	КонецЕсли;
КонецПроцедуры

// Вывести баннер по сроку ключа.
// 
// Параметры:
//  Сообщение - Строка - Текст сообщения
//  ПоказатьСсылку - Булево - Показать ссылку на параметры ключей в ЛК Озон
&НаСервере
Процедура ВывестиБаннерПоСрокуКлюча(Сообщение, ПоказатьСсылку)
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.Идентификатор = "БаннерПоСрокуКлюча";
	ПараметрыВажногоСообщения.Скрываемый = Истина;
	ПараметрыВажногоСообщения.ТипСообщения = "Ошибка";
	ПараметрыВажногоСообщения.Сообщение = Сообщение;
	Если ПоказатьСсылку Тогда
		ПараметрыВажногоСообщения.ПараметрыДействия = Новый Массив;
		Действие = ОбщегоНазначения.ПараметрыДействияВажногоСообщения();
		Действие.Заголовок = НСтр("ru = 'https://seller.ozon.ru/app/settings/api-keys'");
		Действие.ИмяКоманды = "БаннерПоСрокуКлюча_ОткрытьСтраницуНастроекОзон";
		Действие.Обработчик = "Подключаемый_БаннерПоСрокуКлюча_ОткрытьСтраницуНастроекОзон";
		ПараметрыВажногоСообщения.ПараметрыДействия.Добавить(Действие);
	КонецЕсли;
	ОбщегоНазначения.ВставитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения, Элементы.ГруппаБаннерКлюча.Имя);
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
КонецПроцедуры

// Загрузить ключ из безопасного хранилища в реквизит формы
&НаСервере
Процедура ЗагрузитьКлючИзХранилища()
	УстановитьПривилегированныйРежим(Истина);
	УчетнаяЗапись = Объект.Ссылка;
	ИдентификаторУчетнойЗаписи = ИнтеграцияСМаркетплейсомOzonКлиентСервер.ПрефиксыСервиса().НастройкиСервиса + УчетнаяЗапись.УникальныйИдентификатор();
	КлючAPI = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторУчетнойЗаписи, "KeyAPI", Ложь);
КонецПроцедуры

#КонецОбласти