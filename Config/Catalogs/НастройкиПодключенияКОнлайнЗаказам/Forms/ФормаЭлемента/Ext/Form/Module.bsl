	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЗакрытьПослеЗаписи", Ложь);
	ДополнительныеПараметры.Вставить("ВидОбрабатываемойКоманды", "ЗаписатьНастройку");
	
	ПередИнициализациейЗаписиОбъекта(ДополнительныеПараметры);
	
КонецПроцедуры

