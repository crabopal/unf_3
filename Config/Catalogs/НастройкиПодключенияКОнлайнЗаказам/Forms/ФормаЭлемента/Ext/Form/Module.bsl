#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Для Каждого НастройкаОплаты Из Объект.НастройкиОплаты Цикл
		Если НастройкаОплаты.СпособОплаты = Перечисления.СпособыОплатыОнлайнЗаказов.СБПc2b Тогда
			НастройкаПодключенияКСБПc2b = НастройкаОплаты.НастройкаПодключения;
			ПриниматьОплатуСБПc2b = НастройкаОплаты.Используется;
		ИначеЕсли НастройкаОплаты.СпособОплаты = Перечисления.СпособыОплатыОнлайнЗаказов.СБПb2b Тогда
			НастройкаПодключенияКСБПb2b = НастройкаОплаты.НастройкаПодключения;
			ПриниматьОплатуСБПb2b = НастройкаОплаты.Используется;
		ИначеЕсли НастройкаОплаты.СпособОплаты = Перечисления.СпособыОплатыОнлайнЗаказов.ИнтернетЭквайринг Тогда
			НастройкаПодключенияКИнтернетЭквайрингу = НастройкаОплаты.НастройкаПодключения;
			ПриниматьОплатуИнтернетЭквайринг = НастройкаОплаты.Используется;
		ИначеЕсли НастройкаОплаты.СпособОплаты = Перечисления.СпособыОплатыОнлайнЗаказов.ОзонПэй Тогда
			НастройкаПодключенияКОзонПэй = НастройкаОплаты.НастройкаПодключения;
			ПриниматьОплатуОзонПэй = НастройкаОплаты.Используется;
		ИначеЕсли НастройкаОплаты.СпособОплаты = Перечисления.СпособыОплатыОнлайнЗаказов.ЯндексПэй Тогда
			НастройкаПодключенияКЯндексПэй = НастройкаОплаты.НастройкаПодключения;
			ПриниматьОплатуЯндексПэй = НастройкаОплаты.Используется;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Объект.Используется = Истина;
		Объект.ПоРеквизитамОтФизЛиц = Истина;
		Объект.ПоРеквизитамОтЮрЛиц = Истина;
		
		Если ЗначениеЗаполнено(Объект.Организация)
			И ПустаяСтрока(Объект.Наименование) Тогда
			Объект.Наименование = Строка(Объект.Организация);
		КонецЕсли;
		
		ЭтоНоваяНастройка = Истина;
		
	КонецЕсли;
	
	НастройкаОнлайнЗаказовДоступна = ОнлайнЗаказыСлужебный.НастройкаОнлайнЗаказовДоступна();
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПлатежныеСистемы.БазоваяФункциональностьПлатежныхСистем") Тогда
		МодульПлатежныеСистемыСлужебный = ОбщегоНазначения.ОбщийМодуль("ПлатежныеСистемыСлужебный");
		ЧтениеНастроекПлатежныхСистемДоступно = МодульПлатежныеСистемыСлужебный.ЧтениеНастроекДоступно();
	КонецЕсли;
	
	Если Параметры.ЗапретИзмененияОрганизации Тогда
		Элементы.Организация.Вид = ВидПоляФормы.ПолеНадписи;
	КонецЕсли;
	
	УстановитьВидимостьДоступность();
	УправлениеЭлементамиФормыПоДанным();
	УстановитьДоступностьНастроекОплатФискализации();
	
	РезультатПроверкиШаблонов = Неопределено;
	ИспользоватьШаблоныСообщений = ОнлайнЗаказыСлужебный.ИспользоватьШаблоныСообщений();
	
	Если ИспользоватьШаблоныСообщений Тогда
		РезультатПроверкиШаблонов = ОнлайнЗаказыСлужебный.ВсеШаблоныСозданы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ПриниматьОплатуСБПc2b
		И Не ЗначениеЗаполнено(НастройкаПодключенияКСБПc2b) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка подключения к СБП.'"),
			,
			"НастройкаПодключенияКСБПc2b",
			,
			Отказ);
		
	КонецЕсли;
	
	Если ПриниматьОплатуИнтернетЭквайринг
		И Не ЗначениеЗаполнено(НастройкаПодключенияКИнтернетЭквайрингу) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка подключения к Интернет-эквайрингу.'"),
			,
			"НастройкаПодключенияКИнтернетЭквайрингу",
			,
			Отказ);
		
	КонецЕсли;
	
	Если ПриниматьОплатуОзонПэй
		И Не ЗначениеЗаполнено(НастройкаПодключенияКОзонПэй) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка подключения к Ozon Pay.'"),
			,
			"НастройкаПодключенияКОзонПэй",
			,
			Отказ);
		
	КонецЕсли;
	
	Если ПриниматьОплатуЯндексПэй
		И Не ЗначениеЗаполнено(НастройкаПодключенияКЯндексПэй) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка подключения к Яндекс Пэй.'"),
			,
			"НастройкаПодключенияКЯндексПэй",
			,
			Отказ);
		
	КонецЕсли;
	
	Если Объект.ФискализироватьОнлайнЗаказы
		И Не ЗначениеЗаполнено(Объект.НастройкаПодключенияКОблачнойКассе) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка облачной кассы.'"),
			,
			"Объект.НастройкаПодключенияКОблачнойКассе",
			,
			Отказ);
		
	КонецЕсли;
	
	Если ПриниматьОплатуСБПb2b
		И Не ЗначениеЗаполнено(НастройкаПодключенияКСБПb2b) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнена настройка подключения к СБП.'"),
			,
			"НастройкаПодключенияКСБПb2b",
			,
			Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПредставлениеНеРедактировалось = Объект.Наименование = Строка(Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ПредставлениеНеРедактировалось Тогда
		Объект.Наименование = Строка(Объект.Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПредупреждениеОбработкаНавигационнойСсылки(
		Элемент,
		НавигационнаяСсылкаФорматированнойСтроки,
		СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "operation:resendSettings" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Ссылка)
			Или Модифицированность Тогда
			ЗадатьВопросОЗаписи("ПовторнаяОтправка");
		Иначе
			ОбновитьНастройкуВСервисе();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

