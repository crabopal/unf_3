#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Объект.КорзинаШапкаЦвет) Тогда
		Объект.КорзинаШапкаЦвет = "008000";
	КонецЕсли;

	Если ПустаяСтрока(Объект.КорзинаПодвалЦвет) Тогда
		Объект.КорзинаШапкаЦвет = "008000";
	КонецЕсли;

	Если ПустаяСтрока(Объект.КорзинаПризвольнаяКолонкаЦвет) Тогда
		Объект.КорзинаШапкаЦвет = "000000";
	КонецЕсли;

	Элементы.ДекорацияКорзинаШапкаЦвет.ЦветФона = ЦветИзHex(Объект.КорзинаШапкаЦвет);
	Элементы.ДекорацияКорзинаПодвалЦвет.ЦветФона = ЦветИзHex(Объект.КорзинаПодвалЦвет);
	Элементы.ДекорацияКорзинаПризвольнаяКолонкаЦвет.ЦветФона = ЦветИзHex(Объект.КорзинаПризвольнаяКолонкаЦвет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура КорзинаШапкаЦветНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораЦвета;
	Диалог.Цвет = ЦветИзHex(Объект.КорзинаШапкаЦвет);
	Цвет = Ждать Диалог.ВыбратьАсинх();
	Объект.КорзинаШапкаЦвет = HexИзЦвета(Цвет.ПолучитьАбсолютный());
	Элементы.ДекорацияКорзинаШапкаЦвет.ЦветФона = Цвет;

КонецПроцедуры

&НаКлиенте
Асинх Процедура КорзинаПодвалЦветНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Диалог = Новый ДиалогВыбораЦвета;
	Диалог.Цвет = ЦветИзHex(Объект.КорзинаПодвалЦвет);
	Цвет = Ждать Диалог.ВыбратьАсинх();
	Объект.КорзинаПодвалЦвет = HexИзЦвета(Цвет.ПолучитьАбсолютный());
	Элементы.ДекорацияКорзинаПодвалЦвет.ЦветФона = Цвет;

КонецПроцедуры

&НаКлиенте
Асинх Процедура КорзинаПризвольнаяКолонкаЦветНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Диалог = Новый ДиалогВыбораЦвета;
	Диалог.Цвет = ЦветИзHex(Объект.КорзинаПризвольнаяКолонкаЦвет);
	Цвет = Ждать Диалог.ВыбратьАсинх();
	Объект.КорзинаПризвольнаяКолонкаЦвет = HexИзЦвета(Цвет.ПолучитьАбсолютный());
	Элементы.ДекорацияКорзинаПризвольнаяКолонкаЦвет.ЦветФона = Цвет;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеклама

&НаКлиенте
Процедура РекламаПриАктивизацииСтроки(Элемент)

	ОбновитьКартинкуРекламы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура КомандаДобавить(Команда)

	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Выбор картинок рекламы'");
	ДиалогВыбораФайла.Фильтр =
		"PNG (*.png)|*.png|GIF (*.gif)|*.gif|JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
		+ "BMP (*.bmp)|*.bmp|Все картинки|*.png;*.gif;*.jpg;*.jpeg;*.bmp";
	ДиалогВыбораФайла.ИндексФильтра = 5;
	ДиалогВыбораФайла.МножественныйВыбор = Истина;

	ИменаФайлов = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	Если ИменаФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписанияПередаваемыхФайлов = Новый Массив;
	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		ОписанияПередаваемыхФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла));
	КонецЦикла;

	ОписанияПомещенныхФайлов = Ждать ПоместитьФайлыНаСерверАсинх(
		,
		,
		ОписанияПередаваемыхФайлов,
		УникальныйИдентификатор);

	ОписанияПередаваемыхФайлов.Очистить();
	Для Каждого ОписаниеПомещенногоФайла Из ОписанияПомещенныхФайлов Цикл
		Если ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмя = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
		Адрес = ОписаниеПомещенногоФайла.Адрес;
		ОписанияПередаваемыхФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмя, Адрес));
	КонецЦикла;

	Если ОписанияПередаваемыхФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ДобавитьКартинкиНаСервере(ОписанияПередаваемыхФайлов);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.Реклама.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;

	ОбновитьКартинкуРекламы();

КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаУдалить(Команда)

	ТекущиеДанные = Элементы.Реклама.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ждать ВопросАсинх(
		НСтр("ru = 'Удалить выбранную картинку из таблицы?'"),
		РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	Объект.Реклама.Удалить(ТекущиеДанные);
	ЭтотОбъект.Картинка = "";
	ОбновитьКартинкуРекламы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьКартинкуРекламы() Экспорт

	ТекущиеДанные = Элементы.Реклама.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ЭтотОбъект.Картинка = "";
		Возврат;
	КонецЕсли;

	ЭтотОбъект.Картинка = АдресКартинкиРекламыНаСервере(ТекущиеДанные.НомерСтроки);

КонецПроцедуры

&НаСервере
Функция ДобавитьКартинкиНаСервере(Знач ОписанияПередаваемыхФайлов)

	ИдентификаторСтроки = Неопределено;
	Для Каждого ОписаниеПередаваемогоФайла Из ОписанияПередаваемыхФайлов Цикл
		НоваяСтрока = Объект.Реклама.Добавить();
		Файл = Новый Файл(ОписаниеПередаваемогоФайла.Имя);
		НоваяСтрока.Имя = Файл.Имя;
		НоваяСтрока.Картинка = Новый ХранилищеЗначения(
			ПолучитьИзВременногоХранилища(ОписаниеПередаваемогоФайла.Хранение));
		НоваяСтрока.ВремяОтображения = 10;
		ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
	КонецЦикла;

	Возврат ИдентификаторСтроки;

КонецФункции

&НаСервере
Функция АдресКартинкиРекламыНаСервере(Знач НомерСтроки)

	Если НомерСтроки = Неопределено
		Или НомерСтроки < 1
		Или НомерСтроки > Объект.Реклама.Количество() Тогда
		Возврат "";
	КонецЕсли;

	ХранилищеКартинки = Объект.Реклама[НомерСтроки - 1].Картинка;
	Если ХранилищеКартинки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(ХранилищеКартинки.Получить(), УникальныйИдентификатор);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция HexИзЦвета(Цвет)

	Попытка
		Буфер = Новый БуферДвоичныхДанных(4);
		КодЦвета = (Цвет.Синий * 256 * 256) + (Цвет.Зеленый * 256) + Цвет.Красный;
		Буфер.ЗаписатьЦелое32(0, КодЦвета);
		Возврат Лев(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер), 6);
	Исключение
		Возврат "000000";
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЦветИзHex(Знач ЦветHex)

	Если ПустаяСтрока(ЦветHex) Тогда
		ЦветHex = "000000";
	КонецЕсли;

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки(ЦветHex);
		Красный = Буфер.Получить(0);
		Зеленый = Буфер.Получить(1);
		Синий = Буфер.Получить(2);
		Возврат Новый Цвет(Красный, Зеленый, Синий);
	Исключение
		Возврат Новый Цвет(0, 0, 0);
	КонецПопытки

КонецФункции

#КонецОбласти

