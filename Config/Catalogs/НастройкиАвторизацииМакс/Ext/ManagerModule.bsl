#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает признак использования безопасного хранилища БСП для токена авторизации MAX.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс() Экспорт
	
	Возврат ОбщегоНазначенияБПО.ИспользуетсяБСП();
	
КонецФункции

// Возвращает признак наличия токена авторизации MAX в безопасном хранилище БСП.
//
// Параметры:
//  НастройкаАвторизации - СправочникСсылка.НастройкиАвторизацииМакс - настройка авторизации MAX.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТокенАвторизацииМаксСуществуетВБезопасномХранилище(НастройкаАвторизации) Экспорт
	
	Если Не ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс()
		Или НастройкаАвторизации.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(ПрочитатьТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации));
	
КонецФункции

// Записывает токен авторизации MAX в безопасное хранилище БСП.
//
// Параметры:
//  НастройкаАвторизации - СправочникСсылка.НастройкиАвторизацииМакс - настройка авторизации MAX.
//  ТокенАвторизации     - Строка - токен авторизации MAX.
//
Процедура ЗаписатьТокенАвторизацииМаксВБезопасноеХранилище(НастройкаАвторизации, ТокенАвторизации) Экспорт
	
	Если Не ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс()
		Или НастройкаАвторизации.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТокенАвторизации) Тогда
		УдалитьТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации);
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщегоНазначенияБПО.ОбщийМодуль("ОбщегоНазначения");
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МодульОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			НастройкаАвторизации, ТокенАвторизации, КлючТокенаАвторизацииМакс());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Удаляет токен авторизации MAX из безопасного хранилища БСП.
//
// Параметры:
//  НастройкаАвторизации - СправочникСсылка.НастройкиАвторизацииМакс - настройка авторизации MAX.
//
Процедура УдалитьТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации) Экспорт
	
	Если Не ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс()
		Или НастройкаАвторизации.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщегоНазначенияБПО.ОбщийМодуль("ОбщегоНазначения");
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МодульОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(
			НастройкаАвторизации, КлючТокенаАвторизацииМакс());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Возвращает токен авторизации MAX из безопасного хранилища БСП.
//
// Параметры:
//  НастройкаАвторизации - СправочникСсылка.НастройкиАвторизацииМакс - настройка авторизации MAX.
//
// Возвращаемое значение:
//  Строка - токен авторизации MAX.
//
Функция ТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации) Экспорт
	
	Если Не ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс()
		Или НастройкаАвторизации.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПрочитатьТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации);
	
КонецФункции

// Возвращает токены авторизации MAX из безопасного хранилища БСП.
//
// Параметры:
//  НастройкиАвторизации - Массив из СправочникСсылка.НастройкиАвторизацииМакс - настройки авторизации MAX.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - СправочникСсылка.НастройкиАвторизацииМакс - настройка авторизации MAX.
//   * Значение - Строка - токен авторизации MAX.
//
Функция ТокеныАвторизацииМаксИзБезопасногоХранилища(НастройкиАвторизации) Экспорт
	
	Если Не ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс()
		Или НастройкиАвторизации.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Возврат ПрочитатьТокеныАвторизацииМаксИзБезопасногоХранилища(НастройкиАвторизации);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьТокенАвторизацииМаксИзБезопасногоХранилища(НастройкаАвторизации)
	
	МодульОбщегоНазначения = ОбщегоНазначенияБПО.ОбщийМодуль("ОбщегоНазначения");
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТокенАвторизации = МодульОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			НастройкаАвторизации, КлючТокенаАвторизацииМакс());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ?(ТокенАвторизации = Неопределено, "", ТокенАвторизации);
	
КонецФункции

Функция ПрочитатьТокеныАвторизацииМаксИзБезопасногоХранилища(НастройкиАвторизации)
	
	МодульОбщегоНазначения = ОбщегоНазначенияБПО.ОбщийМодуль("ОбщегоНазначения");
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТокеныАвторизации = МодульОбщегоНазначения.ПрочитатьДанныеВладельцевИзБезопасногоХранилища(
			НастройкиАвторизации, КлючТокенаАвторизацииМакс());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТокеныАвторизации;
	
КонецФункции

Функция КлючТокенаАвторизацииМакс()
	
	Возврат "ТокенАвторизации";
	
КонецФункции

#КонецОбласти

#КонецЕсли