#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТокенАвторизации();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьТокенАвторизации();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяБезопасноеХранилищеБСП Тогда
		ПодготовитьТокенАвторизацииКЗаписиВБезопасноеХранилище(ТекущийОбъект);
	Иначе
		ТекущийОбъект.ТокенАвторизации = ТокенАвторизации;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяБезопасноеХранилищеБСП Тогда
		СохранитьТокенАвторизацииВБезопасномХранилище(ТекущийОбъект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТокенАвторизации()
	
	ИспользуетсяБезопасноеХранилищеБСП =
		Справочники.НастройкиАвторизацииМакс.ИспользуетсяБезопасноеХранилищеТокенаАвторизацииМакс();
	
	Если ИспользуетсяБезопасноеХранилищеБСП Тогда
		ТокенАвторизацииСохранен =
			Справочники.НастройкиАвторизацииМакс.ТокенАвторизацииМаксСуществуетВБезопасномХранилище(Объект.Ссылка)
			Или ЗначениеЗаполнено(Объект.ТокенАвторизации);
		ТокенАвторизации = ?(ТокенАвторизацииСохранен, МаскаСохраненногоТокена(), "");
		Возврат;
	КонецЕсли;
	
	ТокенАвторизацииСохранен = ЗначениеЗаполнено(Объект.ТокенАвторизации);
	ТокенАвторизации = Объект.ТокенАвторизации;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьТокенАвторизацииКЗаписиВБезопасноеХранилище(ТекущийОбъект)
	
	ТокенАвторизацииКЗаписи = "";
	УдалитьТокенАвторизации = Ложь;
	
	Если ТокенАвторизацииСохранен И ТокенАвторизации = МаскаСохраненногоТокена() Тогда
		Если ЗначениеЗаполнено(ТекущийОбъект.ТокенАвторизации) Тогда
			ТокенАвторизацииКЗаписи = ТекущийОбъект.ТокенАвторизации;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ТокенАвторизации) Тогда
		ТокенАвторизацииКЗаписи = ТокенАвторизации;
	Иначе
		УдалитьТокенАвторизации = Истина;
	КонецЕсли;
	
	ТекущийОбъект.ТокенАвторизации = "";
	
КонецПроцедуры

&НаСервере
Процедура СохранитьТокенАвторизацииВБезопасномХранилище(НастройкаАвторизации)
	
	Если ЗначениеЗаполнено(ТокенАвторизацииКЗаписи) Тогда
		Справочники.НастройкиАвторизацииМакс.ЗаписатьТокенАвторизацииМаксВБезопасноеХранилище(
			НастройкаАвторизации, ТокенАвторизацииКЗаписи);
		ТокенАвторизацииСохранен = Истина;
	Иначе
		Если УдалитьТокенАвторизации Тогда
			Справочники.НастройкиАвторизацииМакс.УдалитьТокенАвторизацииМаксИзБезопасногоХранилища(
				НастройкаАвторизации);
			ТокенАвторизацииСохранен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТокенАвторизацииКЗаписи = "";
	УдалитьТокенАвторизации = Ложь;
	ТокенАвторизации = ?(ТокенАвторизацииСохранен, МаскаСохраненногоТокена(), "");
	
КонецПроцедуры

&НаСервере
Функция МаскаСохраненногоТокена()
	
	Возврат Строка(УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти
