
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектыПечати.ЗагрузитьЗначения(Параметры.ОбъектыПечати);
	Если ОбъектыПечати.Количество() = 1 Тогда
		Организация = ОбъектыПечати[0].Значение;
	КонецЕсли;
	
	ИнициализироватьФорму();	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьКомандУстановитьСнятьФлажки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
		
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Изменения настроек печати реквизитов организации не сохранены'");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Настройки печати реквизитов организации были изменены.
			|Сохранить изменения?'");
	
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемВопросОСохраненииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение, 
		ТекстВопроса, 
		РежимДиалогаВопрос.ДаНет, , 
		КодВозвратаДиалога.Да, 
		НСтр("ru = 'Редактирование настроек печати реквизитов организации'"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РасчетныеСчетаПриИзменении(Элемент)
	
	РасчетныеСчетаПриИзмененииНаСервере();
	
КонецПроцедуры	

&НаКлиенте
Процедура КомпактноеОтображениеСчетовПриИзменении(Элемент)
	
	СформироватьПоНастройкам();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиРеквизитов

&НаКлиенте
Процедура НастройкиРеквизитовПриИзменении(Элемент)
	
	СформироватьПоНастройкам();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРеквизитовПечататьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НастройкиРеквизитов.ТекущиеДанные;
	
	Если ТекущиеДанные.Печатать = СостояниеФлагаНеопределено() Тогда
		ТекущиеДанные.Печатать = СостояниеФлагаВыключено();
	КонецЕсли;
	
	ИзменитьСвязанныеФлажки(Элементы.НастройкиРеквизитов.ТекущиеДанные);	
	УстановитьВидимостьКомандУстановитьСнятьФлажки();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРеквизитовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	РеквизитФормы = ЭтотОбъект[Элемент.Имя];
	Идентификатор = ПараметрыПеретаскивания.Значение;

	ЭлементДерева = РеквизитФормы.НайтиПоИдентификатору(Идентификатор);
	Если ЭлементДерева.Реквизит = "Логотип" Или ЭлементДерева.Группа = "ПечатьИПодпись" Тогда
			// строки дерева, содержащие картинки (логотип, подпись, печать), нельзя перетаскивать
		Выполнение = Ложь;
	КонецЕсли;
	Если ЭлементДерева.Группа = "РасчетныйСчет" Тогда
			// расчетные счета заполняются по своей логике, поэтому их не перетаскиваем в другие группы
		Выполнение = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭлементДерева.Группа) И Не ЗначениеЗаполнено(ЭлементДерева.Реквизит) Тогда
			// группы дерева нельзя перетаскивать
		Выполнение = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРеквизитовПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	МожноПереместить = Истина;
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	ПараметрыПеретаскивания.Действие           = ДействиеПеретаскивания.Перемещение;
	
	РеквизитФормы = ЭтотОбъект[Элемент.Имя];
	Если Строка <> Неопределено Тогда	
		
		ДанныеРодителя = РеквизитФормы.НайтиПоИдентификатору(Строка);
		Если ЗначениеЗаполнено(ДанныеРодителя.Реквизит) Тогда
			// нельзя перетаскивать на строку реквизита
			МожноПереместить = Ложь;
		КонецЕсли;
		
		Если ДанныеРодителя.Группа = "ПечатьИПодпись" Тогда
			// нельзя перетаскивать на группу печати и подписи
			МожноПереместить = Ложь;
		КонецЕсли;
		
		Если ДанныеРодителя.Группа = "РасчетныйСчет" Тогда
			// расчетные счета заполняются по своей логике, поэтому в эту группу нельзя перетаскивать новые реквизиты
			МожноПереместить = Ложь;
		КонецЕсли;
					
	КонецЕсли;
	
	Если МожноПереместить = Ложь Тогда
		СтандартнаяОбработка = Ложь;
		
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
		ПараметрыПеретаскивания.Действие           = ДействиеПеретаскивания.Отмена;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	УстановитьСнятьФлажки(НастройкиРеквизитов, СостояниеФлагаВключено(), Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	УстановитьСнятьФлажки(НастройкиРеквизитов, СостояниеФлагаВыключено(), Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПоУмолчанию(Команда)
	
	ПоУмолчаниюНаСервере();
	УстановитьВидимостьКомандУстановитьСнятьФлажки();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьНаСервере(НастройкиРеквизитов, Организация, РасчетныеСчета.ВыгрузитьЗначения(), КомпактноеОтображениеСчетов);
	Модифицированность = Ложь;
	
	ПараметрыЗакрытия = ПараметрыЗакрытия(Истина);
	Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДругойОрганизации(Команда)
	
	ИдентификаторОрганизации = Стрзаменить(Команда.Имя, "ЗаполнитьПоДругойОрганизации_", "");
	ИдентификаторОрганизации = СтрЗаменить(ИдентификаторОрганизации, "_", "-");
		
	ЗаполнитьПоДругойОрганизацииНаСервере(ИдентификаторОрганизации);
	УстановитьВидимостьКомандУстановитьСнятьФлажки();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьФорму()
	
	ЗаполнитьНастройки();
	ЗаполнитьСведенияОбОрганизации();
	
	ДобавитьКомандыЗаполненияПоДругимОрганизациям();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОбОрганизации()
	
	СведенияОбОрганизации = ПечатьРеквизитовОрганизацииУНФ.СведенияДляПечати(Организация, РасчетныеСчета.ВыгрузитьЗначения());
	АдресСведенийОбОрганизации = ПоместитьВоВременноеХранилище(СведенияОбОрганизации, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройки(ПоУмолчанию = Ложь, ИдентификаторДругойОрганизации = "")
	
	Настройки = ПечатьРеквизитовОрганизацииУНФ.НастройкиПечати(Организация, ПоУмолчанию, ИдентификаторДругойОрганизации);
	ЗначениеВРеквизитФормы(Настройки.НастройкиРеквизитов, "НастройкиРеквизитов");
	ПроставитьФлажкиГруппНастройкиПечати();
	
	РасчетныеСчета.Очистить();
	Если ЗначениеЗаполнено(Настройки.РасчетныеСчета) Тогда
		РасчетныеСчета.ЗагрузитьЗначения(Настройки.РасчетныеСчета);
	Иначе
		БанковскийСчетПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "БанковскийСчетПоУмолчанию");
		
		Если ЗначениеЗаполнено(БанковскийСчетПоУмолчанию) Тогда
			РасчетныеСчета.Добавить(БанковскийСчетПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	
	КомпактноеОтображениеСчетов = Настройки.КомпактноеОтображениеСчетов;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандыЗаполненияПоДругимОрганизациям()
	
	ЮридическоеФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮридическоеФизическоеЛицо");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка <> &Организация
		|	И НЕ Организации.ПометкаУдаления
		|	И Организации.ЮридическоеФизическоеЛицо = &ЮридическоеФизическоеЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЮридическоеФизическоеЛицо", ЮридическоеФизическоеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКомандуЗаполненияПоОрганизации(Выборка.Организация, Выборка.Наименование);	
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандуЗаполненияПоОрганизации(ОрганизацияДляЗаполнения, Наименование)
	
	Идентификатор = Строка(ОрганизацияДляЗаполнения.УникальныйИдентификатор());
	НаименованиеКоманды = СтрШаблон("ЗаполнитьПоДругойОрганизации_%1", Идентификатор);	
	НаименованиеКоманды = СтрЗаменить(НаименованиеКоманды, "-", "_");
	
	НоваяКоманда = Команды.Добавить(НаименованиеКоманды);
	НоваяКоманда.Действие                  = "ЗаполнитьПоДругойОрганизации";
	НоваяКоманда.Заголовок                 = Наименование;
	НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;
	
	НовыйЭлемент = Элементы.Добавить(
		НаименованиеКоманды, Тип("КнопкаФормы"), Элементы.ГруппаЗаполнитьПоДругимОрганизациям);
	НовыйЭлемент.ИмяКоманды  = НаименованиеКоманды;
	НовыйЭлемент.Отображение = ОтображениеКнопки.Текст;
			
КонецПроцедуры

&НаСервере
Процедура ПоУмолчаниюНаСервере()
	
	ЗаполнитьНастройки(Истина);
	СформироватьПоНастройкамПослеИзмененияНастроек();
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДругойОрганизацииНаСервере(ИдентификаторОрганизации)
	
	ЗаполнитьНастройки(Ложь, ИдентификаторОрганизации);
	СформироватьПоНастройкамПослеИзмененияНастроек();
		
КонецПроцедуры

&НаСервере
Процедура РасчетныеСчетаПриИзмененииНаСервере()
	
	ЗаполнитьСведенияОбОрганизации(); // чтобы в сведениях поменялись счета
	СформироватьПоНастройкамПослеИзмененияНастроек();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьФлажки(СтрокаНастроек, СостояниеФлага, УстанавливатьВидимостьФлажков = Ложь)
	
	Для Каждого НастройкаПечатнойФормы Из СтрокаНастроек.ПолучитьЭлементы() Цикл
		НастройкаПечатнойФормы.Печатать = СостояниеФлага;
		УстановитьСнятьФлажки(НастройкаПечатнойФормы, СостояниеФлага);
	КонецЦикла;
	
	СформироватьПоНастройкам();
	Если УстанавливатьВидимостьФлажков Тогда
		УстановитьВидимостьКомандУстановитьСнятьФлажки();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКомандУстановитьСнятьФлажки()
	
	ЕстьОтметки = Ложь;
	Для Каждого СтрокаНастройки Из НастройкиРеквизитов.ПолучитьЭлементы() Цикл
		Если СтрокаНастройки.Печатать Тогда
			ЕстьОтметки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьОтметки Тогда
		Элементы.НастройкиРеквизитовУстановитьФлажки.Видимость = Истина;
		Элементы.НастройкиРеквизитовСнятьФлажки.Видимость      = Ложь;
	Иначе
		Элементы.НастройкиРеквизитовУстановитьФлажки.Видимость = Ложь;
		Элементы.НастройкиРеквизитовСнятьФлажки.Видимость      = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	РеквизитыОрганизации = ПечатьРеквизитовОрганизацииУНФ.Печать(ОбъектыПечати.ВыгрузитьЗначения(), ОбъектыПечати);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПоНастройкам()
	
	РеквизитыОрганизации = СформироватьПоНастройкамНаСервере(НастройкиРеквизитов,
		АдресСведенийОбОрганизации,
		Организация,
		ОбъектыПечати,
		РасчетныеСчета.ВыгрузитьЗначения(), 
		КомпактноеОтображениеСчетов);
	
КонецПроцедуры

// серверный аналог СформироватьПоНастройкам для вызова, когда на сервере меняются настройки	
&НаСервере
Процедура СформироватьПоНастройкамПослеИзмененияНастроек()
	
	РеквизитыОрганизации = СформироватьПоНастройкамНаСервере(НастройкиРеквизитов,
		АдресСведенийОбОрганизации,
		Организация,
		ОбъектыПечати,
		РасчетныеСчета.ВыгрузитьЗначения(), 
		КомпактноеОтображениеСчетов);
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПоНастройкамНаСервере(Знач НастройкиРеквизитов, АдресСведенийОбОрганизации, Организация, ОбъектыПечати, 
	РасчетныеСчетаЗначения, КомпактноеОтображениеСчетов)
	
	Настройки = НастройкиДляПечатиИСохранения(НастройкиРеквизитов, РасчетныеСчетаЗначения, КомпактноеОтображениеСчетов);
	СведенияОбОрганизации = ПолучитьИзВременногоХранилища(АдресСведенийОбОрганизации);
	РеквизитыОрганизации = ПечатьРеквизитовОрганизацииУНФ.ПечатьПоНастройкамИСведениям(Организация,
		Настройки,
		СведенияОбОрганизации,
		ОбъектыПечати);
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьСвязанныеФлажки(ТекущиеДанные)
	
	РодительскийЭлемент = ТекущиеДанные.ПолучитьРодителя();
	Если РодительскийЭлемент <> Неопределено Тогда
		
		Если ФлажкиВГруппеОдинаковы(РодительскийЭлемент) Тогда
			РодительскийЭлемент.Печатать = ТекущиеДанные.Печатать;
		Иначе
			РодительскийЭлемент.Печатать = СостояниеФлагаНеопределено();
		КонецЕсли;
		
	КонецЕсли;
	
	ДочерниеЭлементы = ТекущиеДанные.ПолучитьЭлементы();
	Если ДочерниеЭлементы <> Неопределено Тогда
		Для Каждого Элемент Из ДочерниеЭлементы Цикл
			Элемент.Печатать = ТекущиеДанные.Печатать;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ФлажкиВГруппеОдинаковы(Группа)
	
	СоседниеЭлементы = Группа.ПолучитьЭлементы();
	Если СоседниеЭлементы.Количество() Тогда
		ФлагПервогоЭлемента = СоседниеЭлементы[0].Печатать;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Элемент Из СоседниеЭлементы Цикл
		Если ФлагПервогоЭлемента <> Элемент.Печатать Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СостояниеФлагаВыключено()
	Возврат 0;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СостояниеФлагаВключено()
	Возврат 1;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СостояниеФлагаНеопределено()
	Возврат 2;
КонецФункции

// Заполняет флажки групп настроек согласно флажкам подчиненных элементов:
//    0 - если все сняты
//    1 - если все проставлены
//    2 - если часть сняты, часть проставлены
//
&НаСервере
Процедура ПроставитьФлажкиГруппНастройкиПечати()
	
	Для Каждого ГруппаРезультата Из НастройкиРеквизитов.ПолучитьЭлементы() Цикл
		
		Если ГруппаРезультата.ПолучитьЭлементы().Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьПоставленныйФлажок = Ложь;
		ЕстьСнятыйФлажок = Ложь;
		Для Каждого СтрокаРезультата Из ГруппаРезультата.ПолучитьЭлементы() Цикл
			Если СтрокаРезультата.Печатать Тогда
				ЕстьПоставленныйФлажок = Истина;
			Иначе
				ЕстьСнятыйФлажок = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьПоставленныйФлажок И ЕстьСнятыйФлажок Тогда
			ГруппаРезультата.Печатать = СостояниеФлагаНеопределено();
		ИначеЕсли ЕстьПоставленныйФлажок Тогда
			ГруппаРезультата.Печатать = СостояниеФлагаВключено();
		Иначе
			ГруппаРезультата.Печатать = СостояниеФлагаВыключено();
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиДляПечатиИСохранения(НастройкиРеквизитов, РасчетныеСчетаЗначения, КомпактноеОтображениеСчетов)
	
	Результат = Новый Структура;
	Результат.Вставить("РасчетныеСчета", РасчетныеСчетаЗначения);
	Результат.Вставить("КомпактноеОтображениеСчетов", КомпактноеОтображениеСчетов);
	Результат.Вставить("НастройкиРеквизитов");
	
	ДеревоНастроек = ПечатьРеквизитовОрганизацииУНФ.НовоеДеревоНастроекПечати();
	
	// Не копируем дерево, т.к. поле Печатать у коллекций разных типов
	Для Каждого ГруппаНастроек Из НастройкиРеквизитов.ПолучитьЭлементы() Цикл
		ГруппаДереваНастроек = ДеревоНастроек.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(ГруппаДереваНастроек, ГруппаНастроек);
		Для Каждого СтрокаНастроек Из ГруппаНастроек.ПолучитьЭлементы() Цикл
			СтрокаДереваНастроек = ГруппаДереваНастроек.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДереваНастроек, СтрокаНастроек);
		КонецЦикла;
	КонецЦикла;
	
	Результат.НастройкиРеквизитов = ДеревоНастроек;
	
	Возврат Результат;
		
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьНаСервере(Знач НастройкиРеквизитов, Организация, РасчетныеСчетаЗначения, КомпактноеОтображениеСчетов)
	
	Настройки = НастройкиДляПечатиИСохранения(НастройкиРеквизитов, РасчетныеСчетаЗначения, КомпактноеОтображениеСчетов);
	ПечатьРеквизитовОрганизацииУНФ.ЗаписатьНастройкиПечати(Настройки, Организация);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемВопросОСохраненииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере(НастройкиРеквизитов, Организация, РасчетныеСчета.ВыгрузитьЗначения(), КомпактноеОтображениеСчетов);
		Модифицированность = Ложь;
		
		ПараметрыЗакрытия = ПараметрыЗакрытия(Истина);
		Закрыть(ПараметрыЗакрытия);

	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		
		ПараметрыЗакрытия = ПараметрыЗакрытия(Ложь);
		Закрыть(ПараметрыЗакрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗакрытия(НастройкиПечатиИзменены)
	
	ЕстьПодписьИПечать = ЕстьПодписьИПечать(РеквизитыОрганизации);
	
	Результат = Новый Структура;
	Результат.Вставить("НастройкиПечатиИзменены", НастройкиПечатиИзменены);
	Результат.Вставить("ЕстьПодписьИПечать",      ЕстьПодписьИПечать);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьПодписьИПечать(ТабличныйДокумент)
	
	Если Не УправлениеПечатью.НастройкиПечати().ИспользоватьПодписиИПечати Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Для Каждого Префикс Из УправлениеПечатью.ПрефиксыИменОбластейСПодписьюИПечатью() Цикл
			Если СтрНачинаетсяС(Рисунок.Имя, Префикс) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
