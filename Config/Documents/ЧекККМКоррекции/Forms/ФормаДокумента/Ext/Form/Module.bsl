&НаСервереБезКонтекста
Функция РеквизитыПредметаРасчета(Знач Номенклатура, Знач ДатаКоррекции)
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ЕдиницаИзмерения");
	СтруктураРеквизитов.Вставить("ВидСтавкиНДС");
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, СтруктураРеквизитов);
	СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(РеквизитыНоменклатуры.ВидСтавкиНДС, ДатаКоррекции);
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("ЕдиницаИзмерения", РеквизитыНоменклатуры.ЕдиницаИзмерения);
	ПараметрыНоменклатуры.Вставить("СтавкаНДС", СтавкаНДС);
	
	Возврат ПараметрыНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоддерживаемыеСНОКассойККМ()
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеККМЗавершение", ЭтотОбъект);
	ИдентификаторУстройства = ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ПодключаемоеОборудование");
	
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолучениеПараметровФискальногоУстройства(
		Оповещение,
		УникальныйИдентификатор,
		ИдентификаторУстройства);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипКассыККМОблачнаяККТ(Знач КассаККМ)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		ТипОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "ПодключаемоеОборудование.ТипОборудования");
		Если ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПробитьЧекЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		
		Если РезультатВыполнения.Свойство("СтатусВОблачнойКассе")
			И РезультатВыполнения.СтатусВОблачнойКассе = ОблачныеКассыКлиентСервер.СтатусОперацииВыполняется() Тогда
			
			Оповещение = Новый ОписаниеОповещения("ПробитьЧекЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ОборудованиеЧекопечатающиеОблачныеККТУНФКлиент.ПроверитьСтатусЧекаВОблаке(
				ЭтотОбъект,
				ДополнительныеПараметры.ОбщиеПараметры.ДокументОснование,
				Оповещение,
				ДополнительныеПараметры.ИдентификаторУстройстваФР,
				ДополнительныеПараметры.ОбщиеПараметры);
			
		Иначе
			
			Доступность = Истина;
			
			Объект.НомерСмены = РезультатВыполнения.НомерСменыККТ;
			Объект.НомерЧека =  РезультатВыполнения.НомерЧекаККТ;
			Объект.ПробитЧек = Истина;
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
			Записать(ПараметрыЗаписи);
			
			ТолькоПросмотр = Истина;
			Элементы.ФормаПробитьЧек.Доступность = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Доступность = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'При печати чека произошла ошибка.
			|Чек не напечатан на фискальном регистраторе.
			|Дополнительное описание:
			|%1'"), РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеККМЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ПоддерживаемыеСНОКассойККМ.Очистить();
	
	Если РезультатВыполнения.Результат Тогда
		
		СтрокаСНО      = РезультатВыполнения.ПараметрыККТ.КодыСистемыНалогообложения;
		МассивКодовСНО = СтрРазделить(СтрокаСНО, ",");
		
		Для Каждого КодСНО Из МассивКодовСНО Цикл
			
			СНО = МенеджерОборудованияРМККлиентСервер.СистемаНалогообложенияККТПоКоду(Число(КодСНО));
			ПоддерживаемыеСНОКассойККМ.Добавить(СНО);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Объект.СистемаНалогообложения)
			И ПоддерживаемыеСНОКассойККМ.НайтиПоЗначению(Объект.СистемаНалогообложения) = Неопределено Тогда
			
			ШаблонСообщения = НСтр("ru = 'Выбранная Касса ККМ не поддерживает систему налогообложения: %1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(Объект.СистемаНалогообложения));
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Объект.СистемаНалогообложения = Неопределено;
			
		КонецЕсли;
		
	Иначе
		
		ШаблонСообщения = НСтр("ru = 'Не удалось получить список систем налогообложения поддерживаемых кассой ККМ: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, РезультатВыполнения.ОписаниеОшибки);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		Объект.СистемаНалогообложения = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
