Процедура КорректировкаСписанияУчетЗатрат(ВидОперации)
	
	// Сформируем список состояний.
	КоличествоУравненийСЛУ = СформироватьДвиженияПоРегиструУзлыКорректировкиСтоимостиСписания();
	
	Если КоличествоУравненийСЛУ > 0 Тогда
		
		// Решим СЛУ и определим среднюю цену в каждом состоянии.
		РешениеНайдено = РешитьСЛУ();
		
		Если НЕ РешениеНайдено Тогда
			Возврат;
		КонецЕсли;
		
		// Скорректируем движения по состояниям.
		СформироватьКорректирующиеДвиженияПоРегиструУчетаЗатрат();
		
		// Распределим оставшиеся в состояниях копейки (результаты ошибок округления).
		РаспределитьСуммыБезКоличества(ВидОперации);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатрат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратВозвратыТекПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратСписания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратВозвратыПоРезервам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратВозвратыСвободные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратВозвраты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Уравнений нет"" КАК Поле1
		|ПОМЕСТИТЬ УчетЗатратБезУчетаВозвратов";
		
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры // КорректировкаСписанияУчетЗатрат()

Процедура РассчитатьСтоимостьВозвратов(ОкончательныйРасчет = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВтВозвраты") <> Неопределено Тогда
		Запрос.Текст = "УНИЧТОЖИТЬ ВтВозвраты;
						|УНИЧТОЖИТЬ Продажи";
		Запрос.Выполнить();
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаСтоимостьВозвратов(ОкончательныйРасчет);
	
	Запрос.УстановитьПараметр("Организация", ДополнительныеСвойства.ДляПроведения.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ДополнительныеСвойства.ДляПроведения.НачальнаяДатаПериода);
	Запрос.УстановитьПараметр("КонецПериода", ДополнительныеСвойства.ДляПроведения.КонечнаяДатаПериода);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ТаблицаОстатков = Неопределено;
	
	Если ОкончательныйРасчет Тогда
		
		Запрос = Новый Запрос;
		ТаблицаНоменклатуры = Результат.Выгрузить();
		Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
		Запрос.УстановитьПараметр("Организация", ДополнительныеСвойства.ДляПроведения.Организация);
		
		ГраницаДатаКон = ДополнительныеСвойства.ДляПроведения.КонечнаяДатаПериода;
		ГраницаДатаКон = Новый Граница(ГраницаДатаКон, ВидГраницы.Включая);
		Запрос.УстановитьПараметр("ГраницаДатаКон", ГраницаДатаКон);
		
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		Запрос.Текст = ТекстЗапросаСтоимостьВозвратовОкончательныйРасчет();
		
		ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
		ТаблицаОстатков.Индексы.Добавить("Организация, СтруктурнаяЕдиница, СчетУчета, Номенклатура, Характеристика, Партия, ЗаказПокупателя, ЗаказНаПроизводство");
		
	КонецЕсли;

	НаборЗаписейЗапасы = РегистрыНакопления.Запасы.СоздатьНаборЗаписей();
	НаборЗаписейЗапасы.Отбор.Регистратор.Установить(Ссылка);

	НаборЗаписейПродажи = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
	НаборЗаписейПродажи.Отбор.Регистратор.Установить(Ссылка);

	НаборЗаписейДоходыИРасходы = РегистрыНакопления.ДоходыИРасходы.СоздатьНаборЗаписей();
	НаборЗаписейДоходыИРасходы.Отбор.Регистратор.Установить(Ссылка);

	НаборЗаписейУправленческий = РегистрыБухгалтерии.Управленческий.СоздатьНаборЗаписей();
	НаборЗаписейУправленческий.Отбор.Регистратор.Установить(Ссылка);

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.КоличествоПродаж <> 0 Тогда
			
			ЦенаПродажи = ВыборкаДетальныеЗаписи.СуммаПродаж / ВыборкаДетальныеЗаписи.КоличествоПродаж;
			СуммаКорректировки = ВыборкаДетальныеЗаписи.СуммаВозвратов - ЦенаПродажи * ВыборкаДетальныеЗаписи.КоличествоВозвратов;
			
			ЦенаПродажиБезНДС = ВыборкаДетальныеЗаписи.СуммаБезНДСПродаж / ВыборкаДетальныеЗаписи.КоличествоПродаж;
			СуммаКорректировкиБезНДС = ВыборкаДетальныеЗаписи.СуммаБезНДСВозвратов - ЦенаПродажиБезНДС * ВыборкаДетальныеЗаписи.КоличествоВозвратов;
		Иначе
			СуммаКорректировки = 0;
			СуммаКорректировкиБезНДС = 0;
		КонецЕсли;
		
		Если ОкончательныйРасчет И ТаблицаОстатков <> Неопределено И Окр(СуммаКорректировки, 2) <> 0 Тогда
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
			СтруктураПоиска.Вставить("СтруктурнаяЕдиница", ВыборкаДетальныеЗаписи.СтруктурнаяЕдиница);
			СтруктураПоиска.Вставить("СчетУчета", ВыборкаДетальныеЗаписи.СчетУчета);
			СтруктураПоиска.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
			СтруктураПоиска.Вставить("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);
			СтруктураПоиска.Вставить("Партия", ВыборкаДетальныеЗаписи.Партия);
			СтруктураПоиска.Вставить("ЗаказПокупателя", ВыборкаДетальныеЗаписи.ЗаказПокупателя);
			СтруктураПоиска.Вставить("ЗаказНаПроизводство", ВыборкаДетальныеЗаписи.ЗаказНаПроизводство);
			
			СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
			Если СтрокиОстатков.Количество() = 0 ИЛИ СтрокиОстатков[0].Остаток = 0 Тогда
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		Если Окр(СуммаКорректировки, 2) <> 0 ИЛИ Окр(СуммаКорректировкиБезНДС, 2) <> 0 Тогда
			
			СуммыКорректировкиСтруктура = Новый Структура("СуммаКорректировки, СуммаКорректировкиБезНДС", СуммаКорректировки, СуммаКорректировкиБезНДС);
			
			СформироватьДвиженияПоРегиструУчетаЗатрат(
				НаборЗаписейЗапасы,
				НаборЗаписейУправленческий,
				ВыборкаДетальныеЗаписи,
				СуммыКорректировкиСтруктура,
				ВыборкаДетальныеЗаписи.ЭтоВозвратПрошлогоПериода,
				НСтр("ru = 'Себестоимость возврата от покупателя'"));
			
			НоваяСтрока = НаборЗаписейПродажи.Добавить();
			НоваяСтрока.Период = Дата;
			НоваяСтрока.Регистратор = Ссылка;
			НоваяСтрока.Организация = ВыборкаДетальныеЗаписи.Организация;
			НоваяСтрока.ЗаказПокупателя = ВыборкаДетальныеЗаписи.ЗаказПродажи;
			НоваяСтрока.Подразделение = ВыборкаДетальныеЗаписи.Подразделение;
			НоваяСтрока.Ответственный = ВыборкаДетальныеЗаписи.Ответственный;
			НоваяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			НоваяСтрока.Характеристика = ВыборкаДетальныеЗаписи.Характеристика;
			НоваяСтрока.Партия = ВыборкаДетальныеЗаписи.Партия;
			НоваяСтрока.Документ = ВыборкаДетальныеЗаписи.ДокументПродажи;
			НоваяСтрока.СтавкаНДС = ВыборкаДетальныеЗаписи.СтавкаНДС;
			НоваяСтрока.Себестоимость = СуммаКорректировки;
			НоваяСтрока.СебестоимостьБезНДС = СуммаКорректировкиБезНДС;
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ЗаказПродажи) 
				И ВыборкаДетальныеЗаписи.УчетПотребностиПоСкладам = Истина Тогда
				НоваяСтрока.Склад = ВыборкаДетальныеЗаписи.СтруктурнаяЕдиница;
			КонецЕсли;
			
			НоваяСтрока = НаборЗаписейДоходыИРасходы.Добавить();
			НоваяСтрока.Период = Дата;
			НоваяСтрока.Регистратор = Ссылка;
			НоваяСтрока.Организация = ВыборкаДетальныеЗаписи.Организация;
			НоваяСтрока.СтруктурнаяЕдиница = ВыборкаДетальныеЗаписи.Подразделение;
			НоваяСтрока.ЗаказПокупателя = ВыборкаДетальныеЗаписи.ЗаказПродажи;
			НоваяСтрока.НаправлениеДеятельности = ВыборкаДетальныеЗаписи.НаправлениеДеятельностиПродажи;
			НоваяСтрока.СчетУчета = ВыборкаДетальныеЗаписи.НаправлениеДеятельностиПродажиСчетУчетаСебестоимостиПродаж;
			НоваяСтрока.СуммаРасходов = СуммаКорректировки;
			НоваяСтрока.СодержаниеПроводки = СодержанияПроводок.ОтражениеРасходов();
			
			НоваяСтрока = НаборЗаписейУправленческий.Добавить();
			НоваяСтрока.Период = Дата;
			НоваяСтрока.Регистратор = Ссылка;
			НоваяСтрока.Организация = ВыборкаДетальныеЗаписи.Организация;
			НоваяСтрока.СценарийПланирования = Справочники.СценарииПланирования.Фактический;
			НоваяСтрока.СчетДт = ВыборкаДетальныеЗаписи.НаправлениеДеятельностиПродажиСчетУчетаСебестоимостиПродаж;
			НоваяСтрока.СчетКт = ВыборкаДетальныеЗаписи.СчетУчета;
			НоваяСтрока.Содержание = СодержанияПроводок.ОтражениеРасходов();
			НоваяСтрока.Сумма = СуммаКорректировки;
			
		КонецЕсли;
		
	КонецЦикла;

	НаборЗаписейЗапасы.Записать(Ложь);
	НаборЗаписейПродажи.Записать(Ложь);
	НаборЗаписейДоходыИРасходы.Записать(Ложь);
	НаборЗаписейУправленческий.Записать(Ложь);

КонецПроцедуры

Процедура РассчитатьФактическуюСебестоимостьВыпуска(ВидОперации)
	
	КорректировкаСписанияУчетЗатрат(ВидОперации);
	
	// Уничтожим временные таблицы.
	МенеджерВременныхТаблиц = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Если МенеджерВременныхТаблиц.Таблицы.Количество() > 0 Тогда
		
		ЧастиЗапроса = Новый Массив;
		
		Для Каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл
			ЧастиЗапроса.Добавить(СтрШаблон("УНИЧТОЖИТЬ %1", ВременнаяТаблица.ПолноеИмя));
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(ЧастиЗапроса, "; ");
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.ВыполнитьПакет();
		
	КонецЕсли;
	
	// Очистим набор записей УзлыКорректировкиСтоимостиСписания.
	НаборЗаписей = РегистрыСведений.УзлыКорректировкиСтоимостиСписания.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

Процедура ЗакрытьОстаткиБезКоличества()
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЭтапыПроизводства") 
		ИЛИ НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЗакрытиеСуммБезКоличества") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДополнительныеСвойства.ДляПроведения.Организация);
	Запрос.УстановитьПараметр("ДатаНач", ДополнительныеСвойства.ДляПроведения.НачальнаяДатаПериода);
	Запрос.УстановитьПараметр("ДатаКон", ДополнительныеСвойства.ДляПроведения.КонечнаяДатаПериода);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапасыОстаткиИОбороты.Организация КАК Организация,
	|	ЗапасыОстаткиИОбороты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВЫБОР
	|		КОГДА ЗапасыОстаткиИОбороты.СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы
	|			ТОГДА ВЫРАЗИТЬ(ЗапасыОстаткиИОбороты.СтруктурнаяЕдиница КАК Справочник.СтруктурныеЕдиницы).ТипСтруктурнойЕдиницы
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.ПустаяСсылка)
	|	КОНЕЦ КАК ТипСтруктурнойЕдиницы,
	|	ЗапасыОстаткиИОбороты.СчетУчета КАК СчетУчета,
	|	ЗапасыОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|	ЗапасыОстаткиИОбороты.Характеристика КАК Характеристика,
	|	ЗапасыОстаткиИОбороты.Партия КАК Партия,
	|	ЗапасыОстаткиИОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗапасыОстаткиИОбороты.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЗапасыОстаткиИОбороты.СуммаБезНДСКонечныйОстаток КАК СуммаБезНДС,
	|	ЗапасыОстаткиИОбороты.СуммаКонечныйОстаток КАК Сумма,
	|	ЗапасыОстаткиИОбороты.Номенклатура.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	ЗапасыОстаткиИОбороты.Номенклатура.СчетУчетаЗатрат.ТипСчета КАК СчетУчетаЗатратТипСчета,
	|	ЗапасыОстаткиИОбороты.Номенклатура.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	РегистрНакопления.Запасы.ОстаткиИОбороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			Период,
	|			,
	|			Организация = &Организация
	|				И Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И СчетУчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Запасы)
	|				И СтруктурнаяЕдиница.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Склад)) КАК ЗапасыОстаткиИОбороты
	|ГДЕ
	|	ЗапасыОстаткиИОбороты.КоличествоКонечныйОстаток = 0
	|	И (ЗапасыОстаткиИОбороты.СуммаКонечныйОстаток <> 0 ИЛИ ЗапасыОстаткиИОбороты.СуммаБезНДСКонечныйОстаток <> 0)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	НаборЗаписейЗапасы = РегистрыНакопления.Запасы.СоздатьНаборЗаписей();
	НаборЗаписейЗапасы.Отбор.Регистратор.Установить(ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	НаборЗаписейДоходыИРасходы = РегистрыНакопления.ДоходыИРасходы.СоздатьНаборЗаписей();
	НаборЗаписейДоходыИРасходы.Отбор.Регистратор.Установить(ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	НаборЗаписейУправленческий = РегистрыБухгалтерии.Управленческий.СоздатьНаборЗаписей();
	НаборЗаписейУправленческий.Отбор.Регистратор.Установить(ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		  
		// Движения по регистру Запасы.
		НоваяСтрока = НаборЗаписейЗапасы.Добавить();
		НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Расход;
		НоваяСтрока.Период = Дата;
		НоваяСтрока.Регистратор = Ссылка;
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.СтруктурнаяЕдиница = Выборка.СтруктурнаяЕдиница;
		НоваяСтрока.СчетУчета = Выборка.СчетУчета;
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Характеристика = Выборка.Характеристика;
		НоваяСтрока.Партия = Выборка.Партия;
		НоваяСтрока.ЗаказПокупателя = Выборка.ЗаказПокупателя;	
		НоваяСтрока.ЗаказНаПроизводство = Выборка.ЗаказНаПроизводство;	
		НоваяСтрока.ФиксированнаяСтоимость = Истина;
		НоваяСтрока.Сумма = Выборка.Сумма;
		НоваяСтрока.СуммаБезНДС = Выборка.СуммаБезНДС;
		НоваяСтрока.СодержаниеПроводки = СодержанияПроводок.ЗакрытиеОстаткаСуммБезКоличества();

		// Движения по регистру ДоходыИРасходы.
		НоваяСтрока = НаборЗаписейДоходыИРасходы.Добавить();
		НоваяСтрока.Период = Дата;
		НоваяСтрока.Регистратор = Ссылка;
		НоваяСтрока.Организация = Выборка.Организация;
		Если Выборка.ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.Подразделение Тогда
			НоваяСтрока.СтруктурнаяЕдиница = Выборка.СтруктурнаяЕдиница;
		Иначе
			НоваяСтрока.СтруктурнаяЕдиница = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
		КонецЕсли;
		НоваяСтрока.ЗаказПокупателя = Выборка.ЗаказПокупателя;
		НоваяСтрока.НаправлениеДеятельности = Выборка.НаправлениеДеятельности;
		Если Выборка.СчетУчетаЗатратТипСчета = Перечисления.ТипыСчетов.Расходы
			ИЛИ Выборка.СчетУчетаЗатратТипСчета = Перечисления.ТипыСчетов.ПрочиеРасходы Тогда
			НоваяСтрока.СчетУчета = Выборка.СчетУчетаЗатрат;
			НоваяСтрока.СуммаРасходов = Выборка.Сумма;
		ИначеЕсли Выборка.Сумма > 0 Тогда
			НоваяСтрока.СчетУчета = ПланыСчетов.Управленческий.ПрочиеРасходы;
			НоваяСтрока.СуммаРасходов = Выборка.Сумма;
		Иначе
			НоваяСтрока.СчетУчета = ПланыСчетов.Управленческий.ПрочиеДоходы;
			НоваяСтрока.СуммаРасходов = - Выборка.Сумма;
		КонецЕсли;
		НоваяСтрока.СодержаниеПроводки = СодержанияПроводок.ЗакрытиеОстаткаСуммБезКоличества();
		
		// Движения по регистру Управленческий.
		НоваяСтрока = НаборЗаписейУправленческий.Добавить();
		НоваяСтрока.Период = Дата;
		НоваяСтрока.Регистратор = Ссылка;
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.СценарийПланирования = Справочники.СценарииПланирования.Фактический;
		Если Выборка.СчетУчетаЗатратТипСчета = Перечисления.ТипыСчетов.Расходы
			ИЛИ Выборка.СчетУчетаЗатратТипСчета = Перечисления.ТипыСчетов.ПрочиеРасходы Тогда
			НоваяСтрока.СчетДт = Выборка.СчетУчетаЗатрат;
			НоваяСтрока.СчетКт = Выборка.СчетУчета;
			НоваяСтрока.Сумма = Выборка.Сумма;
		ИначеЕсли Выборка.Сумма > 0 Тогда
			НоваяСтрока.СчетДт = ПланыСчетов.Управленческий.ПрочиеРасходы;
			НоваяСтрока.СчетКт = Выборка.СчетУчета;
			НоваяСтрока.Сумма = Выборка.Сумма;
		Иначе
			НоваяСтрока.СчетДт = Выборка.СчетУчета;
			НоваяСтрока.СчетКт = ПланыСчетов.Управленческий.ПрочиеДоходы;
			НоваяСтрока.Сумма = - Выборка.Сумма;
		КонецЕсли;
		НоваяСтрока.Содержание = СодержанияПроводок.ЗакрытиеОстаткаСуммБезКоличества();
					
	КонецЦикла;
	
	НаборЗаписейЗапасы.Записать(Ложь);
	НаборЗаписейДоходыИРасходы.Записать(Ложь);
	НаборЗаписейУправленческий.Записать(Ложь);
	
КонецПроцедуры

Функция РаспределитьВозвратыПоПродажам(Запрос)
	
	ТаблицаВозвратов = СоздатьТаблицуВозвратов();
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбходОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ОбходОрганизация.Следующий() Цикл
		ОбходСтруктурнаяЕдиница = ОбходОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ОбходСтруктурнаяЕдиница.Следующий() Цикл
			ОбходСчетУчета = ОбходСтруктурнаяЕдиница.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ОбходСчетУчета.Следующий() Цикл
				ОбходНоменклатура = ОбходСчетУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ОбходНоменклатура.Следующий() Цикл
					ОбходХарактеристика = ОбходНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ОбходХарактеристика.Следующий() Цикл
						ОбходПартия = ОбходХарактеристика.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ОбходПартия.Следующий() Цикл
							ОбходДокПродажи = ОбходПартия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							Пока ОбходДокПродажи.Следующий() Цикл
								ОбходСуммаБезНДС = ОбходДокПродажи.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
								Пока ОбходСуммаБезНДС.Следующий() Цикл
									ОбходСуммаВозврат = ОбходСуммаБезНДС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
									Пока ОбходСуммаВозврат.Следующий() Цикл
										ОбходКолВозврат = ОбходСуммаВозврат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
										Пока ОбходКолВозврат.Следующий() Цикл
											
											КоличествоОсталось = ОбходКолВозврат.КоличествоВозврат;
											СуммаОсталось = ОбходКолВозврат.СуммаВозврат;
											СуммаБезНДСОсталось = ОбходКолВозврат.СуммаБезНДСВозврат;
											
											Если КоличествоОсталось > 0 Тогда
												ВыборкаДетали = ОбходКолВозврат.Выбрать();
												Пока ВыборкаДетали.Следующий() Цикл
													РаспределитьПоЗаписи(
														ВыборкаДетали,
														ТаблицаВозвратов,
														КоличествоОсталось,
														СуммаОсталось,
														СуммаБезНДСОсталось);
													
													Если КоличествоОсталось = 0 Тогда
														Прервать;
													КонецЕсли;
												КонецЦикла;
											КонецЕсли;
											
										КонецЦикла;
									КонецЦикла;
								КонецЦикла;
							КонецЦикла;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаВозвратов;
	
КонецФункции

Процедура РаспределитьПоЗаписи(Запись, Таблица, КоличествоОсталось, СуммаОсталось, СуммаБезНДСОсталось)
	
	Если КоличествоОсталось <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Таблица.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
	
	Если КоличествоОсталось <= Запись.КоличествоПродано Тогда
		
		НоваяСтрока.КоличествоРаспределено = КоличествоОсталось;
		НоваяСтрока.СуммаРаспределено = СуммаОсталось;
		НоваяСтрока.СуммаБезНДСРаспределено = СуммаБезНДСОсталось;
		
		КоличествоОсталось = 0;
		СуммаОсталось = 0;
		СуммаБезНДСОсталось = 0;
		
	Иначе
		
		НоваяСтрока.КоличествоРаспределено = Запись.КоличествоПродано;
		НоваяСтрока.СуммаРаспределено = Запись.СуммаПродано;
		НоваяСтрока.СуммаБезНДСРаспределено = Запись.СуммаБезНДСПродано;
		
		КоличествоОсталось = КоличествоОсталось - Запись.КоличествоПродано;
		СуммаОсталось = СуммаОсталось - Запись.СуммаПродано;
		СуммаБезНДСОсталось = СуммаБезНДСОсталось - Запись.СуммаБезНДСПродано;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьТаблицуВозвратов()
	
