	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ПеремещениеЗапасов"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ПриходнаяНакладная"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ЧекККМВозврат"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ЧекККМ"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ОтчетОПереработке"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.АвансовыйОтчет"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ЗаказПокупателя"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ОтчетОРозничныхПродажах"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ПересортицаЗапасов"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ОтчетКомиссионераОСписании"));
	МассивТиповДокументПродажи.Добавить(Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями"));
	ТипДокументПродажи = Новый ОписаниеТипов(МассивТиповДокументПродажи);
		
	ТаблицаВозвратов = Новый ТаблицаЗначений;
