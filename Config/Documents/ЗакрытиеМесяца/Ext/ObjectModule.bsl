	ТаблицаВозвратов.Колонки.Добавить("Характеристика", ТипХарактеристики);
	ТаблицаВозвратов.Колонки.Добавить("Партия", ТипПартии);
	ТаблицаВозвратов.Колонки.Добавить("ЗаказПокупателя", ТипЗаказПокупателя);
	ТаблицаВозвратов.Колонки.Добавить("ЗаказНаПроизводство", ТипЗаказНаПроизводство);
	ТаблицаВозвратов.Колонки.Добавить("НомерУзла", ТипУзел);
	ТаблицаВозвратов.Колонки.Добавить("КоличествоПродано", ТипКоличество);
	ТаблицаВозвратов.Колонки.Добавить("СуммаБезНДСПродано", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("СуммаПродано", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("КоличествоВозврат", ТипКоличество);
	ТаблицаВозвратов.Колонки.Добавить("СуммаБезНДСВозврат", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("СуммаВозврат", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("СуммаБезНДСРаспределено", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("КоличествоРаспределено", ТипКоличество);
	ТаблицаВозвратов.Колонки.Добавить("СуммаРаспределено", ТипСумма);
	ТаблицаВозвратов.Колонки.Добавить("ДокументПродажи", ТипДокументПродажи);
	
	Возврат ТаблицаВозвратов;
	
КонецФункции

Функция СформироватьМатрицуУзловДляРасчетаСистемЛинейныхУравнений(ЗапросОбщий)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УзлыКорректировкиСтоимостиСписания.НомерУзла КАК НомерУравнения,
		|	УзлыКорректировкиСтоимостиСписания.Количество КАК Количество,
		|	УзлыКорректировкиСтоимостиСписания.Сумма КАК Сумма,
		|	УзлыКорректировкиСтоимостиСписания.СуммаБезНДС КАК СуммаБезНДС,
		|	УзлыКорректировкиСтоимостиСписания.СуммаИнт КАК СуммаИнт,
		|	УзлыКорректировкиСтоимостиСписания.СуммаБезНДСИнт КАК СуммаБезНДСИнт
		|ИЗ
		|	РегистрСведений.УзлыКорректировкиСтоимостиСписания КАК УзлыКорректировкиСтоимостиСписания
		|ГДЕ
		|	УзлыКорректировкиСтоимостиСписания.Регистратор = &Регистратор";

	Запрос.Параметры.Вставить("Регистратор", ЗапросОбщий.Параметры.Регистратор);

	Возврат Запрос.Выполнить();

КонецФункции

Функция СформироватьМатрицуСвязейДляРасчетаСистемЛинейныхУравнений(ЗапросОбщий, ИмяПоляСуммы = "Сумма")

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ЗапросОбщий.МенеджерВременныхТаблиц;

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_СвязиСырые") <> Неопределено Тогда
		Запрос.Текст = "УНИЧТОЖИТЬ ВТ_СвязиСырые;
					|	УНИЧТОЖИТЬ МатрицаСвернуто";
		Запрос.Выполнить();
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ
		|	УзелПриемник.НомерУзла КАК НомерУравнения,
		|	УчетЗатрат.НомерУзла КАК НомерПеременной,
		|	СУММА((&ВесСвязи) * -1.0) КАК ВесСвязиСумма
		|ПОМЕСТИТЬ ВТ_СвязиСырые
		|ИЗ
		|	УчетЗатрат КАК УчетЗатрат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_УзлыКорректировки КАК УзелПриемник
		|		ПО УчетЗатрат.Организация = УзелПриемник.Организация
		|			И УчетЗатрат.СтруктурнаяЕдиница = УзелПриемник.СтруктурнаяЕдиница
		|			И УчетЗатрат.СчетУчета = УзелПриемник.СчетУчета
		|			И УчетЗатрат.Номенклатура = УзелПриемник.Номенклатура
		|			И УчетЗатрат.Характеристика = УзелПриемник.Характеристика
		|			И УчетЗатрат.Партия = УзелПриемник.Партия
		|			И УчетЗатрат.ЗаказПокупателя = УзелПриемник.ЗаказПокупателя
		|			И УчетЗатрат.ЗаказНаПроизводство = УзелПриемник.ЗаказНаПроизводство
		|ГДЕ
		|	УзелПриемник.НомерУзла <> УчетЗатрат.НомерУзла
		|
		|СГРУППИРОВАТЬ ПО
		|	УзелПриемник.НомерУзла,
		|	УчетЗатрат.НомерУзла
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СвязиСырые.НомерУравнения КАК НомерУравнения,
		|	ВТ_СвязиСырые.НомерПеременной КАК НомерПеременной,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Узел.Количество, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(ВТ_СвязиСырые.ВесСвязиСумма
		|				/ Узел.Количество КАК ЧИСЛО(23, 10))
		|	КОНЕЦ КАК Количество
		|ПОМЕСТИТЬ МатрицаСвернуто
		|ИЗ
		|	ВТ_СвязиСырые КАК ВТ_СвязиСырые
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УзлыКорректировки КАК Узел
		|		ПО ВТ_СвязиСырые.НомерУравнения = Узел.НомерУзла
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МатрицаСвернуто.НомерУравнения КАК НомерУравнения,
		|	МатрицаСвернуто.НомерПеременной КАК НомерПеременной,
		|	МатрицаСвернуто.Количество КАК Количество
		|ИЗ
		|	МатрицаСвернуто КАК МатрицаСвернуто
		|ГДЕ
		|	МатрицаСвернуто.Количество <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_УзлыКорректировки.НомерУзла,
		|	ВТ_УзлыКорректировки.НомерУзла,
		|	1
		|ИЗ
		|	ВТ_УзлыКорректировки КАК ВТ_УзлыКорректировки
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерУравнения,
		|	НомерПеременной";

	ВесСвязи = "ВЫБОР КОГДА УчетЗатрат.Количество <> 0
				|		ТОГДА УчетЗатрат.Количество
				|		ИНАЧЕ УчетЗатрат." + ИмяПоляСуммы + "
				|	КОНЕЦ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВесСвязи", ВесСвязи);

	Запрос.УстановитьПараметр("Регистратор", ЗапросОбщий.Параметры.Регистратор);
	Возврат Запрос.Выполнить();

КонецФункции

