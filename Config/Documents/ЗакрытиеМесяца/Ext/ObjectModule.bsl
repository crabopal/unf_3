	|ВЫБРАТЬ
	|	ТаблицаТекущихОстатковПартий.Организация КАК Организация,
	|	ТаблицаТекущихОстатковПартий.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ТаблицаТекущихОстатковПартий.СчетУчета КАК СчетУчета,
	|	ТаблицаТекущихОстатковПартий.Номенклатура КАК Номенклатура,
	|	ТаблицаТекущихОстатковПартий.Характеристика КАК Характеристика,
	|	ТаблицаТекущихОстатковПартий.Партия КАК Партия,
	|	ТаблицаТекущихОстатковПартий.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ТаблицаТекущихОстатковПартий.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ТаблицаТекущихОстатковПартий.КоличествоОстаток КАК КоличествоОстаток,
	|	ТаблицаТекущихОстатковПартий.КоличествоОстатокНаКонецПериода КАК КоличествоОстатокНаКонецПериода,
	|	ТаблицаТекущихОстатковПартий.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	|	ТаблицаТекущихОстатковПартий.СуммаОстаток КАК СуммаОстаток,
	|	ТаблицаТекущихОстатковПартий.СуммаИнтОстаток КАК СуммаИнтОстаток,
	|	ТаблицаТекущихОстатковПартий.СуммаБезНДСИнтОстаток КАК СуммаБезНДСИнтОстаток,
	|	ТаблицаТекущихОстатковПартий.Период КАК Период
	|ПОМЕСТИТЬ ТаблицаОстатковПартий
	|ИЗ
	|	ТаблицаТекущихОстатковПартий КАК ТаблицаТекущихОстатковПартий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаТекущихОстатковПартий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	ПериодыПартий КАК ПериодыПартий";
	
	// Для определения партий по ФИФО используется итерационный алгоритм
	Результат = Запрос.Выполнить();
	Пока НЕ Результат.Пустой() Цикл
		//@skip-check query-in-loop
		Результат = Запрос.Выполнить();
	КонецЦикла;
	
	// Уменьшаем количество и сумму прихода в узлах, на количество и сумму
	// "зафиксированного" конечного остатка.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.Организация КАК Организация,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.СчетУчета КАК СчетУчета,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.Номенклатура КАК Номенклатура,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.Характеристика КАК Характеристика,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.Партия КАК Партия,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ (ТаблицаУзлыКорректировкиСтоимостиСписания.СуммаБезНДС * ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.СуммаБезНДСОстаток, 0)) / (ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0))
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ (ТаблицаУзлыКорректировкиСтоимостиСписания.Сумма * ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.СуммаОстаток, 0)) / (ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0))
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ (ТаблицаУзлыКорректировкиСтоимостиСписания.СуммаИнт * ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.СуммаИнтОстаток, 0)) / (ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0))
	|	КОНЕЦ КАК СуммаИнт,
	|	ВЫБОР
	|		КОГДА ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ (ТаблицаУзлыКорректировкиСтоимостиСписания.СуммаБезНДСИнт * ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.СуммаБезНДСИнтОстаток, 0)) / (ТаблицаУзлыКорректировкиСтоимостиСписания.Количество - ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстатокНаКонецПериода, 0) + ЕСТЬNULL(ТаблицаОстатковПартий.КоличествоОстаток, 0))
	|	КОНЕЦ КАК СуммаБезНДСИнт
	|ИЗ
	|	ТаблицаУзлыКорректировкиСтоимостиСписания КАК ТаблицаУзлыКорректировкиСтоимостиСписания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОстатковПартий КАК ТаблицаОстатковПартий
	|		ПО ТаблицаУзлыКорректировкиСтоимостиСписания.Организация = ТаблицаОстатковПартий.Организация
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.СтруктурнаяЕдиница = ТаблицаОстатковПартий.СтруктурнаяЕдиница
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.СчетУчета = ТаблицаОстатковПартий.СчетУчета
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.Номенклатура = ТаблицаОстатковПартий.Номенклатура
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.Характеристика = ТаблицаОстатковПартий.Характеристика
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.Партия = ТаблицаОстатковПартий.Партия
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.ЗаказПокупателя = ТаблицаОстатковПартий.ЗаказПокупателя
	|			И ТаблицаУзлыКорректировкиСтоимостиСписания.ЗаказНаПроизводство = ТаблицаОстатковПартий.ЗаказНаПроизводство";
	
	Запрос.Текст = Запрос.Текст + ТекстОбъединитьВсе();
	Запрос.Текст = Запрос.Текст + ТекстЗапросаУзлыКорректировкиСтоимостиСписания(Перечисления.МетодОценкиЗапасов.ПоСредней);
	
	НомерУзла = 0;
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		НаборЗаписей = РегистрыСведений.УзлыКорректировкиСтоимостиСписания.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
		НаборЗаписей.Записать(Истина);
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НомерУзла = НомерУзла + 1;
			НовыйУзел = НаборЗаписей.Добавить();
			НовыйУзел.НомерУзла = НомерУзла;
			НовыйУзел.Регистратор = Ссылка;
			НовыйУзел.Период = Дата;
			ЗаполнитьЗначенияСвойств(НовыйУзел, Выборка);
		КонецЦикла;
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
	
	// Первое приближение (решение на первой итерации).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УзлыКорректировкиСтоимостиСписания.НомерУзла,
	|	УзлыКорректировкиСтоимостиСписания.СуммаБезНДС КАК СуммаБезНДС,
	|	УзлыКорректировкиСтоимостиСписания.Сумма,
	|	УзлыКорректировкиСтоимостиСписания.СуммаИнт КАК СуммаИнт,
	|	УзлыКорректировкиСтоимостиСписания.СуммаБезНДСИнт КАК СуммаБезНДСИнт
	|ПОМЕСТИТЬ ТаблицаРешений
	|ИЗ
	|	РегистрСведений.УзлыКорректировкиСтоимостиСписания КАК УзлыКорректировкиСтоимостиСписания
	|ГДЕ
	|	УзлыКорректировкиСтоимостиСписания.Регистратор = &Регистратор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерУзла
	|";
	Запрос.Выполнить();
	
	Возврат НомерУзла;
	
КонецФункции

Функция РешитьСЛУ()

	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаНач", ДополнительныеСвойства.ДляПроведения.НачальнаяДатаПериода);
	Запрос.УстановитьПараметр("ДатаКон", ДополнительныеСвойства.ДляПроведения.КонечнаяДатаПериода);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("Организация", ДополнительныеСвойства.ДляПроведения.Организация);

	Запрос.Текст = ТекстЗапросаВозвраты();
	ТаблицаВозвратов = РаспределитьВозвратыПоПродажам(Запрос);

	Запрос.УстановитьПараметр("ТаблицаВозвратов", ТаблицаВозвратов);

	Запрос.Текст = ТекстЗапросаУчетЗатрат()
					+ ОбщегоНазначения.РазделительПакетаЗапросов()
					+ ТекстЗапросаВТУзлыКорректировки();
	Запрос.Выполнить();

	ИсточникДанныхУзлов = СформироватьМатрицуУзловДляРасчетаСистемЛинейныхУравнений(Запрос);

	РешениеСумма       = РешитьСистемуЛинейныхУравнений(Запрос, ИсточникДанныхУзлов, "Сумма");
	РешениеСуммаБезНДС = РешитьСистемуЛинейныхУравнений(Запрос, ИсточникДанныхУзлов, "СуммаБезНДС");

	Если ПолучитьФункциональнуюОпцию("ПередачаТоваровМеждуОрганизациями") Тогда
		РешениеСуммаИнт       = РешитьСистемуЛинейныхУравнений(Запрос, ИсточникДанныхУзлов, "СуммаИнт");
		РешениеСуммаБезНДСИнт = РешитьСистемуЛинейныхУравнений(Запрос, ИсточникДанныхУзлов, "СуммаБезНДСИнт");
	Иначе
		РешениеСуммаИнт       = ПустоеРешениеСЛУ();
		РешениеСуммаБезНДСИнт = ПустоеРешениеСЛУ();
	КонецЕсли;

	Запрос.УстановитьПараметр("РешениеСумма",          РешениеСумма);
	Запрос.УстановитьПараметр("РешениеСуммаБезНДС",    РешениеСуммаБезНДС);
	Запрос.УстановитьПараметр("РешениеСуммаИнт",       РешениеСуммаИнт);
	Запрос.УстановитьПараметр("РешениеСуммаБезНДСИнт", РешениеСуммаБезНДСИнт);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	РешениеСумма.НомерУзла КАК НомерУзла,
	|	РешениеСумма.Решение1 КАК Решение
	|ПОМЕСТИТЬ РешениеСумма
	|ИЗ
	|	&РешениеСумма КАК РешениеСумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеСуммаБезНДС.НомерУзла КАК НомерУзла,
	|	РешениеСуммаБезНДС.Решение1 КАК Решение
	|ПОМЕСТИТЬ РешениеСуммаБезНДС
	|ИЗ
	|	&РешениеСуммаБезНДС КАК РешениеСуммаБезНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеСуммаИнт.НомерУзла КАК НомерУзла,
	|	РешениеСуммаИнт.Решение1 КАК Решение
	|ПОМЕСТИТЬ РешениеСуммаИнт
	|ИЗ
	|	&РешениеСуммаИнт КАК РешениеСуммаИнт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеСуммаБезНДСИнт.НомерУзла КАК НомерУзла,
	|	РешениеСуммаБезНДСИнт.Решение1 КАК Решение
	|ПОМЕСТИТЬ РешениеСуммаБезНДСИнт
	|ИЗ
	|	&РешениеСуммаБезНДСИнт КАК РешениеСуммаБезНДСИнт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаРешений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеСумма.НомерУзла КАК НомерУзла,
	|	ЕСТЬNULL(РешениеСумма.Решение, 0) КАК Сумма,
	|	ЕСТЬNULL(РешениеСуммаБезНДС.Решение, 0) КАК СуммаБезНДС,
	|	ЕСТЬNULL(РешениеСуммаИнт.Решение, 0) КАК СуммаИнт,
	|	ЕСТЬNULL(РешениеСуммаБезНДСИнт.Решение, 0) КАК СуммаБезНДСИнт
	|ПОМЕСТИТЬ ТаблицаРешений
	|ИЗ
	|	РешениеСумма КАК РешениеСумма
	|		ЛЕВОЕ СОЕДИНЕНИЕ РешениеСуммаБезНДС КАК РешениеСуммаБезНДС
	|		ПО РешениеСумма.НомерУзла = РешениеСуммаБезНДС.НомерУзла
	|		ЛЕВОЕ СОЕДИНЕНИЕ РешениеСуммаИнт КАК РешениеСуммаИнт
	|		ПО РешениеСумма.НомерУзла = РешениеСуммаИнт.НомерУзла
	|		ЛЕВОЕ СОЕДИНЕНИЕ РешениеСуммаБезНДСИнт КАК РешениеСуммаБезНДСИнт
	|		ПО РешениеСумма.НомерУзла = РешениеСуммаБезНДСИнт.НомерУзла
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерУзла";

	Запрос.ВыполнитьПакет();

	Возврат Истина;

КонецФункции


Функция РешитьСистемуЛинейныхУравнений(Запрос, ИсточникУзлов, ИмяПравойЧасти)

	РасчетСистемЛинейныхУравнений = Новый РасчетСистемЛинейныхУравнений;

	РасчетСистемЛинейныхУравнений.ИсточникДанныхУзлов = ИсточникУзлов;
	РасчетСистемЛинейныхУравнений.ИсточникДанныхСвязей = СформироватьМатрицуСвязейДляРасчетаСистемЛинейныхУравнений(Запрос, ИмяПравойЧасти);

	РасчетСистемЛинейныхУравнений.КолонкаУравненияВУзлах = "НомерУравнения";
	РасчетСистемЛинейныхУравнений.КолонкаУравненияВСвязях = "НомерУравнения";
	РасчетСистемЛинейныхУравнений.КолонкаПеременныеВСвязях = "НомерПеременной";

	ОписаниеСистемы = РасчетСистемЛинейныхУравнений.ОписанияСистем.Добавить();
	ОписаниеСистемы.КолонкаКоэффициентовВУзлах = ИмяПравойЧасти;
	ОписаниеСистемы.КолонкаКоэффициентовВСвязях = "Количество";

	ТаблицаРешений = РасчетСистемЛинейныхУравнений.РассчитатьСистемыЛинейныхУравнений();

	Возврат ТаблицаРешений;

КонецФункции

Функция ПустоеРешениеСЛУ()

	ПустоеРешение = Новый ТаблицаЗначений;
	ПустоеРешение.Колонки.Добавить("НомерУзла",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0)));
	ПустоеРешение.Колонки.Добавить("Решение1",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));

	Возврат ПустоеРешение;

