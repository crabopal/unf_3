//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

#КонецОбласти

&НаСервере
Процедура АдаптацияТакси()
	
	Если Не ЭтоИнтерфейсТакси Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Переместить(Элементы.КоманднаяПанель, КоманднаяПанель);
	Элементы.Переместить(Элементы.ФормаНастроитьФорму, КоманднаяПанель);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетали",
		"ВертикальныйИнтервал", ИнтервалМеждуЭлементамиФормы.Авто);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСостояниеОплаты",
		 "Группировка",ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПроцентОплатыДетали",
		"МаксимальнаяШирина", 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПроцентОплатыДетали",
		"АвтоМаксимальнаяШирина", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыОборотДетали",
		"ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Авто);
	
КонецПроцедуры

#КонецОбласти