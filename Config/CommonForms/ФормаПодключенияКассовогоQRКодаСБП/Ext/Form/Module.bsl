//
&НаСервереБезКонтекста
Функция ЦветПалитрыНаСервере(ИмяЦвета)
	
	Возврат ЦветаПалитры[ИмяЦвета];
	
КонецФункции // ЦветПалитрыНаСервере()

#КонецОбласти
