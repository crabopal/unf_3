#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Интеграция     = Параметры.Интеграция;
	КассаККМ       = Параметры.КассаККМ;
	Организация    = Параметры.Организация;
	ТорговыйОбъект = Параметры.ТорговыйОбъект;
	
	Если ЗначениеЗаполнено(ТорговыйОбъект) Тогда
		ТипСтруктурнойЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТорговыйОбъект, "ТипСтруктурнойЕдиницы");
		Если ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.Подразделение
			Или ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов Тогда
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Для торгового объекта с типом ""%1"" создание кассовых ссылок недоступно.'"),
				Строка(ТипСтруктурнойЕдиницы));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПлатежнаяСистемаСБП = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП();
	Если ТипЗнч(Интеграция) = Тип("СправочникСсылка.НастройкиПодключенияКСистемеБыстрыхПлатежей") Тогда
		ПлатежнаяСистема = ПлатежнаяСистемаСБП;
	ИначеЕсли ТипЗнч(Интеграция) = Тип("СправочникСсылка.НастройкиПодключенияКПлатежнымСистемам")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Интеграция, "ПлатежнаяСистема") = Перечисления.ПлатежныеСервисы.ЯндексПэй Тогда
		ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй();
	Иначе
		ПлатежнаяСистема = ПлатежнаяСистемаСБП;
	КонецЕсли;
	
	УстановитьЗаголовокФормыПоПлатежнойСистеме();
	
	Если Параметры.Организация = "ПоУмолчанию" Тогда
		Организация = ИнтеграцияСПлатежнымиСистемамиУНФ.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Если Параметры.СпособОплаты = "ПоУмолчанию" Тогда
		СпособОплаты = ИнтеграцияСПлатежнымиСистемамиУНФ.ВидОплатыПоУмолчанию(Организация);
		Элементы.ГруппаСпособОплатыСБП.Видимость = Ложь;
	Иначе
		СпособОплаты = Параметры.СпособОплаты;
	КонецЕсли;
	
	Элементы.КассаККМ.ТолькоПросмотр = Не Параметры.РазрешитьВыборКассыККМ;
	
	Если Не ЗначениеЗаполнено(КассаККМ)
		И ЗначениеЗаполнено(СпособОплаты) Тогда
		
		ВсеКассыНастройки = ИнтеграцияСПлатежнымиСистемамиУНФ.ПолучитьКассыОрганизации(Организация, ТорговыйОбъект);
		Для Каждого КассаККМНастроек Из ВсеКассыНастройки Цикл
			
			СпособыОплаты = Новый Соответствие;
			ИнтеграцияСПлатежнымиСистемамиУНФ.ПолучитьНастройкиКассовогоQRКода(КассаККМНастроек, ПлатежнаяСистема, СпособыОплаты);
			
			Если СпособыОплаты.Количество() > 0 И СпособыОплаты.Получить(СпособОплаты) <> Неопределено Тогда
				КассаККМ = КассаККМНастроек;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Интеграция) Тогда
		
		Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
			НастройкиПодключения = СистемаБыстрыхПлатежей.НастройкиПодключения(Интеграция);
			Если Не НастройкиПодключения.Используется Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Настройка не используется.'"), , , , Отказ);
			ИначеЕсли Не НастройкиПодключения.НастройкиСБПc2b.КассовыеСсылки Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Настройка не поддерживает кассовые qr-коды.'"), , , , Отказ);
			КонецЕсли;
		ИначеЕсли ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
			НастройкиПодключения = ЯндексПэй.КассовыеСсылкиНастройки(Интеграция);
			Если Не ПустаяСтрока(НастройкиПодключения.КодОшибки) Тогда
				ОбщегоНазначения.СообщитьПользователю(НастройкиПодключения.СообщениеОбОшибке, , , , Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.РазрешитьВыборКассыККМ
		И (Не ЗначениеЗаполнено(Организация)
			ИЛИ Не ЗначениеЗаполнено(ТорговыйОбъект)) Тогда
		
		СвязиПараметровВыбора = Новый Массив;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Организация"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТорговыйОбъект) Тогда
			СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.СтруктурнаяЕдиница", "ТорговыйОбъект"));
		КонецЕсли;
		
		Элементы.КассаККМ.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
		
	КонецЕсли;
	
	ИнициализироватьПанельФормированияКода();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ОбработатьВыполненияКоманды(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КассовыйQRКодПриИзменении(Элемент)
	
	ОбновлятьДанныеФормы = Истина;
	
	Если Не ПроверитьЗаполнениеНастроек(Неопределено) Тогда
		КассовыйQRКод = "";
	ИначеЕсли Не ЗначениеЗаполнено(КассовыйQRКод) Тогда
		ОбработатьВыполненияКоманды("УдалитьКассовыйQRКод");
	Иначе
		
		Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
			ОбновитьКассовыеСсылки(КассовыйQRКод);
		Иначе
			РезультатПроверки = ПереводыСБПc2bКлиентСервер.ПроверкаURLКассовойСсылки(КассовыйQRКод, Истина);
			Если Не РезультатПроверки.URLВалиден Тогда
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					НСтр("ru = 'Неверный формат кассовой ссылки.'"),
					,
					,
					"КассовыйQRКод");
					
				ОбновлятьДанныеФормы = Ложь;
					
			Иначе
				ОбновитьКассовыеСсылки(КассовыйQRКод, Лев(РезультатПроверки.СтруктураURI.ПутьНаСервере, 32));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновлятьДанныеФормы Тогда
		НастроитьФорму(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КассаККМПриИзменении(Элемент)
	
	ИнициализироватьПанельФормированияКода();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьКассовыеСсылки(Команда)
	
	ОбработатьВыполненияКоманды(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьQRКода(Команда)
	
	ОбработатьВыполненияКоманды(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключить(Команда)
	
	ОбработатьВыполненияКоманды(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКассовыйQRКод(Команда)
	
	ОбработатьВыполненияКоманды(Команда.Имя);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьПанельФормированияКода()
	
	РеквизитыКассы = Новый Структура;
	РеквизитыКассы.Вставить("ТорговыйОбъект", ТорговыйОбъект);
	РеквизитыКассы.Вставить("Организация",    Организация);
	РеквизитыКассы.Вставить("КассаККМ",       КассаККМ);
	
	НастройкиПодключения = ИнтеграцияСПлатежнымиСистемамиРМКСлужебный.НастройкиИнтеграции(Организация, ТорговыйОбъект);
	
	ПоПлатежнойСистеме = Новый Структура;
	ПоПлатежнойСистеме.Вставить("ПлатежнаяСистема", ПлатежнаяСистема);
	Если ЗначениеЗаполнено(Интеграция) Тогда
		ПоПлатежнойСистеме.Вставить("Интеграция", Интеграция);
	КонецЕсли;
	
	СписокСпособовОплаты = Новый СписокЗначений;
	Если НастройкиПодключения <> Неопределено Тогда
		
		НастройкиПодключения = НастройкиПодключения.Скопировать(ПоПлатежнойСистеме);
		НастройкиПодключения.Колонки.Добавить("НастройкиТорговойТочки");
		
		Для Каждого НастройкаПодключения Из НастройкиПодключения Цикл
			
			Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
				НастройкиТорговойТочки = СистемаБыстрыхПлатежей.НастройкиПодключения(НастройкаПодключения.Интеграция);
				КассовыеСсылкиДоступны = НастройкиТорговойТочки.НастройкиСБПc2b.КассовыеСсылки;
			ИначеЕсли ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
				НастройкиТорговойТочки = ЯндексПэй.КассовыеСсылкиНастройки(НастройкаПодключения.Интеграция);
				КассовыеСсылкиДоступны = НастройкиТорговойТочки.КассовыеСсылки.Количество() > 0;
			Иначе
				НастройкиТорговойТочки = Неопределено;
				КассовыеСсылкиДоступны = Ложь;
			КонецЕсли;
			НастройкаПодключения.НастройкиТорговойТочки = НастройкиТорговойТочки;
			
			Если КассовыеСсылкиДоступны Тогда
				СписокСпособовОплаты.Добавить(НастройкаПодключения.СпособОплаты);
			КонецЕсли;
			
		КонецЦикла;
		
		НастройкиПодключенияМассив = ОбщегоНазначения.ТаблицаЗначенийВМассив(НастройкиПодключения);
		
	КонецЕсли;
	
	СпособыОплаты = Новый Соответствие;
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		
		ИнтеграцияСПлатежнымиСистемамиУНФ.ПолучитьНастройкиКассовогоQRКода(
			КассаККМ,
			ПлатежнаяСистема,
			СпособыОплаты);
		
		Для Каждого СпособОплатыПараметры Из СпособыОплаты Цикл
			СпособОплатыКассовойСсылкиСБП = СпособОплатыПараметры.Ключ;
		КонецЦикла;
		
	КонецЕсли;
	
	Если СписокСпособовОплаты.НайтиПоЗначению(СпособОплатыКассовойСсылкиСБП) = Неопределено Тогда
		СпособОплатыКассовойСсылкиСБП = ?(СписокСпособовОплаты.Количество() > 0, СписокСпособовОплаты[0].Значение, Неопределено);
	КонецЕсли;
	
	Элементы.СпособОплатыКассовойСсылкиСБП.СписокВыбора.ЗагрузитьЗначения(СписокСпособовОплаты.ВыгрузитьЗначения());
	
	КассовыеСсылки = Новый Структура;
	КассовыеСсылки.Вставить("СпособыОплаты",         СпособыОплаты);
	КассовыеСсылки.Вставить("СпособОплатыДляПечати", СпособОплатыКассовойСсылкиСБП);
	
	НастройкиКассовыхСсылокСБП = Новый Структура;
	НастройкиКассовыхСсылокСБП.Вставить("РеквизитыКассы",       РеквизитыКассы);
	НастройкиКассовыхСсылокСБП.Вставить("НастройкиПодключения", НастройкиПодключенияМассив);
	НастройкиКассовыхСсылокСБП.Вставить("СписокСпособовОплаты", СписокСпособовОплаты);
	НастройкиКассовыхСсылокСБП.Вставить("КассовыеСсылки",       КассовыеСсылки);
	
	НастроитьФорму(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыполненияКоманды(ВидДействия, СтандартнаяОбработка = Ложь, Отказ = Ложь)
	
	Перем ОписаниеОшибки;
	
	Если ВидДействия = "ПерейтиНаИнструкциюNFC" Тогда
		
		СтандартнаяОбработка = Ложь;
		ПереводыСБПc2bКлиент.ОткрытьИнструкциюПоПрограммированиюNFCМетки();
			
	ИначеЕсли ВидДействия = "ПерейтиНаИнструкциюКассовыйQRКод"  Тогда
	
		СтандартнаяОбработка = Ложь;
		ПереводыСБПc2bКлиент.ОткрытьОписаниеКассовыхСсылок();
		
	ИначеЕсли ВидДействия = "УдалитьКассовыйQRКод" Тогда
		
		СтандартнаяОбработка = Ложь;
		ОбновитьКассовыеСсылки("");
		
		НастроитьФорму(ЭтотОбъект);
		
	ИначеЕсли ВидДействия = "ПодключитьСБП"	 Тогда
		
		СтандартнаяОбработка 	= Ложь;
		ОписаниеОповещения 		= Новый ОписаниеОповещения("ПодключитьСБПЗавершение", ЭтотОбъект);

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Организация", 	Организация);
		ДополнительныеПараметры.Вставить("ТорговыйОбъект", 	ТорговыйОбъект);
	
		ПараметрыПодключения 	= НастройкиПлатежныхСистемКлиент.НовыйПараметрыПодключения(
			, ДополнительныеПараметры, ОписаниеОповещения,,  "КассовыеСсылки");
	
		НастройкиПлатежныхСистемКлиент.ПодключитьПлатежнуюСистему("СистемаБыстрыхПлатежей", ПараметрыПодключения);
		
	ИначеЕсли ВидДействия = "Подключить" Тогда
		
		Если ПроверитьЗаполнениеНастроек(ВидДействия) 
			И НастройкиКассовыхСсылокСБП  <> Неопределено Тогда
		
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПодключитьКассовуюСсылкуЗавершение",
				ЭтотОбъект,
				Новый Структура("Форма", ЭтотОбъект));

			Для Каждого НастройкаПодключения Из НастройкиКассовыхСсылокСБП.НастройкиПодключения Цикл
		
				Если НастройкаПодключения.СпособОплаты = СпособОплатыКассовойСсылкиСБП Тогда
			
					ПереводыСБПc2bКлиент.ПодключитьКассовуюСсылку(
						НастройкаПодключения.Интеграция,
						ОписаниеОповещения,
						ЭтотОбъект);

				КонецЕсли;
				
			КонецЦикла;			
				
		КонецЕсли;
	
	ИначеЕсли ВидДействия = "СпособОплатыКассовойСсылкиСБП"  Тогда

		РеквизитыКассы			= НастройкиКассовыхСсылокСБП.РеквизитыКассы;
		КассовыеСсылки 			= НастройкиКассовыхСсылокСБП.КассовыеСсылки;
					
		КассовыеСсылки.СпособОплатыДляПечати = СпособОплатыКассовойСсылкиСБП;
				
		ЗаписатьДанныеКассовойСсылки(РеквизитыКассы.КассаККМ, КассовыеСсылки, ПлатежнаяСистема);
			
		НастроитьФорму(ЭтотОбъект);
		
	ИначеЕсли ВидДействия = "СформироватьКассовыеСсылки"  Тогда
		
		Если ПроверитьЗаполнениеНастроек(ВидДействия) Тогда

			СформироватьКассовыеСсылкиЗавершение(Отказ, ОписаниеОшибки);
			
			Если Не Отказ Тогда
				ОбработатьВыполненияКоманды("КассоваяСсылкаА5Горизонтальный");
			КонецЕсли;
			
		Иначе
			Отказ = Истина;
		КонецЕсли;		
	
	ИначеЕсли СтрНачинаетсяС(ВидДействия, "КассоваяСсылкаА") Тогда
		
		Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
			СообщениеОбОшибке = НСтр("ru = 'Печать кассовых ссылок Яндекс Пэй не поддерживается.
											|Обратитесь в Яндекс для получения QR-кода в фирменном стиле.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибке);
			Возврат;
		КонецЕсли;
		
		РеквизитыКассы			= НастройкиКассовыхСсылокСБП.РеквизитыКассы;
		КассовыеСсылки 			= НастройкиКассовыхСсылокСБП.КассовыеСсылки;
					
		НастройкиСпособаОплаты  = КассовыеСсылки.СпособыОплаты.Получить(СпособОплатыКассовойСсылкиСБП);

		Если НастройкиСпособаОплаты = Неопределено Тогда
			СформироватьКассовыеСсылкиЗавершение(Отказ, ОписаниеОшибки);
		КонецЕсли;			

		Если Не Отказ Тогда  

			КассовыеСсылки 			= НастройкиКассовыхСсылокСБП.КассовыеСсылки;
			НастройкиСпособаОплаты  = КассовыеСсылки.СпособыОплаты.Получить(СпособОплатыКассовойСсылкиСБП);
			
			Если ВидДействия = "КассоваяСсылкаА5Горизонтальный" Тогда
				НазваниеПечатнойФормы = НСтр("ru = 'Кассовая ссылка (А5 горизонтальный)'");
				ТипПечати = 7;
			ИначеЕсли ВидДействия = "КассоваяСсылкаА5Вертикальный" Тогда
				НазваниеПечатнойФормы = НСтр("ru = 'Кассовая ссылка (А5 вертикальный)'");
				ТипПечати = 8;
			Иначе
				Возврат;
			КонецЕсли;
			
			ИдентификаторПечатнойФормы  = ВидДействия;
			МакетКарточкиКассовойСсылки = СформироватьКарточкуКассовойСсылки(НастройкиСпособаОплаты, ТипПечати);
			
			КоллекцияПечатныхФорм               = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
			ПечатнаяФорма                       = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
			ПечатнаяФорма.СинонимМакета         = НазваниеПечатнойФормы;
			ПечатнаяФорма.ТабличныйДокумент     = МакетКарточкиКассовойСсылки;
			ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
			
			УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьКарточкуКассовойСсылки(ДанныеСсылки, ТипПечати)
	
	Возврат ПереводыСБПc2b.КарточкаКассовойСсылки(ДанныеСсылки, Новый Структура("ТипПечати", ТипПечати));
		
КонецФункции 

&НаСервереБезКонтекста
Функция СформироватьКассовыеСсылкиСервер(СпособОплаты, НастройкиКассовыхСсылокСБП, Отказ)

	Для Каждого НастройкаПодключения Из НастройкиКассовыхСсылокСБП.НастройкиПодключения Цикл
		
		Если НастройкаПодключения.СпособОплаты = СпособОплаты Тогда
			
			РезультатСоздания = ПереводыСБПc2b.КассоваяСсылка(НастройкаПодключения.Интеграция);
			
			Если ЗначениеЗаполнено(РезультатСоздания.КодОшибки) Тогда
				
				Отказ 				= Истина;
				РезультатСоздания 	= РезультатСоздания.СообщениеОбОшибке;
				
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
    Возврат РезультатСоздания;
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеНастроек(ВидДействия)

	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(СпособОплатыКассовойСсылкиСБП) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнено поле ""Способ оплаты""'"));
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КассаККМ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнено поле ""Касса ККМ""'"));
		Отказ = Истина;
	КонецЕсли;

	Если ВидДействия = "ЗаписатьНастройкиКассовойСсылки"  Тогда	

		Если Не ЗначениеЗаполнено(КассовыйQRКод) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Необходимо сформировать кассовую ссылку'"));
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ПодключитьСБПЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИнициализироватьПанельФормированияКода();

	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПодключениеКассовойСсылки Тогда
		ОбработатьВыполненияКоманды("СформироватьКассовыеСсылки");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКассовуюСсылкуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыКассы = НастройкиКассовыхСсылокСБП.РеквизитыКассы;
	КассовыеСсылки = НастройкиКассовыхСсылокСБП.КассовыеСсылки;
	
	СпособОплатыКУдалению = КассовыеСсылки.СпособыОплаты.Получить(Неопределено);
	Если СпособОплатыКУдалению <> Неопределено Тогда
		КассовыеСсылки.СпособыОплаты.Удалить(Неопределено);
		ЗаписатьДанныеКассовойСсылки(РеквизитыКассы.КассаККМ, Неопределено, ПлатежнаяСистема);
	КонецЕсли;
	
	КассовыеСсылки.СпособыОплаты.Вставить(СпособОплатыКассовойСсылкиСБП, Результат);
	
	ЗаписатьДанныеКассовойСсылки(РеквизитыКассы.КассаККМ, КассовыеСсылки, ПлатежнаяСистема);
	
	НастроитьФорму(ЭтотОбъект);
	ОбработатьВыполненияКоманды("КассоваяСсылкаА5Горизонтальный");
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьКассовыеСсылкиЗавершение(Отказ, ОписаниеОшибки = "")
	
	КассоваяСсылка = СформироватьКассовыеСсылкиСервер(СпособОплатыКассовойСсылкиСБП, НастройкиКассовыхСсылокСБП, Отказ);
	
	Если Не ЗначениеЗаполнено(КассоваяСсылка) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		ОбновитьКассовыеСсылки(КассоваяСсылка.КассоваяСсылка, КассоваяСсылка.ИдентификаторОплаты, Отказ);
		
	ИначеЕсли ЗначениеЗаполнено(КассоваяСсылка) Тогда
		ОписаниеОшибки = КассоваяСсылка;
	КонецЕсли;
	
	НастроитьФорму(ЭтотОбъект, ОписаниеОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКассовыеСсылки(КассоваяСсылка, ИдентификаторОплаты = Неопределено, Отказ = Ложь)
	
	РеквизитыКассы = НастройкиКассовыхСсылокСБП.РеквизитыКассы;
	КассовыеСсылки = НастройкиКассовыхСсылокСБП.КассовыеСсылки;
	
	НастройкиСпособаОплаты  = Новый Структура;
	НастройкиСпособаОплаты.Вставить("КассоваяСсылка",      КассоваяСсылка);
	НастройкиСпособаОплаты.Вставить("ИдентификаторОплаты", ИдентификаторОплаты);
	
	Если ЗначениеЗаполнено(КассоваяСсылка) Тогда
		
		КассовыеСсылки.СпособыОплаты.Вставить(СпособОплатыКассовойСсылкиСБП, НастройкиСпособаОплаты);
		КассовыеСсылки.СпособОплатыДляПечати = СпособОплатыКассовойСсылкиСБП;
		
	ИначеЕсли КассовыеСсылки.СпособыОплаты.Получить(СпособОплатыКассовойСсылкиСБП) <> Неопределено Тогда
		КассовыеСсылки.СпособыОплаты.Удалить(СпособОплатыКассовойСсылкиСБП);
	КонецЕсли;
	
	ЗаписатьДанныеКассовойСсылки(РеквизитыКассы.КассаККМ, КассовыеСсылки, ПлатежнаяСистема, Отказ);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФорму(Форма, ОписаниеОшибки = "")
	
	Элементы = Форма.Элементы;
	
	НастройкиКассовыхСсылок = Форма.НастройкиКассовыхСсылокСБП;
	КассовыеСсылки          = НастройкиКассовыхСсылок.КассовыеСсылки;
	КассоваяСсылка          = КассовыеСсылки.СпособыОплаты.Получить(Форма.СпособОплатыКассовойСсылкиСБП);
	СписокСпособовОплаты    = НастройкиКассовыхСсылок.СписокСпособовОплаты;
	
	ПодключениеКассовойСсылки = Ложь;
	
	Если НастройкиКассовыхСсылок.НастройкиПодключения <> Неопределено Тогда
		
		Для Каждого НастройкаПодключения Из НастройкиКассовыхСсылок.НастройкиПодключения Цикл
			
			Если НастройкаПодключения.СпособОплаты = Форма.СпособОплатыКассовойСсылкиСБП Тогда
				Если Форма.ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
					ПодключениеКассовойСсылки = НастройкаПодключения.НастройкиТорговойТочки.НастройкиСБПc2b.ПодключениеКассовойСсылки;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СписокСпособовОплаты.Количество() > 0 Тогда
		
		ТекущаяСтраница = Элементы.ГруппаПодключениеКассовойСсылки;
		
		Элементы.ФормаГруппаПанельДействий.Видимость          = Истина;
		Элементы.СпособОплатыКассовойСсылкиСБП.Видимость      = СписокСпособовОплаты.Количество() > 0;
		Элементы.СпособОплатыКассовойСсылкиСБП.ТолькоПросмотр = СписокСпособовОплаты.Количество() = 1;
		
		Форма.КассовыйQRКод = "";
		Форма.NFCСсылкаСБП  = "";
		
		Если КассоваяСсылка <> Неопределено Тогда
			
			Форма.КассовыйQRКод = КассоваяСсылка.КассоваяСсылка;
			Если Форма.ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
				Форма.NFCСсылкаСБП  = ?(ЗначениеЗаполнено(КассоваяСсылка.КассоваяСсылка),
					ПереводыСБПc2bКлиентСервер.ФункциональнаяСсылкаNFC(КассоваяСсылка.КассоваяСсылка),
					"");
			КонецЕсли;
			
		КонецЕсли;
		
		Элементы.Подключить.Видимость = ПодключениеКассовойСсылки;
		
		Если Форма.ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
			Элементы.КассовыйQRКод.СписокВыбора.Очистить();
			Если ЗначениеЗаполнено(Форма.КассаККМ) Тогда
				СписокКассовыхСсылок = Новый Массив;
				Если ЗначениеЗаполнено(НастройкиКассовыхСсылок.НастройкиПодключения) Тогда
					Для Каждого НастройкаПодключения Из НастройкиКассовыхСсылок.НастройкиПодключения Цикл
						СписокКассовыхСсылок = НастройкаПодключения.НастройкиТорговойТочки.КассовыеСсылки;
					КонецЦикла;
				КонецЕсли;
				Для Каждого КассоваяСсылкаСписка Из СписокКассовыхСсылок Цикл
					ПредставлениеКассовойСсылки = СтрШаблон("%1 (%2)", КассоваяСсылкаСписка.Представление, КассоваяСсылкаСписка.КлючСсылки);
					Элементы.КассовыйQRКод.СписокВыбора.Добавить(КассоваяСсылкаСписка.КлючСсылки, ПредставлениеКассовойСсылки);
				КонецЦикла;
			КонецЕсли;
			
			Элементы.ГруппаNFCСсылка.Видимость = Ложь;
			Элементы.СформироватьКассовыеСсылки.Видимость = Ложь;
			Если Элементы.КассовыйQRКод.СписокВыбора.Количество() > 0 Тогда
				ПодсказкаПлатежнойСистемы = НСтр("ru = 'Выберите кассовый QR-код из списка.'");
			Иначе
				ПодсказкаПлатежнойСистемы = НСтр("ru = 'Для получения кассового QR-кода обратитесь в банк.'");
			КонецЕсли;
			Элементы.КассовыйQRКод.РасширеннаяПодсказка.Заголовок = ПодсказкаПлатежнойСистемы;
			Элементы.КассовыйQRКод.РежимВыбораИзСписка = Истина;
			Элементы.КассовыйQRКод.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			
			Элементы.ДекорацияПояснениеКФорме.Заголовок  = ОписаниеОшибки;
			Элементы.ДекорацияПояснениеКФорме.ЦветТекста = ЦветПалитрыНаСервере("Красный");
			
		Иначе
			
			Элементы.ДекорацияПояснениеКФорме.Заголовок  = "";
			Элементы.ДекорацияПояснениеКФорме.ЦветТекста = ЦветПалитрыНаСервере("Синий");
			
		КонецЕсли;
		
	Иначе
		
		Если Форма.ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
			ТекущаяСтраница = Элементы.ГруппаПодключениеПлатежнаяСистема;
			Элементы.ДекорацияОписаниеПлатежнаяСистема.Заголовок = СтрЗаменить(
				Элементы.ДекорацияОписаниеПлатежнаяСистема.Заголовок,
				"#ПлатежнаяСистема",
				НСтр("ru = 'Яндекс Пэй'"));
		Иначе
			ТекущаяСтраница = Элементы.ГруппаПодключениеСБП;
		КонецЕсли;
		Форма.Элементы.ФормаГруппаПанельДействий.Видимость = Ложь;
		
	КонецЕсли;
	
	Форма.Элементы.Страницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьДанныеКассовойСсылки(КассаККМ, КассовыеСсылки, ПлатежнаяСистема, Отказ = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
		КлючКассовыхСсылок = "КассовыеСсылкиСБП";
	ИначеЕсли ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
		КлючКассовыхСсылок = "КассовыеСсылкиЯндексПэй";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КассовыеСсылки)
		ИЛИ Не ЗначениеЗаполнено(КассовыеСсылки.СпособыОплаты) Тогда
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(КассаККМ, КлючКассовыхСсылок);
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(КассаККМ, КассовыеСсылки, КлючКассовыхСсылок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормыПоПлатежнойСистеме()
	
	Если ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаСБП() Тогда
		ЗаголовокФормы = НСтр("ru = 'Форма подключения кассового QR-кода СБП'");
	ИначеЕсли ПлатежнаяСистема = ИнтеграцияСПлатежнымиСистемамиРМККлиентСервер.ПлатежнаяСистемаЯндексПэй() Тогда
		ЗаголовокФормы = НСтр("ru = 'Форма подключения кассового QR-кода Яндекс Пэй'");
	Иначе
		ЗаголовокФормы = НСтр("ru = 'Форма подключения кассового QR-кода'");
	КонецЕсли;
	
	ЭтотОбъект.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

